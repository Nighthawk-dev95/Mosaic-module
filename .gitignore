# Python
.venv/
__pycache__/
*.pyc
*.pyo

# Local env / secrets
.env
.env.local

# Cached EDW data - real radiologist/practice productivity data, never commit
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

# Node / frontend
node_modules/
dist/
dist-ssr/
*.local

# Built frontend, bundled into the backend for Databricks Apps deployment
backend/static/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local source-watch state - machine-specific OneDrive file snapshot, not portable
tools/source_watch/manifest.json

# Claude Code local machine state - not portable, keep launch.json only
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Accession-level EDW exports - real patient-exam-linked identifiers, never commit
tools/edw_fixes/*.csv

# Working analysis workbooks and write-ups at the repo root - scratch output from
# internal analysis, regenerable from the SQL in tools/, and two of them (the mammo
# pair) carried an "Accession Detail" sheet with real accession numbers and dictation
# timestamps.
/*.xlsx
/*.docx
# ...except the practice-to-Local mapping, which is business-maintained and is the
# authoritative upstream for the mapping table - resources/mosaic_reporting_refresh.job.yml
# names this file as its source.
!/Practice_to_Local_Mapping.xlsx

# Ad-hoc EDW query exports dropped at the repo root - same rule as the line above, plus
# they are enormous: the timestamp pulls alone are 1.5 GB and 344 MB, well past GitHub's
# 100 MB per-file hard limit, so committing one would make the repo unpushable.
/*.csv
/*.tsv
/*.err
/_npi_list*.txt
/_linked_mammo_diag_ids.txt

# Scratch workspace - deploy stdout dumps and dashboard JSON snapshots, regenerable
.tmp_work/

# EDW Mosaic Health - real daily EDW counts by date/practice/radiologist, never commit
tools/edw_health/integrity_manifest.json
tools/edw_health/reports/
tools/edw_health/__pycache__/

# Databricks CLI local sync state - machine-specific, not portable
.databricks/
