table '0. Cur'
	lineageTag: b2cfeb07-c2cb-4b0e-8dfe-0fe1eabc268c

	measure 'Practice Detail Summary Title' = CONCATENATE([Page Title Team]," Practice Summary")
		lineageTag: 8c9d1fd7-9113-44b7-bf48-d5ce36a7f645

	measure 'Page Title - Rad Scorecard' = "Dr. " & [Page Title RAD] & ", " & [Page Title Team]
		lineageTag: d8f1a23d-c15e-4091-a6be-29abab1df56a

	measure 'Page Title - Practice Rad List' = CONCATENATE("VRA Practice Rad List - ",[Page Title Team])
		lineageTag: e93aef61-b933-455f-abc3-c48b449402f8

	measure 'Page Title Footer' = CONCATENATE("Live Rads, Current as of ", FORMAT(MAX('0. Cur'[refreshed_date]),"m/d"))
		lineageTag: 5994fa12-03a7-426e-a94b-ade75b35c4a7

	measure 'Page Title - Practice Scorecard' = CONCATENATE("VRA Practice Scorecard - ",SELECTEDVALUE('0. Cur'[Team]))
		lineageTag: 8cb4b48a-d74a-4fd9-bc0a-1ed6a2218121

	measure 'Page Title - Rad Deatil' =
			
			CONCATENATE(CONCATENATE([Page Title RAD], " - "),[Page Title Team])
		lineageTag: 83f8c6ba-bf9a-47cf-8c7d-c9db069d1752

	measure 'Page Title RAD' =
			
			VAR _Count = COUNTROWS(VALUES('0. Cur'[Rad_name]))
			RETURN IF(_Count>1,"Multiple Rads",SELECTEDVALUE('0. Cur'[Rad_name]))
		lineageTag: c17879e4-d9ca-4720-85b7-bc523fc1deb8

	measure 'Page Title Team' =
			
			VAR _Count = COUNTROWS(DISTINCT(VALUES('0. Cur'[Team])))
			RETURN IF(_Count>1,"Multiple Teams",SELECTEDVALUE('0. Cur'[Team]))
		lineageTag: a0a54524-c9f0-4ed3-838a-c12d01f93579

	measure 'Page Title - Practice Summary' = CONCATENATE("Practice Summary - ",[Page Title Team])
		lineageTag: bc1ab040-dc6b-4edc-8bb2-2c4a051cc251

	measure 'Rank Within Model Selection' =
			
			VAR npi = SELECTEDVALUE('0. Cur'[NPI])
			RETURN
			IF (
			    HASONEVALUE('0. Cur'[NPI]),
			    RANKX (
			        FILTER (
			            ALLSELECTED('0. Cur'),
			            '0. Cur'[NPI] = npi
			        ),
			        CALCULATE ( MIN ( '0. Cur'[RecordRank] ) ),
			        ,
			        ASC,
			        DENSE
			    )
			)
		formatString: 0
		lineageTag: df3465cf-66d6-4421-b208-6a25fee640b8

	measure 'Page TitleR - Practice Summary' = CONCATENATE("Rad Summary - ",[Page Title Team])
		lineageTag: 2f12eb31-b017-485a-b7ea-abf68706be38

	measure Refreshdt = ```
			
			"Report Refreshed: " & 
			FORMAT(
			    CALCULATE(
			        MAX('0. Cur'[refreshed_date]),
			        REMOVEFILTERS('0. Cur')
			    ), 
			    "MM/DD/YYYY hh:mm AM/PM"
			) & 
			" | Refresh Schedule: Daily | Data Source(s): Clinical"
			```
		lineageTag: 4ddbd6bd-557c-401e-995b-bebdcf73ef31

	column NPI
		dataType: double
		formatString: 0
		lineageTag: 2ee23894-2444-46eb-9929-678dde7f19d5
		summarizeBy: none
		sourceColumn: NPI

		annotation SummarizationSetBy = User

