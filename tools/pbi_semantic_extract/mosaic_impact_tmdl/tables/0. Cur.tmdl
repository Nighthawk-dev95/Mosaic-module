	column overlapping_shiftv2 =
			
			Var x1= CALCULATE(MAX('0. Cur'[Schedule_End_DateTime]), ALL())
			var x2 = MAXX(FILTER(ALL('0. Cur'), '0. Cur'[Schedule_End_DateTime]= EARLIER('0. Cur'[Schedule_End_DateTime])), '0. Cur'[Schedule_End_DateTime])
			RETURN
			IF(x2= x1, "Overlapping Shift", "Non Overlapping Shift")
		lineageTag: 03734d96-3871-49e9-89af-883ac02f5174
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

