	column RecordRank = ```
			
			RANKX(
			    FILTER('0. Cur', ('0. Cur'[NPI] = EARLIER('0. Cur'[NPI]))),
			    '0. Cur'[ShiftNo],
			    , 
			    DESC, 
			    DENSE
			)
			/*RANKX(
			    FILTER('0. Cur', and('0. Cur'[NPI] = EARLIER('0. Cur'[NPI]),'0. Cur'[VRAShift_TAG] = 1)),
			    '0. Cur'[ShiftNo],
			    , 
			    DESC, 
			    DENSE
			)*/
			
			```
		formatString: 0
		lineageTag: 3940b62b-dd68-485d-a11b-5b16fa45b365
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

