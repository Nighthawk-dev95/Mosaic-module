			VAR Passing =
			    FILTER(
			        WithFlags,
			        [__shift] = 1 &&
			        [__impact] = 0 &&
			        [__baseline] = 1 &&
			        NOT ISBLANK('0. Cur'[NPI])
			    )
			VAR Passing1Col =
			    SELECTCOLUMNS(Passing, "NPI", '0. Cur'[NPI])   -- make it 1 column for TREATAS
			RETURN
			FORMAT(
			    CALCULATE([Add'l Capacity / Shift (Top N)],
