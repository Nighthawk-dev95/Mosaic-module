table '3.Summary Table'
	lineageTag: 55c12770-e4e3-43e4-af3e-33b4900ccc50

	measure Summary_Rads_Displayed =
			
			VAR BaseNPI =
			    VALUES('0. Cur'[NPI])   -- NPIs in current visual context
			VAR WithFlags =
			    ADDCOLUMNS(
			        BaseNPI,
			        "__shift", COALESCE([Display Shifts Slicer], 0),
			        "__impact", COALESCE([Impact selection filter flag], 1),
			        "__baseline", COALESCE([Has_Baseline_For_Selected_Unit], 0)
			    )
			VAR Passing =
			    FILTER(
			        WithFlags,
			        [__shift] = 1 &&
			        [__impact] = 0 &&
			        [__baseline] = 1 &&
			        NOT ISBLANK('0. Cur'[NPI])
			    )
			VAR Passing1Col =
			    SELECTCOLUMNS(Passing, "NPI", '0. Cur'[NPI])   -- make it 1 column for TREATAS
			RETURN
			CALCULATE(
			    DISTINCTCOUNT('0. Cur'[NPI]),
			    KEEPFILTERS( TREATAS(Passing1Col, '0. Cur'[NPI]) )
			)
		formatString: 0
		lineageTag: fc754464-15d4-4ed8-90f7-2631bcbab730

	measure Summary_Average_Capacity_Increase_formated = ```
			
