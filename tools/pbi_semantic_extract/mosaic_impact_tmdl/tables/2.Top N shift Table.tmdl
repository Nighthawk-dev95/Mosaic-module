	column 'No. Shifts' = ```
			IF('2.Top N shift Table'[Top N] <=30, 
			                CONCATENATE(CONCATENATE("Last ",'2.Top N shift Table'[Top N])," Shift"),
			                            IF('2.Top N shift Table'[Top N] = MAX('2.Top N shift Table'[Top N]), "All Shifts", "All Other Shift"))
