	measure VRA =
			
			
			VAR SummaryTable =
			    ADDCOLUMNS (
			        SUMMARIZE (
			            '0. Cur',
			            '0. Cur'[Team],
			            '0. Cur'[NPI],
			            '0. Cur'[Shift Date (Year Month)]
			            -- Replace with your actual group column
			        ),
			        "no_vra", IF([Average On Shift Capacity (Top N)] >90,2,1),
			        "no_shift", [Selected Shift Ct.],
			        "Total_shift", [Selected Shift Ct.]*IF([Average On Shift Capacity (Top N)] >90,2,1)
			    )
			
			
			RETURN
			    SUMX(SummaryTable,[Total_shift])/SUMX(SummaryTable,[no_shift])
		lineageTag: 720aa866-02ad-4aee-befc-964dc68256aa

		annotation PBI_FormatHint = {"isGeneralNumber":true}

