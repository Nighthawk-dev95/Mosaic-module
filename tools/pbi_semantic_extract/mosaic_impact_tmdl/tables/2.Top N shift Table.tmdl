	measure Rank_TopN =
			
			VAR n = COALESCE([Selected Shift No.], 0)
			VAR rnk = SELECTEDVALUE('0. Cur'[ShiftRecencyRank])
			RETURN
			IF(
			    HASONEVALUE('0. Cur'[NPI]) &&
			    n > 0 &&
			    NOT ISBLANK(rnk) &&
			    rnk <= n,
			    1, 0
			)
		formatString: 0
		lineageTag: 3ce941db-03c4-43f1-a3cb-c0bba05a92ca

	measure 'Average On Shift Cases (Top N)' = ```
			
			AVERAGEX(
			    FILTER(
			        ('0. Cur'),
			                [Rank_TopN] =1),
			    //'0. Cur'[on_shift_cases]
			    [On-Shift Cases]
			)
			
