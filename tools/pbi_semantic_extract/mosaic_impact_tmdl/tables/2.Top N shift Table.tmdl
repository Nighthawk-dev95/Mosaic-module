	measure 'Annualized_addl_capacity (Top N)(overwrite display)' = ```
			
			VAR SummaryTable =
			    ADDCOLUMNS (
			        SUMMARIZE (
			            '0. Cur',
			            '0. Cur'[NPI]  -- Replace with your actual group column
			        ),
			        "MaxValue", CALCULATE ( MAX ( '0. Cur'[annual_shift_count] ) )
			    )
			
			
			VAR TopNTable =
			    TOPN (
			        100,  -- Replace 5 with however many top values you want
			        SummaryTable,
			        [MaxValue],
			        DESC
			    )
			//var  add_avlue = IF([Add'l Capacity / Shift (Top N)] <0, 0,[Add'l Capacity / Shift (Top N)])
			var  add_avlue = [Add'l Capacity / Shift (Top N)] 
			
			RETURN
			    IF(SUMX ( TopNTable, [MaxValue]*add_avlue ) = 0, "n/a",SUMX ( TopNTable, [MaxValue]*add_avlue ))
			
			```
		formatString: #,0
		lineageTag: 487e8c39-a590-4861-b0a5-61fbcb9b5ff6

