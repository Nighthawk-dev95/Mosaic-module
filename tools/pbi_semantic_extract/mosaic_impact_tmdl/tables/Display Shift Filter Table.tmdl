table 'Display Shift Filter Table'
	lineageTag: 3d5fd575-6815-44f5-be25-b5b3ecbc701d

	measure 'Display Shifts Slicer' = ```
			
			VAR _selection = SELECTEDVALUE('Display Shift Filter Table'[Selection])
			VAR _count = [Selected Shift Ct.]
			RETURN
			    SWITCH(
			        _selection,
			        "Less than 2 Shifts", IF(_count < 2, 1, 0),
			        "More than 2 Shifts", IF(_count >= 2, 1, 0),  
			        1  -- default return all if nothing selected
			    )
			```
		formatString: 0
		lineageTag: 95609ab0-446f-4b10-854e-48b456dd6558

