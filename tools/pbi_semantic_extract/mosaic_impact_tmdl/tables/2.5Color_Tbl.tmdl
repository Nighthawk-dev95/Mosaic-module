table '2.5Color_Tbl'
	lineageTag: f6b680f2-4061-45bc-a63b-f3d4b20afac8

	measure 'Impact selection filter flag' =
			
			VAR SelectedCategories = VALUES('2.5Color_Tbl'[Success])
			VAR ThisCategory = [AddlCap_Shift_Category]
			
			RETURN
			IF (
			    ISBLANK(ThisCategory),
			    0,
			    IF(
			        CONTAINS(SelectedCategories, '2.5Color_Tbl'[Success], ThisCategory),
			        0,
			        1
			    )
			)
		formatString: 0
		lineageTag: 13b5c339-405e-4e1e-99b3-58f8b4f05dba

	measure AddlCap_Shift_Category = ```
			
			VAR ValueToFormat = ROUND([Add'l Capacity / Shift (Top N)], 0)
			RETURN 
			SWITCH(
			    TRUE(),
			    ISBLANK(ValueToFormat), BLANK(),
			    ValueToFormat >= 0, "Successful",   -- Green
			    "Unsuccessful"                      -- Red, everything negative
			)
			```
		lineageTag: fff15c61-c138-48b5-8251-ffb8a2b7209e

	measure AddlCap_Shift_Color = ```
			
			SWITCH(
			    [AddlCap_Shift_Category],
			    "Successful", "#DAF2D0",        // Green
			    
			    "Unsuccessful", "#FFE1E1",   // Red
			    BLANK()                     // Default (white)
			)
			```
		lineageTag: 480f3fbf-c9e5-40f8-910b-44cd0727d95b

	measure Legend_Display =
			
			VAR SelectedUnit = SELECTEDVALUE('1. Unit_Tbl'[Productivity Unit])
			RETURN
			SWITCH(
			    TRUE(),
			    SelectedUnit = "RVU/Shift",SELECTEDVALUE('2.5Color_Tbl'[Legend]),
			    SelectedUnit = "TBWU/Shift",SELECTEDVALUE('2.5Color_Tbl'[Legend]),
			    SelectedUnit = "RVU/Hour",SELECTEDVALUE('2.5Color_Tbl'[Cap Chg (u/hr)]),
			    SelectedUnit = "TBWU/Hour",SELECTEDVALUE('2.5Color_Tbl'[Cap Chg (u/hr)]),
			    SelectedUnit = "RVU/9 Hour",SELECTEDVALUE('2.5Color_Tbl'[Cap Chg (u/9hr)]),
			    SelectedUnit = "TBWU/9 Hour",SELECTEDVALUE('2.5Color_Tbl'[Cap Chg (u/9hr)]),
			    BLANK()
			)
		lineageTag: 86fe9c12-9302-49e5-ac72-0c92bb050e8e

	measure AddlCap_Shift_Categorymosaic = ```
			
			VAR ValueToFormat  = ROUND([Add'l Capacity / Shift (Top N) mosaic],0)
			VAR SelectedUnit  = SELECTEDVALUE('1. Unit_Tbl'[Productivity Unit])
			VAR GreenMin = LOOKUPVALUE('1. Unit_Tbl'[GreenMin],'1. Unit_Tbl'[Productivity Unit],SelectedUnit)
			VAR YellowMin = LOOKUPVALUE('1. Unit_Tbl'[YellowMin],'1. Unit_Tbl'[Productivity Unit],SelectedUnit)
			VAR RedMax = LOOKUPVALUE('1. Unit_Tbl'[RedMax], '1. Unit_Tbl'[Productivity Unit], SelectedUnit)
			
			RETURN 
			SWITCH(
			    TRUE(),
			    ISBLANK(ValueToFormat), BLANK(),
			    ValueToFormat >= GreenMin, "Successful",     -- Green
			    ValueToFormat >= YellowMin, "Marginal",   -- Yellow
			    ValueToFormat < RedMax, "Unsuccessful",  -- Red  
			    BLANK()
			)
			```
		lineageTag: e1774b13-de56-40e7-b6ef-26683d846a31

	measure AddlCap_Shift_mosaicColor =
			
			SWITCH(
			    [AddlCap_Shift_Categorymosaic],
			    "Successful", "#DAF2D0",        // Green
			    "Marginal", "#FFFFCE",       // Yellow
			    "Unsuccessful", "#FFE1E1",   // Red
			    BLANK()                     // Default (white)
			)
		lineageTag: e24e3520-410f-4fac-a24d-bf757f47a186

