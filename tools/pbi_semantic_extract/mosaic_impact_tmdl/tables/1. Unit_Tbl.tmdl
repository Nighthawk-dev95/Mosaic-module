	measure 'shift baseline premosaic' = ```
			
			
			
			VAR SelectedUnit = SELECTEDVALUE('1. Unit_Tbl'[Productivity Unit])
			VAR PreMosaicShifts = 
			    FILTER(
			        '0. Cur',
			        '0. Cur'[ShiftDate] < '0. Cur'[Mosaic_go_live_date] || ISBLANK('0. Cur'[Mosaic_go_live_date] 
			        )// Adjust column names as needed
			    )
			RETURN
			SWITCH(
			    SelectedUnit,
			    "RVU/Shift", CALCULATE(SUM('0. Cur'[shift_baseline_RVU]), PreMosaicShifts),
			    "TBWU/Shift", CALCULATE(SUM('0. Cur'[shift_baseline_RPWU]), PreMosaicShifts),
			    "RVU/Hour", CALCULATE(SUM('0. Cur'[shift_baseline_per_hour_RVU]), PreMosaicShifts),
			    "TBWU/Hour", CALCULATE(SUM('0. Cur'[shift_baseline_per_hour_RPWU]), PreMosaicShifts),
			    "RVU/9 Hour", CALCULATE(SUM('0. Cur'[shift_baseline_per_9hours_RVU]), PreMosaicShifts),
			    CALCULATE(SUM('0. Cur'[shift_baseline_per_9hours_RPWU]), PreMosaicShifts)
			)
