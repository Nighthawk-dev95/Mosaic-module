	measure Has_Baseline_For_Selected_Unit =
			
			VAR SelectedUnit = SELECTEDVALUE('1. Unit_Tbl'[Productivity Unit])
			RETURN
			SWITCH(
			    TRUE(),
			    SelectedUnit IN {"RVU/Shift", "RVU/Hour", "RVU/9 Hour"},
			        MAXX('0. Cur', IF('0. Cur'[Has_RVU_Baseline], 1, 0)),
			    SelectedUnit IN {"TBWU/Shift", "TBWU/Hour", "TBWU/9 Hour"},
			        MAXX('0. Cur', IF('0. Cur'[Has_TBWU25_Baseline], 1, 0)),
			    SelectedUnit IN {"TBWU 26/Shift", "TBWU 26/Hour", "TBWU 26/9 Hour"},
			        MAXX('0. Cur', IF('0. Cur'[Has_TBWU26_Baseline], 1, 0)),
			    MAXX('0. Cur', IF('0. Cur'[Has_TBWU25_Baseline], 1, 0))
			)
		formatString: 0
		lineageTag: 529f4772-e944-4000-80f2-87f10d9434b3

