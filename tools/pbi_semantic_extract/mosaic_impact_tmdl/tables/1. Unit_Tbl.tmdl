	measure 'on-shift capacity mosaic' = ```
			
			
			var selectedunit = SELECTEDVALUE('1. Unit_Tbl'[Productivity Unit])
			
			var postmosaicshifts = 
			FILTER(
			    '0. Cur', 
			    '0. Cur'[ShiftDate] >= '0. Cur'[Mosaic_go_live_date] && NOT ( ISBLANK('0. Cur'[Mosaic_go_live_date]))
			)
			RETURN
			SWITCH(
			    SelectedUnit,
			    "RVU/Shift", CALCULATE(SUM('0. Cur'[on_shift_capacity_RVU]), PostMosaicShifts),
			    "TBWU/Shift", CALCULATE(SUM('0. Cur'[on_shift_capacity_RPWU]), PostMosaicShifts),
