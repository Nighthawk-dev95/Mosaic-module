table '1. Unit_Tbl'
	lineageTag: 9b8723fd-30e2-4496-a28e-eed13cbc24ee

	measure 'On-Shift Capacity' = ```
			
			SWITCH(
			    SELECTEDVALUE('1. Unit_Tbl'[Productivity Unit]),
			    "RVU/Shift", SUM('0. Cur'[on_shift_capacity_RVU]),
			    "TBWU/Shift", SUM('0. Cur'[on_shift_capacity_RPWU25]),
			    "RVU/Hour", SUM('0. Cur'[on_shift_capacity_RVU_per_hour]),
			    "TBWU/Hour", SUM('0. Cur'[on_shift_capacity_RPWU25_per_hour]),
			    "RVU/9 Hour", SUM('0. Cur'[on_shift_capacity_RVU_per_9hours]),
			    "TBWU 26/Shift", sum('0. Cur'[on_shift_capacity_RPWU]), 
			    "TBWU 26/Hour" , sum('0. Cur'[on_shift_capacity_vs_baseline_RPWU_per_hour]), 
			    "TBWU 26/9 Hour", sum('0. Cur'[on_shift_capacity_vs_baseline_RPWU_per_9hours]),
			    SUM('0. Cur'[on_shift_capacity_RPWU25_per_9hours])
			)
			```
		formatString: 0
		lineageTag: 7a1b1eb4-f4fb-4611-b383-6957babaf95a

		annotation PBI_FormatHint = {"isDecimal":true}

