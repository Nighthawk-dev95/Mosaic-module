			RETURN
			SWITCH(
			    SelectedUnit,
			    "RVU/Shift", SUMX(FILTER('0. Cur', '0. Cur'[on_shift_efficiency_RVU] <= 1.00), '0. Cur'[on_shift_efficiency_RVU]),
