	measure Radiologist_Count_NB = ```
			
			VAR IsParentExamLevel = ISINSCOPE('radiologist_metrics(1)'[Parent_Procedure_name])
			VAR IsRadiologistLevel = ISINSCOPE('radiologist_summary(1)'[Radiologist])
			VAR TeamCount = COUNTROWS(VALUES('radiologist_summary(1)'[team_rolled_up]))
			VAR IsTeamLevel = NOT IsRadiologistLevel && NOT IsParentExamLevel && TeamCount = 1
			VAR IsTotalLevel = NOT IsRadiologistLevel && NOT IsParentExamLevel && TeamCount > 1
			
			VAR _qualifiedRads = 
			    FILTER(
			        VALUES('radiologist_summary(1)'[Radiologist]),
			        CALCULATE([Rad_Qualifies_NB]) = 1 &&
			        CALCULATE([Has_Data_NB]) = 1
			    )
			
			VAR _count = COUNTROWS(_qualifiedRads)
			
			RETURN
			SWITCH(
			    TRUE(),
			    IsParentExamLevel, BLANK(),
			    IsRadiologistLevel, BLANK(),
			    IsTeamLevel, _count,
			    IsTotalLevel, _count,
			    _count
			)
			```
		formatString: 0
		lineageTag: 18506512-e5a2-4f18-8379-feeb840a2b04

