table Readtimeview
	lineageTag: 3b9ff7ad-b032-4307-bc16-4ccd848f758b

	measure Mosaic_Exams_AllTime_NB = ```
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			VAR _outlierView = SELECTEDVALUE('Outlier Selector'[Outlier View], "Excluded")
			
			VAR IsParentExamLevel = ISINSCOPE('radiologist_metrics(1)'[Parent_Procedure_name])
			VAR IsRadiologistLevel = ISINSCOPE('radiologist_summary(1)'[Radiologist]) && NOT IsParentExamLevel
			
			VAR _procAllTime = 
			    CALCULATE(
			        SUM('radiologist_metrics(1)'[ExamCount]),
			        REMOVEFILTERS('Mosaic_Calendar'),
			        SWITCH(
			            _mode,
			            "Drafting Only",
			                'radiologist_metrics(1)'[Period_Type] = "Drafting"
			                    && 'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"},
			            "Reporting Only",
			                'radiologist_metrics(1)'[Period_Type] = "Reporting",
			            "Drafting + Capture",
			                (
			                    ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                        && 'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"})
			                    || ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                        && 'radiologist_metrics(1)'[Modality_Code] IN {"US","BD"})
			                ),
			            "Both",
			                'radiologist_metrics(1)'[Period_Type] IN {"Drafting","Reporting","Baseline"},
			            'radiologist_metrics(1)'[Period_Type] IN {"Drafting","Reporting"}
			        ),
			        IF(_outlierView = "Excluded", 'radiologist_metrics(1)'[Outliers] = "Excluded", TRUE())
			    )
			
			VAR _radAllTime = 
			    SWITCH(
			        TRUE(),
			        _mode = "Drafting Only" && _outlierView = "Excluded",
			            SUM('radiologist_summary(1)'[rad_total_drafting_excloutliers]),
			        _mode = "Drafting Only" && _outlierView = "Included",
			            SUM('radiologist_summary(1)'[rad_total_drafting_Incloutliers]),
			        _mode = "Reporting Only" && _outlierView = "Excluded",
			            SUM('radiologist_summary(1)'[rad_total_reporting_excloutliers]),
			        _mode = "Reporting Only" && _outlierView = "Included",
			            SUM('radiologist_summary(1)'[rad_total_reporting_incloutliers]),
			        _mode = "Full Mosaic" && _outlierView = "Excluded",
			            SUM('radiologist_summary(1)'[rad_total_fullmosaic_excloutliers]),
			        _mode = "Full Mosaic" && _outlierView = "Included",
			            SUM('radiologist_summary(1)'[rad_total_fullmosaic_Incloutliers]),
			        _mode = "Drafting + Capture",           -- ← new, use fact table
			            CALCULATE(
			                SUM('radiologist_metrics(1)'[ExamCount]),
			                REMOVEFILTERS('Mosaic_Calendar'),
			                (
			                    ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                        && 'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"})
			                    || ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                        && 'radiologist_metrics(1)'[Modality_Code] IN {"US","BD"})
			                ),
			                IF(_outlierView = "Excluded", 'radiologist_metrics(1)'[Outliers] = "Excluded", TRUE())
			            ),
			        _mode = "Both",
			            CALCULATE(
			                SUM('radiologist_metrics(1)'[ExamCount]),
			                REMOVEFILTERS('Mosaic_Calendar'),
			                'radiologist_metrics(1)'[Period_Type] IN {"Drafting","Reporting","Baseline"},
			                IF(_outlierView = "Excluded", 'radiologist_metrics(1)'[Outliers] = "Excluded", TRUE())
			            ),
			        SUM('radiologist_summary(1)'[rad_total_fullmosaic_excloutliers])
			    )
			
			RETURN
			IF(IsParentExamLevel, _procAllTime, _radAllTime)
			```
		formatString: 0
		lineageTag: 0038eba0-90fb-490b-b257-80ff2f536e43

	measure Mosaic_Exams_Period_NB = ```
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			VAR _outlierView = SELECTEDVALUE('Outlier Selector'[Outlier View], "Excluded")
			
			VAR _exams = 
			    CALCULATE(
			        SUM('radiologist_metrics(1)'[ExamCount]),
			        'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        SWITCH(
			            _mode,
			            "Drafting Only",
			                'radiologist_metrics(1)'[Period_Type] = "Drafting"
			                    && 'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"},
			            "Reporting Only",
			                'radiologist_metrics(1)'[Period_Type] = "Reporting",
			            "Drafting + Capture",
			                (
			                    ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                        && 'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"})
			                    || ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                        && 'radiologist_metrics(1)'[Modality_Code] IN {"US","BD"})
			                ),
			            "Both",
			                'radiologist_metrics(1)'[Period_Type] IN {"Drafting","Reporting","Baseline"},
			            'radiologist_metrics(1)'[Period_Type] IN {"Drafting","Reporting"}
			        ),
			        IF(_outlierView = "Excluded", 'radiologist_metrics(1)'[Outliers] = "Excluded", TRUE())
			    )
			
			RETURN IF(_exams > 0, _exams, BLANK())
			```
