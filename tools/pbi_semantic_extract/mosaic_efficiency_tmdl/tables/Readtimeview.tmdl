	measure Benchmark_Drafting_Only =
			
			VAR _outlierView =
			    SELECTEDVALUE('Outlier Selector'[Outlier View], "Excluded")
			
			VAR _minExams =
			    SELECTEDVALUE('Mosaic Min Exams'[MinExams], 0)
			
			VAR _selectedRads =
			    ALLSELECTED('radiologist_summary(1)'[Radiologist])
			
			VAR _qualifiedRads =
			    FILTER(
			        _selectedRads,
			        VAR _rad = 'radiologist_summary(1)'[Radiologist]
			        VAR _radExams =
			            CALCULATE(
			                SUM('radiologist_metrics(1)'[ExamCount]),
			                ALLSELECTED('radiologist_summary(1)'[team_rolled_up]),
			                ALLSELECTED('radiologist_summary(1)'[Radiologist]),
			                ALLSELECTED('radiologist_metrics(1)'[Parent_Procedure_name]),
			                TREATAS({_rad}, 'radiologist_summary(1)'[Radiologist]),
			                'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                'radiologist_metrics(1)'[Period_Type] = "Drafting",
			                'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"},  -- ← added
			                IF(
			                    _outlierView = "Excluded",
			                    'radiologist_metrics(1)'[Outliers] = "Excluded",
			                    TRUE()
			                )
			            )
			        VAR _radTime =
			            CALCULATE(
			                SUM('radiologist_metrics(1)'[TotalTime]),
			                ALLSELECTED('radiologist_summary(1)'[team_rolled_up]),
			                ALLSELECTED('radiologist_summary(1)'[Radiologist]),
			                ALLSELECTED('radiologist_metrics(1)'[Parent_Procedure_name]),
			                TREATAS({_rad}, 'radiologist_summary(1)'[Radiologist]),
			                'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                'radiologist_metrics(1)'[Period_Type] = "Drafting",
			                'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"},  -- ← added
			                IF(
			                    _outlierView = "Excluded",
			                    'radiologist_metrics(1)'[Outliers] = "Excluded",
			                    TRUE()
			                )
			            )
			        RETURN _radExams >= _minExams && _radTime > 0
			    )
			
			VAR _tbwu =
			    SUMX(
			        _qualifiedRads,
			        VAR _rad = 'radiologist_summary(1)'[Radiologist]
			        RETURN
			            CALCULATE(
			                SUM('radiologist_metrics(1)'[TotalTBWU]),
			                ALLSELECTED('radiologist_summary(1)'[team_rolled_up]),
			                ALLSELECTED('radiologist_summary(1)'[Radiologist]),
			                ALLSELECTED('radiologist_metrics(1)'[Parent_Procedure_name]),
			                TREATAS({_rad}, 'radiologist_summary(1)'[Radiologist]),
			                'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                'radiologist_metrics(1)'[Period_Type] = "Drafting",
			                'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"},  -- ← added
			                IF(
			                    _outlierView = "Excluded",
			                    'radiologist_metrics(1)'[Outliers] = "Excluded",
			                    TRUE()
			                )
			            )
			    )
			
			VAR _time =
			    SUMX(
			        _qualifiedRads,
			        VAR _rad = 'radiologist_summary(1)'[Radiologist]
			        RETURN
			            CALCULATE(
			                SUM('radiologist_metrics(1)'[TotalTime]),
			                ALLSELECTED('radiologist_summary(1)'[team_rolled_up]),
			                ALLSELECTED('radiologist_summary(1)'[Radiologist]),
			                ALLSELECTED('radiologist_metrics(1)'[Parent_Procedure_name]),
			                TREATAS({_rad}, 'radiologist_summary(1)'[Radiologist]),
			                'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                'radiologist_metrics(1)'[Period_Type] = "Drafting",
			                'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"},  -- ← added
			                IF(
			                    _outlierView = "Excluded",
			                    'radiologist_metrics(1)'[Outliers] = "Excluded",
			                    TRUE()
			                )
			            )
			    )
			
			RETURN DIVIDE(_tbwu, _time / 60)
		formatString: 0.000
		lineageTag: 02e021c5-1468-4d6e-ad6d-5639c81da891

