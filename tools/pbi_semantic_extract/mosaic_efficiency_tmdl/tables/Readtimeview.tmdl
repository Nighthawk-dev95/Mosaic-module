	measure Population_Avg_Full_Mosaic = ```
			
			VAR _outlierView = SELECTEDVALUE('Outlier Selector'[Outlier View], "Excluded")
			VAR _hasTeamFilter = ISFILTERED('radiologist_summary(1)'[team_rolled_up])
			VAR _hasRadFilter = ISFILTERED('radiologist_summary(1)'[Radiologist])
			VAR _hasProcFilter = ISFILTERED('radiologist_metrics(1)'[Parent_Procedure_name])
			VAR _hasAnyFilter = _hasTeamFilter || _hasRadFilter || _hasProcFilter
			
			// Base calculation using ALL (same as RP Avg)
			VAR _baseTBWU = 
			    CALCULATE(
			        SUM('radiologist_metrics(1)'[TotalTBWU]),
			        ALL('radiologist_summary(1)'),
			        ALL('radiologist_metrics(1)'),
			        'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        'radiologist_metrics(1)'[Period_Type] IN {"Drafting", "Reporting"},
			        IF(_outlierView = "Excluded", 'radiologist_metrics(1)'[Outliers] = "Excluded", TRUE())
			    )
			
			VAR _baseTime = 
			    CALCULATE(
			        SUM('radiologist_metrics(1)'[TotalTime]),
			        ALL('radiologist_summary(1)'),
			        ALL('radiologist_metrics(1)'),
			        'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        'radiologist_metrics(1)'[Period_Type] IN {"Drafting", "Reporting"},
			        IF(_outlierView = "Excluded", 'radiologist_metrics(1)'[Outliers] = "Excluded", TRUE())
			    )
			
			// Filtered calculation (when slicers are selected)
			VAR _filteredTBWU = 
			    CALCULATE(
			        SUM('radiologist_metrics(1)'[TotalTBWU]),
			        ALL('radiologist_summary(1)'),
			        ALL('radiologist_metrics(1)'),
			        'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        'radiologist_metrics(1)'[Period_Type] IN {"Drafting", "Reporting"},
			        IF(_outlierView = "Excluded", 'radiologist_metrics(1)'[Outliers] = "Excluded", TRUE()),
			        'radiologist_summary(1)'[team_rolled_up] IN VALUES('radiologist_summary(1)'[team_rolled_up]),
			        'radiologist_summary(1)'[Radiologist] IN VALUES('radiologist_summary(1)'[Radiologist])
			    )
			
			VAR _filteredTime = 
			    CALCULATE(
			        SUM('radiologist_metrics(1)'[TotalTime]),
			        ALL('radiologist_summary(1)'),
			        ALL('radiologist_metrics(1)'),
			        'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        'radiologist_metrics(1)'[Period_Type] IN {"Drafting", "Reporting"},
			        IF(_outlierView = "Excluded", 'radiologist_metrics(1)'[Outliers] = "Excluded", TRUE()),
			        'radiologist_summary(1)'[team_rolled_up] IN VALUES('radiologist_summary(1)'[team_rolled_up]),
			        'radiologist_summary(1)'[Radiologist] IN VALUES('radiologist_summary(1)'[Radiologist])
			    )
			
			VAR _finalTBWU = IF(_hasAnyFilter, _filteredTBWU, _baseTBWU)
			VAR _finalTime = IF(_hasAnyFilter, _filteredTime, _baseTime)
			
			RETURN
			DIVIDE(_finalTBWU, _finalTime / 60)
			```
		formatString: 0.000
		lineageTag: 815a30ba-b6eb-4cf6-9d09-a00d0a697a03

