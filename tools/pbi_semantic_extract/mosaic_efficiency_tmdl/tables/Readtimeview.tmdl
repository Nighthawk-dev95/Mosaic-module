	measure Rad_Qualifies_NB =
			
			VAR _minExams = SELECTEDVALUE('Mosaic Min Exams'[MinExams], 0)
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			VAR _outlierView = SELECTEDVALUE('Outlier Selector'[Outlier View], "Excluded")
			VAR _rtView =
			    IF(
			        ISFILTERED(Readtimeview[RT View]),
			        SELECTEDVALUE(Readtimeview[RT View], "All"),
			        "All"
			    )
			
			VAR IsParentExamLevel = ISINSCOPE('radiologist_metrics(1)'[Parent_Procedure_name])
			VAR IsRadiologistLevel = ISINSCOPE('radiologist_summary(1)'[Radiologist])
			VAR IsTeamLevel =
			    ISINSCOPE('radiologist_summary(1)'[team_rolled_up])
			        && NOT IsRadiologistLevel
			        && NOT IsParentExamLevel
			
			VAR _rpAvgTBWU =
			    CALCULATE(
			        SUM('radiologist_metrics(1)'[TotalTBWU]),
			        REMOVEFILTERS('radiologist_summary(1)'),
			        REMOVEFILTERS('radiologist_metrics(1)'[Parent_Procedure_name]),
			        'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        SWITCH(
			            _mode,
			            "Drafting Only",
			                'radiologist_metrics(1)'[Period_Type] = "Drafting"
			                    && 'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"},
			            "Reporting Only",
			                'radiologist_metrics(1)'[Period_Type] = "Reporting",
			            "Capture Only",
			                'radiologist_metrics(1)'[Period_Type] = "Drafting"
			                    && 'radiologist_metrics(1)'[Modality_Code] IN {"US","BD"},
			            "Drafting + Capture",
			                (
			                    ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                        && 'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"})
			                    || ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                        && 'radiologist_metrics(1)'[Modality_Code] IN {"US","BD"})
			                ),
			            "Both",
			                'radiologist_metrics(1)'[Period_Type] IN {"Drafting","Reporting","Baseline"},
			            'radiologist_metrics(1)'[Period_Type] IN {"Drafting","Reporting"}
			        ),
			        IF(_outlierView = "Excluded", 'radiologist_metrics(1)'[Outliers] = "Excluded", TRUE())
			    )
			
			VAR _rpAvgTime =
			    CALCULATE(
			        SUM('radiologist_metrics(1)'[TotalTime]),
			        REMOVEFILTERS('radiologist_summary(1)'),
			        REMOVEFILTERS('radiologist_metrics(1)'[Parent_Procedure_name]),
			        'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        SWITCH(
			            _mode,
			            "Drafting Only",
			                'radiologist_metrics(1)'[Period_Type] = "Drafting"
			                    && 'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"},
			            "Reporting Only",
			                'radiologist_metrics(1)'[Period_Type] = "Reporting",
			            "Capture Only",
			                'radiologist_metrics(1)'[Period_Type] = "Drafting"
			                    && 'radiologist_metrics(1)'[Modality_Code] IN {"US","BD"},
			            "Drafting + Capture",
			                (
			                    ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                        && 'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"})
			                    || ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                        && 'radiologist_metrics(1)'[Modality_Code] IN {"US","BD"})
			                ),
			            "Both",
			                'radiologist_metrics(1)'[Period_Type] IN {"Drafting","Reporting","Baseline"},
			            'radiologist_metrics(1)'[Period_Type] IN {"Drafting","Reporting"}
			        ),
			        IF(_outlierView = "Excluded", 'radiologist_metrics(1)'[Outliers] = "Excluded", TRUE())
			    )
			
			VAR _rpAvg = DIVIDE(_rpAvgTBWU, _rpAvgTime / 60)
			
			VAR _radExams =
			    CALCULATE(
			        SUM('radiologist_metrics(1)'[ExamCount]),
			        'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        SWITCH(
			            _mode,
			            "Drafting Only",
			                'radiologist_metrics(1)'[Period_Type] = "Drafting"
			                    && 'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"},
			            "Reporting Only",
			                'radiologist_metrics(1)'[Period_Type] = "Reporting",
			            "Capture Only",
			                'radiologist_metrics(1)'[Period_Type] = "Drafting"
			                    && 'radiologist_metrics(1)'[Modality_Code] IN {"US","BD"},
			            "Drafting + Capture",
			                (
			                    ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                        && 'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"})
			                    || ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                        && 'radiologist_metrics(1)'[Modality_Code] IN {"US","BD"})
			                ),
			            "Both",
			                'radiologist_metrics(1)'[Period_Type] IN {"Drafting","Reporting"},
			            'radiologist_metrics(1)'[Period_Type] IN {"Drafting","Reporting"}
			        ),
			        IF(_outlierView = "Excluded", 'radiologist_metrics(1)'[Outliers] = "Excluded", TRUE()),
			        REMOVEFILTERS('radiologist_metrics(1)'[Parent_Procedure_name])
			    )
			
			VAR _radTBWU =
			    CALCULATE(
			        SUM('radiologist_metrics(1)'[TotalTBWU]),
			        'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        SWITCH(
			            _mode,
			            "Drafting Only",
			                'radiologist_metrics(1)'[Period_Type] = "Drafting"
			                    && 'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"},
			            "Reporting Only",
			                'radiologist_metrics(1)'[Period_Type] = "Reporting",
			            "Capture Only",
			                'radiologist_metrics(1)'[Period_Type] = "Drafting"
			                    && 'radiologist_metrics(1)'[Modality_Code] IN {"US","BD"},
			            "Drafting + Capture",
			                (
			                    ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                        && 'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"})
			                    || ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                        && 'radiologist_metrics(1)'[Modality_Code] IN {"US","BD"})
			                ),
			            "Both",
			                'radiologist_metrics(1)'[Period_Type] IN {"Drafting","Reporting","Baseline"},
			            'radiologist_metrics(1)'[Period_Type] IN {"Drafting","Reporting"}
			        ),
			        IF(_outlierView = "Excluded", 'radiologist_metrics(1)'[Outliers] = "Excluded", TRUE()),
			        REMOVEFILTERS('radiologist_metrics(1)'[Parent_Procedure_name])
			    )
			
			VAR _radTime =
			    CALCULATE(
			        SUM('radiologist_metrics(1)'[TotalTime]),
			        'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        SWITCH(
			            _mode,
			            "Drafting Only",
			                'radiologist_metrics(1)'[Period_Type] = "Drafting"
			                    && 'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"},
			            "Reporting Only",
			                'radiologist_metrics(1)'[Period_Type] = "Reporting",
			            "Capture Only",
			                'radiologist_metrics(1)'[Period_Type] = "Drafting"
			                    && 'radiologist_metrics(1)'[Modality_Code] IN {"US","BD"},
			            "Drafting + Capture",
			                (
			                    ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                        && 'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"})
			                    || ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                        && 'radiologist_metrics(1)'[Modality_Code] IN {"US","BD"})
			                ),
			            "Both",
			                'radiologist_metrics(1)'[Period_Type] IN {"Drafting","Reporting","Baseline"},
			            'radiologist_metrics(1)'[Period_Type] IN {"Drafting","Reporting"}
			        ),
			        IF(_outlierView = "Excluded", 'radiologist_metrics(1)'[Outliers] = "Excluded", TRUE()),
			        REMOVEFILTERS('radiologist_metrics(1)'[Parent_Procedure_name])
			    )
			
			VAR _radEfficiency = DIVIDE(_radTBWU, _radTime / 60)
			VAR _effVsAvg = DIVIDE(_radEfficiency, _rpAvg)
			VAR _meetsMinExams = _radExams >= _minExams
			VAR _meetsRTView =
			    SWITCH(
			        _rtView,
			        "Positive", _effVsAvg > 1,
			        "Negative", _effVsAvg <= 1,
			        TRUE()
			    )
			
			VAR _radQualifies = _meetsMinExams && _meetsRTView
			
			VAR _anyRadQualifies =
			    COUNTROWS(
			        FILTER(
			            VALUES('radiologist_summary(1)'[Radiologist]),
			            VAR _thisRadExams =
			                CALCULATE(
			                    SUM('radiologist_metrics(1)'[ExamCount]),
			                    'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                    SWITCH(
			                        _mode,
			                        "Drafting Only",
			                            'radiologist_metrics(1)'[Period_Type] = "Drafting"
			                                && 'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"},
			                        "Reporting Only",
			                            'radiologist_metrics(1)'[Period_Type] = "Reporting",
			                        "Capture Only",
			                            'radiologist_metrics(1)'[Period_Type] = "Drafting"
			                                && 'radiologist_metrics(1)'[Modality_Code] IN {"US","BD"},
			                        "Drafting + Capture",
			                            (
			                                ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                                    && 'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"})
			                                || ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                                    && 'radiologist_metrics(1)'[Modality_Code] IN {"US","BD"})
			                            ),
			                        "Both",
			                            'radiologist_metrics(1)'[Period_Type] IN {"Drafting","Reporting"},
			                        'radiologist_metrics(1)'[Period_Type] IN {"Drafting","Reporting"}
			                    ),
			                    IF(_outlierView = "Excluded", 'radiologist_metrics(1)'[Outliers] = "Excluded", TRUE())
			                )
			
			            VAR _thisRadTBWU =
			                CALCULATE(
			                    SUM('radiologist_metrics(1)'[TotalTBWU]),
			                    'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                    SWITCH(
			                        _mode,
			                        "Drafting Only",
			                            'radiologist_metrics(1)'[Period_Type] = "Drafting"
			                                && 'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"},
			                        "Reporting Only",
			                            'radiologist_metrics(1)'[Period_Type] = "Reporting",
			                        "Capture Only",
			                            'radiologist_metrics(1)'[Period_Type] = "Drafting"
			                                && 'radiologist_metrics(1)'[Modality_Code] IN {"US","BD"},
			                        "Drafting + Capture",
			                            (
			                                ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                                    && 'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"})
			                                || ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                                    && 'radiologist_metrics(1)'[Modality_Code] IN {"US","BD"})
			                            ),
			                        "Both",
			                            'radiologist_metrics(1)'[Period_Type] IN {"Drafting","Reporting","Baseline"},
			                        'radiologist_metrics(1)'[Period_Type] IN {"Drafting","Reporting"}
			                    ),
			                    IF(_outlierView = "Excluded", 'radiologist_metrics(1)'[Outliers] = "Excluded", TRUE())
			                )
			
			            VAR _thisRadTime =
			                CALCULATE(
			                    SUM('radiologist_metrics(1)'[TotalTime]),
			                    'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                    SWITCH(
			                        _mode,
			                        "Drafting Only",
			                            'radiologist_metrics(1)'[Period_Type] = "Drafting"
			                                && 'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"},
			                        "Reporting Only",
			                            'radiologist_metrics(1)'[Period_Type] = "Reporting",
			                        "Capture Only",
			                            'radiologist_metrics(1)'[Period_Type] = "Drafting"
			                                && 'radiologist_metrics(1)'[Modality_Code] IN {"US","BD"},
			                        "Drafting + Capture",
			                            (
			                                ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                                    && 'radiologist_metrics(1)'[Modality_Code] IN {"CR","CT"})
			                                || ('radiologist_metrics(1)'[Period_Type] = "Drafting"
			                                    && 'radiologist_metrics(1)'[Modality_Code] IN {"US","BD"})
			                            ),
			                        "Both",
			                            'radiologist_metrics(1)'[Period_Type] IN {"Drafting","Reporting","Baseline"},
			                        'radiologist_metrics(1)'[Period_Type] IN {"Drafting","Reporting"}
			                    ),
			                    IF(_outlierView = "Excluded", 'radiologist_metrics(1)'[Outliers] = "Excluded", TRUE())
			                )
			
			            VAR _thisRadEff = DIVIDE(_thisRadTBWU, _thisRadTime / 60)
			            VAR _thisEffVsAvg = DIVIDE(_thisRadEff, _rpAvg)
			            VAR _thisRadMeetsMinExams = _thisRadExams >= _minExams
			            VAR _thisRadMeetsRTView =
			                SWITCH(
			                    _rtView,
			                    "Positive", _thisEffVsAvg > 1,
			                    "Negative", _thisEffVsAvg <= 1,
			                    TRUE()
			                )
			
			            RETURN _thisRadMeetsMinExams && _thisRadMeetsRTView
			        )
			    ) > 0
			
			RETURN
			    SWITCH(
			        TRUE(),
			        IsTeamLevel, IF(_anyRadQualifies, 1, 0),
			        IsRadiologistLevel || IsParentExamLevel, IF(_radQualifies, 1, 0),
			        1
			    )
		formatString: 0
		lineageTag: 9a5ea5ad-1c2b-4352-a934-5b30fdb6bba7

	measure Mosaic_Efficiency_NB =
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			
			VAR _isTeamRow =
			    ISINSCOPE('radiologist_summary(1)'[team_rolled_up])
			        && NOT ISINSCOPE('radiologist_summary(1)'[Radiologist])
			        && NOT ISINSCOPE('radiologist_metrics(1)'[Parent_Procedure_name])
			
			VAR _isRadRow =
			    ISINSCOPE('radiologist_summary(1)'[Radiologist])
			        && NOT ISINSCOPE('radiologist_metrics(1)'[Parent_Procedure_name])
			
			VAR _isProcedureRow =
			    ISINSCOPE('radiologist_metrics(1)'[Parent_Procedure_name])
			
			VAR _isMatrixDetailRow = _isTeamRow || _isRadRow || _isProcedureRow
			
			VAR _singleTeamSelected =
			    COUNTROWS(ALLSELECTED('radiologist_summary(1)'[team_rolled_up])) = 1
			
			VAR _singleRadSelected =
			    COUNTROWS(ALLSELECTED('radiologist_summary(1)'[Radiologist])) = 1
			
			VAR _singleProcedureSelected =
			    COUNTROWS(ALLSELECTED('radiologist_metrics(1)'[Parent_Procedure_name])) = 1
			
			VAR _rowIsSelectedPopulation =
			    SWITCH(
			        TRUE(),
			        _isTeamRow && _singleTeamSelected, TRUE(),
			        _isRadRow && _singleRadSelected, TRUE(),
			        _isProcedureRow && _singleProcedureSelected, TRUE(),
			        FALSE()
			    )
			
			VAR _populationBenchmark =
			    SWITCH(
			        TRUE(),
			        _mode = "Drafting Only",
			            CALCULATE(
			                [Benchmark_Drafting_Only],
			                ALLSELECTED('radiologist_summary(1)'),
			                ALLSELECTED('radiologist_metrics(1)'[Parent_Procedure_name])
			            ),
			        _mode = "Reporting Only",
			            CALCULATE(
			                [Benchmark_Reporting_Only],
			                ALLSELECTED('radiologist_summary(1)'),
			                ALLSELECTED('radiologist_metrics(1)'[Parent_Procedure_name])
			            ),
			        _mode = "Capture Only",
			            CALCULATE(
			                [Benchmark_Capture_Only],
			                ALLSELECTED('radiologist_summary(1)'),
			                ALLSELECTED('radiologist_metrics(1)'[Parent_Procedure_name])
			            ),
			        _mode = "Drafting + Capture",           -- ← new
			            CALCULATE(
			                [Benchmark_DraftingCapture],
			                ALLSELECTED('radiologist_summary(1)'),
			                ALLSELECTED('radiologist_metrics(1)'[Parent_Procedure_name])
			            ),
			        _mode = "Both",
			            CALCULATE(
			                [Benchmark_Both],
			                ALLSELECTED('radiologist_summary(1)'),
			                ALLSELECTED('radiologist_metrics(1)'[Parent_Procedure_name])
			            ),
			        _mode = "Full Mosaic",
			            CALCULATE(
			                [Benchmark_FullMosaic_Only],
			                ALLSELECTED('radiologist_summary(1)'),
			                ALLSELECTED('radiologist_metrics(1)'[Parent_Procedure_name])
			            )
			    )
			
			RETURN
			    IF(
			        NOT _isMatrixDetailRow || _rowIsSelectedPopulation,
			        _populationBenchmark,
			        [Mosaic_Efficiency_Raw_NB]
			    )
		formatString: 0.000
		lineageTag: 7f026415-18c3-432e-b92d-ed50f2c8bc54

	measure RP_Avg_Efficiency = ```
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			VAR _outlierView = SELECTEDVALUE('Outlier Selector'[Outlier View], "Excluded")
			
			// Benchmark ignores Team/Rad selection - always overall average
			VAR _totalTBWU = 
			    CALCULATE(
			        SUM('radiologist_metrics(1)'[TotalTBWU]),
			        ALL('radiologist_summary(1)'),  // Ignore all Team/Rad filters
			        ALLSELECTED('radiologist_metrics(1)'[Parent_Procedure_name]),
			        'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        SWITCH(
			            _mode,
			            "Drafting Only", 'radiologist_metrics(1)'[Period_Type] = "Drafting",
			            "Reporting Only", 'radiologist_metrics(1)'[Period_Type] = "Reporting",
			            "Capture Only", 'radiologist_metrics(1)'[Period_Type] = "Drafting" && 'radiologist_metrics(1)'[Modality_Code] IN {"US", "BD"},
			            'radiologist_metrics(1)'[Period_Type] IN {"Drafting", "Reporting"}
			        ),
			        IF(_outlierView = "Excluded", 'radiologist_metrics(1)'[Outliers] = "Excluded", TRUE())
			    )
			
			VAR _totalTime = 
			    CALCULATE(
			        SUM('radiologist_metrics(1)'[TotalTime]),
			        ALL('radiologist_summary(1)'),  // Ignore all Team/Rad filters
			        ALLSELECTED('radiologist_metrics(1)'[Parent_Procedure_name]),
			        'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
