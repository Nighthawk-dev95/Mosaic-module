	measure Efficiency_vs_RP_Avg_NB =
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			VAR _mosaicEff = [Mosaic_Efficiency_NB]
			
			VAR _populationAvg_Strict =
			    SWITCH(
			        TRUE(),
			        _mode = "Drafting Only",
			            CALCULATE(
			                [Benchmark_Drafting_Only],
			                ALLSELECTED('radiologist_summary(1)'),
			                ALLSELECTED('radiologist_metrics(1)'[Parent_Procedure_name])
			            ),
			        _mode = "Reporting Only",
			            CALCULATE(
			                [Benchmark_Reporting_Only],
			                ALLSELECTED('radiologist_summary(1)'),
			                ALLSELECTED('radiologist_metrics(1)'[Parent_Procedure_name])
			            ),
			        _mode = "Capture Only",
			            CALCULATE(
			                [Benchmark_Capture_Only],
			                ALLSELECTED('radiologist_summary(1)'),
			                ALLSELECTED('radiologist_metrics(1)'[Parent_Procedure_name])
			            ),
			        _mode = "Drafting + Capture",           -- ← new
			            CALCULATE(
			                [Benchmark_DraftingCapture],
			                ALLSELECTED('radiologist_summary(1)'),
			                ALLSELECTED('radiologist_metrics(1)'[Parent_Procedure_name])
			            ),
			        _mode = "Both",
			            CALCULATE(
			                [Benchmark_Both],
			                ALLSELECTED('radiologist_summary(1)'),
			                ALLSELECTED('radiologist_metrics(1)'[Parent_Procedure_name])
			            ),
			        _mode = "Full Mosaic",
			            CALCULATE(
			                [Benchmark_FullMosaic_Only],
			                ALLSELECTED('radiologist_summary(1)'),
			                ALLSELECTED('radiologist_metrics(1)'[Parent_Procedure_name])
			            )
			    )
			
			RETURN DIVIDE(_mosaicEff, _populationAvg_Strict)
		formatString: 0%;-0%;0%
		lineageTag: 573c0c84-0d45-4665-b411-857eef5da2fc

