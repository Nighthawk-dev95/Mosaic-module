	measure Benchmark_Both_Overall =
			
			VAR _outlierView = SELECTEDVALUE('Outlier Selector'[Outlier View], "Excluded")
			VAR _minExams = SELECTEDVALUE('Mosaic Min Exams'[MinExams], 0)
			
			VAR _qualifiedRads =
			    FILTER(
			        ALL('radiologist_summary(1)'[Radiologist]),
			        VAR _rad = 'radiologist_summary(1)'[Radiologist]
			        VAR _radExams =
			            CALCULATE(
			                SUM('radiologist_metrics(1)'[ExamCount]),
			                REMOVEFILTERS('radiologist_summary(1)'),
			                REMOVEFILTERS('radiologist_metrics(1)'[Parent_Procedure_name]),
			                'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                'radiologist_metrics(1)'[Period_Type] IN {"Drafting", "Reporting"},
			                TREATAS({_rad}, 'radiologist_summary(1)'[Radiologist]),
			                IF(_outlierView = "Excluded", 'radiologist_metrics(1)'[Outliers] = "Excluded", TRUE())
			            )
			        RETURN _radExams >= _minExams
			    )
			
			VAR _tbwu =
			    CALCULATE(
			        SUM('radiologist_metrics(1)'[TotalTBWU]),
			        TREATAS(_qualifiedRads, 'radiologist_summary(1)'[Radiologist]),
			        REMOVEFILTERS('radiologist_summary(1)'),
			        REMOVEFILTERS('radiologist_metrics(1)'[Parent_Procedure_name]),
			        'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        'radiologist_metrics(1)'[Period_Type] IN {"Drafting", "Reporting", "Baseline"},
			        IF(_outlierView = "Excluded", 'radiologist_metrics(1)'[Outliers] = "Excluded", TRUE())
			    )
			
			VAR _time =
			    CALCULATE(
			        SUM('radiologist_metrics(1)'[TotalTime]),
			        TREATAS(_qualifiedRads, 'radiologist_summary(1)'[Radiologist]),
			        REMOVEFILTERS('radiologist_summary(1)'),
			        REMOVEFILTERS('radiologist_metrics(1)'[Parent_Procedure_name]),
			        'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        'radiologist_metrics(1)'[Period_Type] IN {"Drafting", "Reporting", "Baseline"},
			        IF(_outlierView = "Excluded", 'radiologist_metrics(1)'[Outliers] = "Excluded", TRUE())
			    )
			
			RETURN DIVIDE(_tbwu, _time / 60)
