	measure Mosaic_Efficiency_Raw_NB =
			
			VAR _mode =
			    SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			
			VAR _outlierView =
			    SELECTEDVALUE('Outlier Selector'[Outlier View], "Excluded")
			
			VAR _tbwu =
			    CALCULATE(
			        SUM('radiologist_metrics(1)'[TotalTBWU]),
			
			        'radiologist_metrics(1)'[Exam_Date]
			            IN VALUES('Mosaic_Calendar'[Date]),
			
			        SWITCH(
			            TRUE(),
			
			            _mode = "Drafting Only",
			                'radiologist_metrics(1)'[Period_Type] = "Drafting",
			
			            _mode = "Reporting Only",
			                'radiologist_metrics(1)'[Period_Type] = "Reporting",
			
			            _mode = "Capture Only",
			                'radiologist_metrics(1)'[Period_Type] = "Drafting"
			                    && 'radiologist_metrics(1)'[Modality_Code] IN {"US", "BD"},
			
			            _mode = "Both",
			                'radiologist_metrics(1)'[Period_Type] IN {
			                    "Drafting",
			                    "Reporting",
			                    "Baseline"
			                },
			
			            _mode = "Full Mosaic",
			                'radiologist_metrics(1)'[Period_Type] IN {
			                    "Drafting",
			                    "Reporting"
			                },
			
			            'radiologist_metrics(1)'[Period_Type] IN {
			                "Drafting",
			                "Reporting"
			            }
			        ),
			
			        IF(
			            _outlierView = "Excluded",
			            'radiologist_metrics(1)'[Outliers] = "Excluded",
			            TRUE()
			        )
			    )
			
			VAR _time =
			    CALCULATE(
			        SUM('radiologist_metrics(1)'[TotalTime]),
			
			        'radiologist_metrics(1)'[Exam_Date]
			            IN VALUES('Mosaic_Calendar'[Date]),
			
			        SWITCH(
			            TRUE(),
			
			            _mode = "Drafting Only",
			                'radiologist_metrics(1)'[Period_Type] = "Drafting",
			
			            _mode = "Reporting Only",
			                'radiologist_metrics(1)'[Period_Type] = "Reporting",
			
			            _mode = "Capture Only",
			                'radiologist_metrics(1)'[Period_Type] = "Drafting"
			                    && 'radiologist_metrics(1)'[Modality_Code] IN {"US", "BD"},
			
			            _mode = "Both",
			                'radiologist_metrics(1)'[Period_Type] IN {
			                    "Drafting",
			                    "Reporting",
			                    "Baseline"
			                },
			
			            _mode = "Full Mosaic",
			                'radiologist_metrics(1)'[Period_Type] IN {
			                    "Drafting",
			                    "Reporting"
			                },
			
			            'radiologist_metrics(1)'[Period_Type] IN {
			                "Drafting",
			                "Reporting"
			            }
			        ),
			
			        IF(
			            _outlierView = "Excluded",
			            'radiologist_metrics(1)'[Outliers] = "Excluded",
			            TRUE()
			        )
			    )
			
			RETURN
			    IF(
			        _time > 0,
			        DIVIDE(_tbwu, _time / 60),
			        BLANK()
			    )
		lineageTag: 201f7b80-cd5f-45c3-b4e1-33be2a418b0f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

