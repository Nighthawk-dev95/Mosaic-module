	column Week_Date =
			
			radiologist_metrics[Exam_Date] - WEEKDAY(radiologist_metrics[Exam_Date], 2) + 1
		formatString: Short Date
		lineageTag: bfb791cd-2f3d-4d37-a5ec-49879c148109
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 6a28c533-10e0-497c-8a34-6d242140c7c6
			defaultHierarchy: LocalDateTable_58c92a4e-6169-4ee5-b10c-359dadf04b1a.'Date Hierarchy'

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Drafting Enabled' =
			
			VAR CurrentNPI = radiologist_metrics[Physician_NPI]
			
			VAR HasCXR = NOT(ISBLANK(
			    LOOKUPVALUE(
			        'RadPipeline'[Added to AD Group (CXR/ABD/MSK)],
			        'RadPipeline'[NPI], CurrentNPI
			    )
			))
			
			VAR HasCT = NOT(ISBLANK(
			    LOOKUPVALUE(
			        'RadPipeline'[Added to AD Group (CT Head)],
			        'RadPipeline'[NPI], CurrentNPI
			    )
			))
			
			RETURN
			SWITCH(
			    TRUE(),
			    HasCT, "Rads on CT Drafting",
			    HasCXR, "Rads on XR Drafting",
			    "Rads not on Drafting"
			)
		lineageTag: 860bdde0-247d-448c-80ad-df2f91b2f3d8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Beginning_of_Month =
			
			DATE(YEAR(radiologist_metrics[Exam_Date]), MONTH(radiologist_metrics[Exam_Date]), 1)
		formatString: Short Date
		lineageTag: 27ae67f2-561f-4f3d-8896-54ebf657a653
		summarizeBy: none

		variation Variation
			isDefault
			relationship: c2092a71-acb4-4bba-95bf-bf0b46931a8b
			defaultHierarchy: LocalDateTable_9b0907be-f3e3-4ffb-ab69-0586bad9e657.'Date Hierarchy'

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Local =
			
			
			SWITCH(
			
			    TRUE(),
			
			    radiologist_metrics[Team] IN {"ESR", "LFI", "Jefferson", "GLI", "RAI", "RP Cascade", "RP Crossroads","JR","DRSRP","RP East Florida","RP North Florida", "RP Palm Beach","RP Florida West","PRA","ESRMH Garnet","ESRMH Hackensack","ESRMH Legacy","ESR Long Island","ESR Metro Hudson","SEAL Team", "SEAL Legacy","vRad","Spec Ops Reserve"}, "Special Operations",
			
			    radiologist_metrics[Team] IN {"ADI", "ADR", "CRC Central", "CRC NW", "CRC SW", "Midstate", "NEOH", "Rad Alliance", "RP Kentucky", "RP Bluegrass","RAC","RACSW","RPKY","RPBG","RA","ADR Legacy","CRC","Rad Alliance Legacy", "Rad Alliance NorthCrest","RP Bluegrass Legacy"}, "Apex",
			
			    radiologist_metrics[Team]  IN {"Coastal", "Greensboro", "MBB", "Northside", "Greensboro Canopy", "RAF", "RP Florida", "RP Sandhills", "RP South Carolina", "SOAR","BOCA","GR","NRA","RASF","MBB Legacy","MBB Phoebe Putney","Northside Radiology","RAF East Coast", "RAF Panhandle", "RAF Sarasota", "RAF Tampa", "RAF Tele","RASF Miami", "RASF Naples","RP Florida Legacy", "RP Florida West"}, "Genesis",
			
			     radiologist_metrics[Team]   IN {"Advanced Radiology", "Alaska", "CIR", "Desert", "GIMA", "RP SoCal", "IAM", "IAMSE", "MIA", "Mountain", "NIR", "RAA", "MXC", "Red Rock", "RIMA", "RP Sol", "RP Sun City", "RP Chicago", "RP Forest City", "Saline Valley", "RP Valley Radiologists", "SVDI", "Western Colorado","WIR","RP IOWA","GSIA","SVL","MR","DR","NWIR","ARSC","DR Legacy","DR DRS","IAMSE Hurley", "IAM Marquette", "IAM Midlands","Lakefront Imaging","Mountain Legacy", "Mountain Yampa","RP NWIR", "RP SMIL", "RP SoCal Lakewood", "RP SoCal Legacy", "RP SoCal Palmdale", "RP Valley","SVDI Legacy", "SVDI San Ramon","SMI","RIMA", "RIMA California"}, "Maverick",
			
			    radiologist_metrics[Team]  IN {"Access Alexandria", "ARA", "BR Academic", "BR Community", "CIRPA", "Community", "RP Eagle", "EBI", "GIA", "Lake Charles", "RP Borderlands", "RP Brazosport", "RP Corpus Christi", "RP Dallas", "RP El Paso", "RP Gulf Coast", "RP Houston", "RP Laredo", "RP Victoria","BR","Slidell","ACC","RPNM","EAG","RPEP","RPGC","RPH","Other","EXTHMC" ,"RP Singleton Academic" ,"RP Singleton Community", "RP Singleton","Rose","RP North Houston","Synergy", "Access Lake Charles","Community Laredo", "Community Legacy", "Community Victoria","Elite","RP Borderlands Legacy", "RP Borderlands Lovelace","RP Helios"}, "Trailblazer",
			
			    "Matrix"
			
			)
		lineageTag: 79ce641e-ed96-4d82-ac5f-ef2597a55a87
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

