	measure RP_Avg_Eff_Drafting_Only_LinePage =
			
			VAR _outlierView =
			    SELECTEDVALUE('Outlier Selector'[Outlier View], "Excluded")
			
			VAR _minExams =
			    SELECTEDVALUE('Mosaic Min Exams'[MinExams], 0)
			
			VAR _qualifiedRads_RP =
			    FILTER(
			        ALL('radiologist_summary(1)'[Radiologist]),
			        VAR _rad =
			            'radiologist_summary(1)'[Radiologist]
			
			        VAR _radExamsAllTime =
			            CALCULATE(
			                SUM('radiologist_metrics(1)'[ExamCount]),
			                REMOVEFILTERS('radiologist_summary(1)'),
			                REMOVEFILTERS('radiologist_metrics(1)'),
			                TREATAS({_rad}, 'radiologist_summary(1)'[Radiologist]),
			                'radiologist_metrics(1)'[Period_Type] = "Drafting",
			                IF(
			                    _outlierView = "Excluded",
			                    'radiologist_metrics(1)'[Outliers] = "Excluded",
			                    TRUE()
			                )
			            )
			
			        RETURN
			            _radExamsAllTime >= _minExams
			    )
			
			VAR _tbwu =
			    SUMX(
			        _qualifiedRads_RP,
			        VAR _rad =
			            'radiologist_summary(1)'[Radiologist]
			        RETURN
			            CALCULATE(
			                SUM('radiologist_metrics(1)'[TotalTBWU]),
			                REMOVEFILTERS('radiologist_summary(1)'),
			                REMOVEFILTERS('radiologist_metrics(1)'[Parent_Procedure_name]),
			                TREATAS({_rad}, 'radiologist_summary(1)'[Radiologist]),
			                'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                'radiologist_metrics(1)'[Period_Type] = "Drafting",
			                IF(
			                    _outlierView = "Excluded",
			                    'radiologist_metrics(1)'[Outliers] = "Excluded",
			                    TRUE()
			                )
			            )
			    )
			
			VAR _time =
			    SUMX(
			        _qualifiedRads_RP,
			        VAR _rad =
			            'radiologist_summary(1)'[Radiologist]
			        RETURN
			            CALCULATE(
			                SUM('radiologist_metrics(1)'[TotalTime]),
			                REMOVEFILTERS('radiologist_summary(1)'),
			                REMOVEFILTERS('radiologist_metrics(1)'[Parent_Procedure_name]),
			                TREATAS({_rad}, 'radiologist_summary(1)'[Radiologist]),
			                'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                'radiologist_metrics(1)'[Period_Type] = "Drafting",
			                IF(
			                    _outlierView = "Excluded",
			                    'radiologist_metrics(1)'[Outliers] = "Excluded",
			                    TRUE()
			                )
			            )
			    )
			
			RETURN
			    DIVIDE(_tbwu, _time / 60)
