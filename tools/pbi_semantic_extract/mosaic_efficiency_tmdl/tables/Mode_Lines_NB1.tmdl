			                TREATAS({_rad}, 'radiologist_summary(1)'[Radiologist]),
			                'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                'radiologist_metrics(1)'[Period_Type] IN {"Drafting", "Reporting"},
			                IF(
			                    _outlierView = "Excluded",
			                    'radiologist_metrics(1)'[Outliers] = "Excluded",
			                    TRUE()
			                )
			            )
			    )
			
			VAR _time =
			    SUMX(
			        _qualifiedRads_RP,
			        VAR _rad =
			            'radiologist_summary(1)'[Radiologist]
			        RETURN
			            CALCULATE(
			                SUM('radiologist_metrics(1)'[TotalTime]),
			                REMOVEFILTERS('radiologist_summary(1)'),
			                REMOVEFILTERS('radiologist_metrics(1)'[Parent_Procedure_name]),
			                TREATAS({_rad}, 'radiologist_summary(1)'[Radiologist]),
			                'radiologist_metrics(1)'[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                'radiologist_metrics(1)'[Period_Type] IN {"Drafting", "Reporting"},
			                IF(
			                    _outlierView = "Excluded",
			                    'radiologist_metrics(1)'[Outliers] = "Excluded",
			                    TRUE()
			                )
			            )
			    )
			
			RETURN
			    DIVIDE(_tbwu, _time / 60)
		formatString: 0.000
		lineageTag: 2a385dbe-5f5c-467b-8674-9db40f24f9bd

	column ModeLine
		lineageTag: f9c0c920-2112-4be1-936c-40660795db0d
		summarizeBy: none
		isNameInferred
		sourceColumn: [ModeLine]

		annotation SummarizationSetBy = Automatic

	column ModeOrder
		formatString: 0
		lineageTag: 3fb01bdf-a4f8-4aad-84ac-d51cd04fcb6a
		summarizeBy: sum
		isNameInferred
		sourceColumn: [ModeOrder]

		annotation SummarizationSetBy = Automatic

	partition Mode_Lines_NB1 = calculated
		mode: import
		source = ```
				
				DATATABLE(
				    "ModeLine", STRING,
				    "ModeOrder", INTEGER,
				    {
				        {"Drafting Only", 1},
				        {"Non-Drafted", 2},
				        {"Full Mosaic", 3}, 
				        {"RP Avg, Drafting Only" , 4}, 
				        {"RP Avg, Full Mosaic" , 5}
				        
				        
				    }
				)
				```

