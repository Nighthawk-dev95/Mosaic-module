	partition 'Mosaic Mode' = calculated
		mode: import
		source =
				
				DATATABLE(
				    "Mode", STRING,
				    "Sort Order", INTEGER,
				    {
				        {"Drafting Only", 1},
				        {"Capture Only", 2},
				        {"Reporting Only", 3},
				        {"Full Mosaic", 4}
				    }
				)

