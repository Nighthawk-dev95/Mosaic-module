	measure 'Efficiency Change % US Page' = ```
			
			VAR _minCaptured = SELECTEDVALUE('Min Captured Exams'[Value], 0)
			
			VAR IsSiteLevel = ISINSCOPE(radiologist_metrics[Location_Name])
			VAR IsRadiologistLevel = ISINSCOPE(radiologist_metrics[Radiologist]) && NOT IsSiteLevel
			VAR IsPracticeLevel = ISINSCOPE(radiologist_metrics[Practice]) && NOT IsRadiologistLevel && NOT IsSiteLevel
			VAR PracticeCount = COUNTROWS(VALUES(radiologist_metrics[Practice]))
			VAR IsActualTotalLevel = NOT IsSiteLevel && NOT IsRadiologistLevel && NOT IsPracticeLevel && PracticeCount > 1
			
			VAR _captured = [Captured US]
			
			// Get Practice (Team) total for threshold check
			VAR _practiceCaptured = 
			    CALCULATE(
			        SUM(radiologist_metrics[ExamCount]),
			        REMOVEFILTERS(radiologist_metrics[Location_Name]),
			        REMOVEFILTERS(radiologist_metrics[Radiologist]),
			        radiologist_metrics[Period_Type] = "Drafting",
			        radiologist_metrics[Modality_Code] = "US",
			        radiologist_metrics[Outliers] = "Excluded"
			    )
			
			VAR _thresholdCheck = 
			    IF(
			        IsSiteLevel || IsRadiologistLevel,
			        _practiceCaptured,
			        _captured
			    )
			
			// Baseline Efficiency - US modality only
			VAR _baseTime = 
			    CALCULATE(
			        SUM(radiologist_metrics[TotalTime]),
			        radiologist_metrics[Period_Type] = "Baseline",
			        radiologist_metrics[Modality_Code] = "US",
			        radiologist_metrics[Outliers] = "Excluded"
			    )
			
			VAR _baseTBWU = 
			    CALCULATE(
			        SUM(radiologist_metrics[TotalTBWU]),
			        radiologist_metrics[Period_Type] = "Baseline",
			        radiologist_metrics[Modality_Code] = "US",
			        radiologist_metrics[Outliers] = "Excluded"
			    )
			
			VAR _baseEff = DIVIDE(_baseTBWU, _baseTime / 60)
			
			// Mosaic Efficiency - US modality, Drafting only
			VAR _mosTime = 
			    CALCULATE(
			        SUM(radiologist_metrics[TotalTime]),
			        radiologist_metrics[Period_Type] = "Drafting",
			        radiologist_metrics[Modality_Code] = "US",
			        radiologist_metrics[Outliers] = "Excluded"
			    )
			
			VAR _mosTBWU = 
			    CALCULATE(
			        SUM(radiologist_metrics[TotalTBWU]),
			        radiologist_metrics[Period_Type] = "Drafting",
			        radiologist_metrics[Modality_Code] = "US",
			        radiologist_metrics[Outliers] = "Excluded"
			    )
			
			VAR _mosEff = DIVIDE(_mosTBWU, _mosTime / 60)
			
			VAR _directResult = DIVIDE(_mosEff - _baseEff, _baseEff)
			
			// Weighted calculation for aggregate levels
			VAR _sitesWithCapture = 
			    FILTER(
			        VALUES(radiologist_metrics[Location_Name]),
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]),
			            radiologist_metrics[Period_Type] = "Drafting",
			            radiologist_metrics[Modality_Code] = "US",
			            radiologist_metrics[Outliers] = "Excluded"
			        ) > 0
			    )
			
			VAR _siteSummary = 
			    ADDCOLUMNS(
			        _sitesWithCapture,
			        "@Site_BaseEff", 
			            VAR _sBaseTime = 
			                CALCULATE(
			                    SUM(radiologist_metrics[TotalTime]),
			                    radiologist_metrics[Period_Type] = "Baseline",
			                    radiologist_metrics[Modality_Code] = "US",
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            VAR _sBaseTBWU = 
			                CALCULATE(
			                    SUM(radiologist_metrics[TotalTBWU]),
			                    radiologist_metrics[Period_Type] = "Baseline",
			                    radiologist_metrics[Modality_Code] = "US",
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            RETURN DIVIDE(_sBaseTBWU, _sBaseTime / 60),
			        "@Site_MosEff", 
			            VAR _sMosTime = 
			                CALCULATE(
			                    SUM(radiologist_metrics[TotalTime]),
			                    radiologist_metrics[Period_Type] = "Drafting",
			                    radiologist_metrics[Modality_Code] = "US",
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            VAR _sMosTBWU = 
			                CALCULATE(
			                    SUM(radiologist_metrics[TotalTBWU]),
			                    radiologist_metrics[Period_Type] = "Drafting",
			                    radiologist_metrics[Modality_Code] = "US",
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            RETURN DIVIDE(_sMosTBWU, _sMosTime / 60),
			        "@Site_MosTime", 
			            CALCULATE(
			                SUM(radiologist_metrics[TotalTime]),
			                radiologist_metrics[Period_Type] = "Drafting",
			                radiologist_metrics[Modality_Code] = "US",
			                radiologist_metrics[Outliers] = "Excluded"
			            )
			    )
			
			VAR _weightedBaseEff = 
			    DIVIDE(
			        SUMX(_siteSummary, [@Site_BaseEff] * [@Site_MosTime]),
			        SUMX(_siteSummary, [@Site_MosTime])
			    )
			
			VAR _weightedMosEff = 
			    DIVIDE(
			        SUMX(_siteSummary, [@Site_MosEff] * [@Site_MosTime]),
			        SUMX(_siteSummary, [@Site_MosTime])
			    )
			
			VAR _weightedResult = DIVIDE(_weightedMosEff - _weightedBaseEff, _weightedBaseEff)
			
			// At Total level: weighted avg across qualifying practices only
			VAR _qualifiedPractices = 
			    FILTER(
			        VALUES(radiologist_metrics[Practice]),
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]),
			            radiologist_metrics[Period_Type] = "Drafting",
			            radiologist_metrics[Modality_Code] = "US",
			            radiologist_metrics[Outliers] = "Excluded"
			        ) >= _minCaptured
			    )
			
			VAR _practiceSummary = 
			    ADDCOLUMNS(
			        _qualifiedPractices,
			        "@Prac_BaseEff", 
			            VAR _pBaseTime = 
			                CALCULATE(
			                    SUM(radiologist_metrics[TotalTime]),
			                    radiologist_metrics[Period_Type] = "Baseline",
			                    radiologist_metrics[Modality_Code] = "US",
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            VAR _pBaseTBWU = 
			                CALCULATE(
			                    SUM(radiologist_metrics[TotalTBWU]),
			                    radiologist_metrics[Period_Type] = "Baseline",
			                    radiologist_metrics[Modality_Code] = "US",
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            RETURN DIVIDE(_pBaseTBWU, _pBaseTime / 60),
			        "@Prac_MosEff", 
			            VAR _pMosTime = 
			                CALCULATE(
			                    SUM(radiologist_metrics[TotalTime]),
			                    radiologist_metrics[Period_Type] = "Drafting",
			                    radiologist_metrics[Modality_Code] = "US",
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            VAR _pMosTBWU = 
			                CALCULATE(
			                    SUM(radiologist_metrics[TotalTBWU]),
			                    radiologist_metrics[Period_Type] = "Drafting",
			                    radiologist_metrics[Modality_Code] = "US",
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            RETURN DIVIDE(_pMosTBWU, _pMosTime / 60),
			        "@Prac_MosTime", 
			            CALCULATE(
			                SUM(radiologist_metrics[TotalTime]),
			                radiologist_metrics[Period_Type] = "Drafting",
			                radiologist_metrics[Modality_Code] = "US",
			                radiologist_metrics[Outliers] = "Excluded"
			            )
			    )
			
			VAR _weightedBaseEffTotal = 
			    DIVIDE(
			        SUMX(_practiceSummary, [@Prac_BaseEff] * [@Prac_MosTime]),
			        SUMX(_practiceSummary, [@Prac_MosTime])
			    )
			
			VAR _weightedMosEffTotal = 
			    DIVIDE(
			        SUMX(_practiceSummary, [@Prac_MosEff] * [@Prac_MosTime]),
			        SUMX(_practiceSummary, [@Prac_MosTime])
			    )
			
			VAR _weightedResultTotal = DIVIDE(_weightedMosEffTotal - _weightedBaseEffTotal, _weightedBaseEffTotal)
			
			VAR _result = 
			    SWITCH(
			        TRUE(),
			        IsSiteLevel, _directResult,
			        IsActualTotalLevel, _weightedResultTotal,
			        _weightedResult
			    )
			
			RETURN
			IF(
			    IsActualTotalLevel || _thresholdCheck >= _minCaptured,
			    _result,
			    BLANK()
			)
			```
		formatString: 0%;-0%;0%
		lineageTag: b9e771e2-9298-4807-8bdf-557313a18bc8

