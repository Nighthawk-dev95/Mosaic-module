table team_rollups
	lineageTag: 5b22a053-5a54-4e6e-b1d8-ead5e2942ce5

	measure 'Mosaic Time All Time' =
			
			CALCULATE(
			    SUM(radiologist_metrics[TotalTime]),
			    radiologist_metrics[Period_Type] IN {"Drafting", "Reporting"},
			    radiologist_metrics[Outliers] = "Excluded"
			) / 60
		lineageTag: 8c4790cc-a4ae-4822-8bab-2d55cc85924c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Captured US' = ```
			
			VAR _minCaptured = SELECTEDVALUE('Min Captured Exams'[Value], 0)
			
			VAR IsSiteLevel = ISINSCOPE(radiologist_metrics[Location_Name])
			VAR IsRadiologistLevel = ISINSCOPE(radiologist_metrics[Radiologist]) && NOT IsSiteLevel
			VAR IsPracticeLevel = ISINSCOPE(radiologist_metrics[Practice]) && NOT IsRadiologistLevel && NOT IsSiteLevel
			VAR PracticeCount = COUNTROWS(VALUES(radiologist_metrics[Practice]))
			VAR IsActualTotalLevel = NOT IsSiteLevel && NOT IsRadiologistLevel && NOT IsPracticeLevel && PracticeCount > 1
			
			VAR _captured = 
			    CALCULATE(
			        SUM(radiologist_metrics[ExamCount]),
			        radiologist_metrics[Period_Type] = "Drafting",
			        radiologist_metrics[Modality_Code] = "US",
			        radiologist_metrics[Outliers] = "Excluded"
			    )
			
			// Get Practice total for threshold check
			VAR _practiceCaptured = 
			    CALCULATE(
			        SUM(radiologist_metrics[ExamCount]),
			        REMOVEFILTERS(radiologist_metrics[Location_Name]),
			        REMOVEFILTERS(radiologist_metrics[Radiologist]),
			        radiologist_metrics[Period_Type] = "Drafting",
			        radiologist_metrics[Modality_Code] = "US",
			        radiologist_metrics[Outliers] = "Excluded"
			    )
			
			// At Total level: sum only qualifying practices
			VAR _qualifiedPractices = 
			    FILTER(
			        VALUES(radiologist_metrics[Practice]),
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]),
			            radiologist_metrics[Period_Type] = "Drafting",
			            radiologist_metrics[Modality_Code] = "US",
			            radiologist_metrics[Outliers] = "Excluded"
			        ) >= _minCaptured
			    )
			
			VAR _totalAcrossQualified = 
			    SUMX(
			        _qualifiedPractices,
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]),
			            radiologist_metrics[Period_Type] = "Drafting",
			            radiologist_metrics[Modality_Code] = "US",
			            radiologist_metrics[Outliers] = "Excluded"
			        )
			    )
			
			VAR _thresholdCheck = 
			    IF(
			        IsSiteLevel || IsRadiologistLevel,
			        _practiceCaptured,
			        _captured
			    )
			
			VAR _result = 
			    SWITCH(
			        TRUE(),
			        IsActualTotalLevel, _totalAcrossQualified,
			        _captured
			    )
			
			RETURN
			IF(
			    IsActualTotalLevel || _thresholdCheck >= _minCaptured,
			    _result,
			    BLANK()
			)
			```
		formatString: 0
		lineageTag: 1cadec14-816f-4b19-b4a6-416c5e37940d

	measure 'Rad Total Mosaic Exams US Page' =
			
			VAR IsSingleRad = COUNTROWS(VALUES(radiologist_summary[Radiologist])) = 1
			
			VAR RadTotal = MAX(radiologist_summary[Rad_Total_FullMosaic_ExclOutliers])
			VAR TotalAcrossRads = SUM(radiologist_summary[Rad_Total_FullMosaic_ExclOutliers])
			
			RETURN
			IF(IsSingleRad, RadTotal, TotalAcrossRads)
		formatString: 0
		lineageTag: b1bf6256-4060-49a5-bd25-ab0e8873b3ec

	measure 'Baseline Efficiency Base' = ```
			
			VAR _baseTime = 
			    CALCULATE(
			        SUM(radiologist_metrics[TotalTime]),
			        radiologist_metrics[Period_Type] = "Baseline",
			        radiologist_metrics[Outliers] = "Excluded",
			        radiologist_metrics[Modality_Code] = "US"
			    )
			
			VAR _baseTBWU = 
			    CALCULATE(
			        SUM(radiologist_metrics[TotalTBWU]),
			        radiologist_metrics[Period_Type] = "Baseline",
			        radiologist_metrics[Outliers] = "Excluded",
			        radiologist_metrics[Modality_Code]= "US"
			    )
			
			RETURN
			DIVIDE(_baseTBWU, _baseTime / 60)
