table Case_Buckets_Cumulative
	lineageTag: 76a1f12a-0987-48d1-a52b-3f482e961a41

	measure Count_Rads_In_Bucket_Cumulative = ```
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			VAR _minBucket = SELECTEDVALUE(Case_Buckets_Cumulative[MinExams], 0)
			VAR _maxBucket = SELECTEDVALUE(Case_Buckets_Cumulative[MaxExams], 999999)
			VAR _currentMonthEnd = EOMONTH(MAX(radiologist_metrics[Exam_Date]), 0)
			
			VAR _activeRadsDrafting = 
			    CALCULATETABLE(
			        DISTINCT(radiologist_metrics[Radiologist]),
			        radiologist_metrics[Is_Drafting_Row] = 1,
			        radiologist_metrics[Modality_Code] IN {"CR","CT"},
			        radiologist_metrics[Outliers] = "Excluded"
			    )
			
			VAR _activeRadsReporting = 
			    CALCULATETABLE(
			        DISTINCT(radiologist_metrics[Radiologist]),
			        radiologist_metrics[Is_Reporting_Row] = 1,
			        radiologist_metrics[Outliers] = "Excluded"
			    )
			
			VAR _activeRadsFullMosaic = 
			    CALCULATETABLE(
			        DISTINCT(radiologist_metrics[Radiologist]),
			        radiologist_metrics[Is_Mosaic_Row] = 1,
			        radiologist_metrics[Outliers] = "Excluded"
			    )
			
			VAR _activeRadsCaptureOnly = 
			    CALCULATETABLE(
			        DISTINCT(radiologist_metrics[Radiologist]),
			        radiologist_metrics[Is_Capture_Row] = 1,
			        radiologist_metrics[Outliers] = "Excluded",
			        radiologist_metrics[Modality_Code] IN {"US","BD"}
			    )
			
			VAR _activeRadsDraftingCapture = 
			    CALCULATETABLE(
			        DISTINCT(radiologist_metrics[Radiologist]),
			        (
			            (radiologist_metrics[Is_Drafting_Row] = 1
			                && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			            || (radiologist_metrics[Is_Capture_Row] = 1
			                && radiologist_metrics[Modality_Code] IN {"US","BD"})
			        ),
			        radiologist_metrics[Outliers] = "Excluded"
			    )
			
			-- Drafting Only (CR + CT only)
			VAR _resultDraftingOnly = 
			    COUNTROWS(
			        FILTER(
			            _activeRadsDrafting,
			            VAR _currentRad = [Radiologist]
			            VAR _cumulativeExams = 
			                CALCULATE(
			                    SUM(radiologist_metrics[ExamCount]),
			                    FILTER(
			                        ALL(radiologist_metrics),
			                        radiologist_metrics[Radiologist] = _currentRad &&
			                        radiologist_metrics[Is_Drafting_Row] = 1 &&
			                        radiologist_metrics[Modality_Code] IN {"CR","CT"} &&
			                        radiologist_metrics[Outliers] = "Excluded" &&
			                        radiologist_metrics[Exam_Date] <= _currentMonthEnd
			                    )
			                )
			            RETURN _cumulativeExams >= _minBucket && _cumulativeExams <= _maxBucket
			        )
			    )
			
			-- Reporting Only (unchanged)
			VAR _resultReportingOnly = 
			    COUNTROWS(
			        FILTER(
			            _activeRadsReporting,
			            VAR _currentRad = [Radiologist]
			            VAR _cumulativeExams = 
			                CALCULATE(
			                    SUM(radiologist_metrics[ExamCount]),
			                    FILTER(
			                        ALL(radiologist_metrics),
			                        radiologist_metrics[Radiologist] = _currentRad &&
			                        radiologist_metrics[Is_Reporting_Row] = 1 &&
			                        radiologist_metrics[Outliers] = "Excluded" &&
			                        radiologist_metrics[Exam_Date] <= _currentMonthEnd
			                    )
			                )
			            RETURN _cumulativeExams >= _minBucket && _cumulativeExams <= _maxBucket
			        )
			    )
			
			-- Full Mosaic (unchanged)
			VAR _resultFullMosaic = 
			    COUNTROWS(
			        FILTER(
			            _activeRadsFullMosaic,
			            VAR _currentRad = [Radiologist]
			            VAR _cumulativeExams = 
			                CALCULATE(
			                    SUM(radiologist_metrics[ExamCount]),
			                    FILTER(
			                        ALL(radiologist_metrics),
			                        radiologist_metrics[Radiologist] = _currentRad &&
			                        radiologist_metrics[Is_Mosaic_Row] = 1 &&
			                        radiologist_metrics[Outliers] = "Excluded" &&
			                        radiologist_metrics[Exam_Date] <= _currentMonthEnd
			                    )
			                )
			            RETURN _cumulativeExams >= _minBucket && _cumulativeExams <= _maxBucket
			        )
			    )
			
			-- Capture Only (unchanged)
			VAR _resultCaptureOnly = 
			    COUNTROWS(
			        FILTER(
			            _activeRadsCaptureOnly,
			            VAR _currentRad = [Radiologist]
			            VAR _cumulativeExams = 
			                CALCULATE(
			                    SUM(radiologist_metrics[ExamCount]),
			                    FILTER(
			                        ALL(radiologist_metrics),
			                        radiologist_metrics[Radiologist] = _currentRad &&
			                        radiologist_metrics[Is_Capture_Row] = 1 &&
			                        radiologist_metrics[Outliers] = "Excluded" &&
			                        radiologist_metrics[Modality_Code] IN {"US","BD"} &&
			                        radiologist_metrics[Exam_Date] <= _currentMonthEnd
			                    )
			                )
			            RETURN _cumulativeExams >= _minBucket && _cumulativeExams <= _maxBucket
			        )
			    )
			
			-- Drafting + Capture (new)
			VAR _resultDraftingCapture = 
			    COUNTROWS(
			        FILTER(
			            _activeRadsDraftingCapture,
			            VAR _currentRad = [Radiologist]
			            VAR _cumulativeExams = 
			                CALCULATE(
			                    SUM(radiologist_metrics[ExamCount]),
			                    FILTER(
			                        ALL(radiologist_metrics),
			                        radiologist_metrics[Radiologist] = _currentRad &&
			                        (
			                            (radiologist_metrics[Is_Drafting_Row] = 1
			                                && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                            || (radiologist_metrics[Is_Capture_Row] = 1
			                                && radiologist_metrics[Modality_Code] IN {"US","BD"})
			                        ) &&
			                        radiologist_metrics[Outliers] = "Excluded" &&
			                        radiologist_metrics[Exam_Date] <= _currentMonthEnd
			                    )
			                )
			            RETURN _cumulativeExams >= _minBucket && _cumulativeExams <= _maxBucket
			        )
			    )
			
			RETURN
			SWITCH(
			    _mode,
			    "Capture Only",       _resultCaptureOnly,
			    "Drafting Only",      _resultDraftingOnly,
			    "Reporting Only",     _resultReportingOnly,
			    "Drafting + Capture", _resultDraftingCapture,
			    _resultFullMosaic
			)
			```
		formatString: 0
		lineageTag: 7825bf92-db5f-4414-98bb-f26de04dc29e

	measure Debug_Cumulative_Exams =
			
			VAR _currentMonthEnd = EOMONTH(MAX(radiologist_metrics[Exam_Date]), 0)
			
			RETURN
			CALCULATE(
			    SUM(radiologist_metrics[ExamCount]),
			    radiologist_metrics[Is_Mosaic_Row] = 1,
			    radiologist_metrics[Outliers] = "Excluded",
			    FILTER(
			        ALL(radiologist_metrics[Exam_Date]),
			        radiologist_metrics[Exam_Date] <= _currentMonthEnd
			    )
			)
		formatString: 0
		lineageTag: 6f2b2989-0a01-4f3c-b226-fe4b1fc238cd

