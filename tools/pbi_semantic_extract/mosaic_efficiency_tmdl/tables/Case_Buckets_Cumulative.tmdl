	partition Case_Buckets_Cumulative = calculated
		mode: import
		source =
				
				DATATABLE(
				    "Bucket", STRING,
				    "BucketOrder", INTEGER,
				    "StackOrder", INTEGER,
				    "MinExams", INTEGER,
				    "MaxExams", INTEGER,
				    {
				        {"0-500", 1, 6, 0, 500},
				        {"501-1000", 2, 5, 501, 1000},
				        {"1001-2000", 3, 4, 1001, 2000},
				        {"2001-3000", 4, 3, 2001, 3000},
				        {"3001-5000", 5, 2, 3001, 5000},
				        {"5001+", 6, 1, 5001, 999999}
				    }
				)

	annotation PBI_Id = 25cb809b6f8a459a887406aa76317fa5

