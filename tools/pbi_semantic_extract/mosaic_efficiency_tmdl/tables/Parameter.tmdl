	measure Pct_Change_Metric_Opt =
			
			VAR IsProcedureLevel = ISINSCOPE(radiologist_metrics[Parent_Procedure_name])
			VAR IsRadiologistInScope = ISINSCOPE(radiologist_summary[Radiologist])
			
			VAR IsProcUnderRad = IsProcedureLevel && IsRadiologistInScope
			VAR IsRadLevel = IsRadiologistInScope && NOT IsProcedureLevel
			VAR IsTeamOrTotal = NOT IsProcedureLevel && NOT IsRadiologistInScope
			
			VAR _radQualifies = [Rad_Qualifies_Opt] = 1
			VAR _examHasBoth = [Exam_Has_Both_Opt] = 1
			
			// Procedure-specific % change
			VAR _procBaseline = [Base_Baseline_Eff_Opt]
			VAR _procMosaic = [Base_Mosaic_Eff_Opt]
			VAR _procPctChange = DIVIDE(_procMosaic - _procBaseline, _procBaseline)
			
			RETURN
			IF(
			    IsProcUnderRad, IF(_radQualifies && _examHasBoth, _procPctChange, BLANK()),
			    IF(
			        IsRadLevel, IF(_radQualifies, [Rad_Pct_Change_Opt], BLANK()),
			        IF(IsTeamOrTotal, [_Team_Pct_Change_Opt], BLANK())
			    )
			)
		formatString: 0%;-0%;0%
		lineageTag: 2c2736d3-2ecd-4c82-bf4d-e3f893d71f3d

