	measure _Exam_Page_Total_Baseline_Eff_Opt = ```
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			
			VAR _qualifiedExams = 
			    FILTER(
			        DISTINCT(radiologist_metrics[Parent_Procedure_name]),
			        CALCULATE([Exam_Qualifies_Opt]) = 1
			    )
			
			VAR _examData =
			    ADDCOLUMNS(
			        _qualifiedExams,
			        "@WeightedBaselineContrib",
			            CALCULATE(
			                SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]),
			                radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                SWITCH(
			                    _mode,
			                    "Drafting Only",        radiologist_metrics[Is_Drafting_Row] = 1,
			                    "Reporting Only",       radiologist_metrics[Is_Reporting_Row] = 1,
			                    "Full Mosaic",          radiologist_metrics[Is_Mosaic_Row] = 1,
			                    radiologist_metrics[Is_Mosaic_Row] = 1
			                ),
			                radiologist_metrics[Outliers] = "Excluded"
			            ),
			        "@Time",
			            CALCULATE(
			                SUM(radiologist_metrics[TotalTime]),
			                radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                SWITCH(
			                    _mode,
			                    "Drafting Only",        radiologist_metrics[Is_Drafting_Row] = 1,
			                    "Reporting Only",       radiologist_metrics[Is_Reporting_Row] = 1,
			                    "Full Mosaic",          radiologist_metrics[Is_Mosaic_Row] = 1,
			                    radiologist_metrics[Is_Mosaic_Row] = 1
			                ),
			                radiologist_metrics[Outliers] = "Excluded"
			            )
			    )
			
			VAR _examDataDraftingOnly =
			    ADDCOLUMNS(
			        _qualifiedExams,
			        "@WeightedBaselineContrib",
			            CALCULATE(
			                SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]),
			                radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                radiologist_metrics[Is_Drafting_Row] = 1,
			                radiologist_metrics[Modality_Code] IN {"CR","CT"},
			                radiologist_metrics[Outliers] = "Excluded"
			            ),
			        "@Time",
			            CALCULATE(
			                SUM(radiologist_metrics[TotalTime]),
			                radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                radiologist_metrics[Is_Drafting_Row] = 1,
			                radiologist_metrics[Modality_Code] IN {"CR","CT"},
			                radiologist_metrics[Outliers] = "Excluded"
			            )
			    )
			
			VAR _examDataCaptureOnly =
			    ADDCOLUMNS(
			        _qualifiedExams,
			        "@WeightedBaselineContrib",
			            CALCULATE(
			                SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]),
			                radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                radiologist_metrics[Is_Capture_Row] = 1,
			                radiologist_metrics[Modality_Code] IN {"US","BD"},
			                radiologist_metrics[Outliers] = "Excluded"
			            ),
			        "@Time",
			            CALCULATE(
			                SUM(radiologist_metrics[TotalTime]),
			                radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                radiologist_metrics[Is_Capture_Row] = 1,
			                radiologist_metrics[Modality_Code] IN {"US","BD"},
			                radiologist_metrics[Outliers] = "Excluded"
			            )
			    )
			
			VAR _examDataDraftingCapture =
			    ADDCOLUMNS(
			        _qualifiedExams,
			        "@WeightedBaselineContrib",
			            CALCULATE(
			                SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]),
			                radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                (
			                    (radiologist_metrics[Is_Drafting_Row] = 1 && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                    || (radiologist_metrics[Is_Capture_Row] = 1 && radiologist_metrics[Modality_Code] IN {"US","BD"})
			                ),
			                radiologist_metrics[Outliers] = "Excluded"
			            ),
			        "@Time",
			            CALCULATE(
			                SUM(radiologist_metrics[TotalTime]),
			                radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                (
			                    (radiologist_metrics[Is_Drafting_Row] = 1 && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                    || (radiologist_metrics[Is_Capture_Row] = 1 && radiologist_metrics[Modality_Code] IN {"US","BD"})
			                ),
			                radiologist_metrics[Outliers] = "Excluded"
			            )
			    )
			
			RETURN
			SWITCH(
			    _mode,
			    "Drafting Only",
			        DIVIDE(
			            SUMX(_examDataDraftingOnly, [@WeightedBaselineContrib]),
			            SUMX(_examDataDraftingOnly, [@Time])
			        ),
			    "Capture Only",
			        DIVIDE(
			            SUMX(_examDataCaptureOnly, [@WeightedBaselineContrib]),
			            SUMX(_examDataCaptureOnly, [@Time])
			        ),
			    "Drafting + Capture",
			        DIVIDE(
			            SUMX(_examDataDraftingCapture, [@WeightedBaselineContrib]),
			            SUMX(_examDataDraftingCapture, [@Time])
			        ),
			    -- Default: Reporting Only, Full Mosaic
			    DIVIDE(
			        SUMX(_examData, [@WeightedBaselineContrib]),
			        SUMX(_examData, [@Time])
			    )
			)
			```
