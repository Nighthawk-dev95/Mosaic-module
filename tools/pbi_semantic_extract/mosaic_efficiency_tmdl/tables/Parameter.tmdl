	measure Passes_Min_Exam_Opt =
			
			VAR _minExams = SELECTEDVALUE('Mosaic Min Exams'[MinExams], 1)
			VAR _radExams = [Rad_Mosaic_Exams_Opt]
			RETURN IF(_radExams >= _minExams, 1, 0)
		formatString: 0
		lineageTag: a4dcd8b9-6a33-4c2b-ad36-15dea4551719

	measure Passes_View_Filter_Opt =
			
			VAR _view = SELECTEDVALUE('Readtimeview'[RT View], "All")
			VAR _pctChange = [Rad_Pct_Change_Opt]
			
			RETURN
			IF(
			    _view = "All", 1,
			    IF(_view = "Positive" && _pctChange > 0, 1,
			    IF(_view = "Negative" && _pctChange < 0, 1, 0))
			)
		formatString: 0
		lineageTag: f276ad67-7fd0-4dc0-8b54-4ff10c2f3380

	measure Rad_Qualifies_Opt =
			
			VAR _passesMin = [Passes_Min_Exam_Opt] = 1
			VAR _hasBoth = [Rad_Has_Both_Opt] = 1
			VAR _passesView = [Passes_View_Filter_Opt] = 1
			
			RETURN IF(_passesMin && _hasBoth && _passesView, 1, 0)
		formatString: 0
		lineageTag: dbc6157c-e54f-4dc1-933f-1c823659a757

	measure Exam_Has_Both_Opt =
			
			VAR _hasMosaic = [Exam_Total_Mosaic_Exams_Opt] > 0
			VAR _hasBaseline = [Exam_Total_Baseline_Exams_Opt] > 0
			VAR _hasBaselineEff = NOT ISBLANK([Exam_Weighted_Baseline_Opt]) && [Exam_Weighted_Baseline_Opt] > 0
			VAR _hasMosaicEff = NOT ISBLANK([Exam_Weighted_Mosaic_Opt])
			
			RETURN IF(_hasMosaic && _hasBaseline && _hasBaselineEff && _hasMosaicEff, 1, 0)
		formatString: 0
		lineageTag: 6b02f703-f5a2-4f6b-b4e6-8afe2bac3fc3

	measure Hasbothmetricseff_Opt =
			
			VAR IsProcedureLevel = ISINSCOPE(radiologist_metrics[Parent_Procedure_name])
			VAR IsRadiologistInScope = ISINSCOPE(radiologist_summary[Radiologist])
			
			VAR IsProcUnderRad = IsProcedureLevel && IsRadiologistInScope
			VAR IsRadLevel = IsRadiologistInScope && NOT IsProcedureLevel
			VAR IsTeamOrTotal = NOT IsProcedureLevel && NOT IsRadiologistInScope
			
			VAR _radQualifies = [Rad_Qualifies_Opt] = 1
			VAR _examHasBoth = [Exam_Has_Both_Opt] = 1
			
			RETURN
			IF(
			    IsProcUnderRad, IF(_radQualifies && _examHasBoth, 1, 0),
			    IF(
			        IsRadLevel, IF(_radQualifies, 1, 0),
			        IF(IsTeamOrTotal, 1, 0)
			    )
			)
		formatString: 0
		lineageTag: 566d39c8-45f3-48f9-9eb3-faebbccba04b

	measure RTFILTERFLAG_Opt =
			
			VAR _view = SELECTEDVALUE('Readtimeview'[RT View], "All")
			
			VAR IsProcedureLevel = ISINSCOPE(radiologist_metrics[Parent_Procedure_name])
			VAR IsRadiologistInScope = ISINSCOPE(radiologist_summary[Radiologist])
			
			VAR IsProcUnderRad = IsProcedureLevel && IsRadiologistInScope
			VAR IsRadLevel = IsRadiologistInScope && NOT IsProcedureLevel
			VAR IsTeamOrTotal = NOT IsProcedureLevel && NOT IsRadiologistInScope
			
			RETURN
			IF(
			    _view = "All", 1,
			    IF(
			        IsProcUnderRad || IsRadLevel, [Passes_View_Filter_Opt],
			        IF(IsTeamOrTotal, 1, 0)
			    )
			)
		formatString: 0
		lineageTag: 08e1c011-ab4c-4f15-922b-374e767f9a9f

	measure Baseline_Metric_Opt =
			
			VAR IsProcedureLevel = ISINSCOPE(radiologist_metrics[Parent_Procedure_name])
			VAR IsRadiologistInScope = ISINSCOPE(radiologist_summary[Radiologist])
			
			VAR IsProcUnderRad = IsProcedureLevel && IsRadiologistInScope
			VAR IsRadLevel = IsRadiologistInScope && NOT IsProcedureLevel
			VAR IsTeamOrTotal = NOT IsProcedureLevel && NOT IsRadiologistInScope
			
			VAR _radQualifies = [Rad_Qualifies_Opt] = 1
			VAR _examHasBoth = [Exam_Has_Both_Opt] = 1
			
			RETURN
			IF(
			    IsProcUnderRad, IF(_radQualifies && _examHasBoth, [Base_Baseline_Eff_Opt], BLANK()),
			    IF(
			        IsRadLevel, IF(_radQualifies, [Rad_Weighted_Baseline_Opt], BLANK()),
			        IF(IsTeamOrTotal, [_Team_Weighted_Baseline_Opt], BLANK())
			    )
			)
		formatString: 0.000
		lineageTag: f4c49098-c822-4660-8a0d-ed783691f29e

	measure Mosaic_Metric_Opt =
			
			VAR IsProcedureLevel = ISINSCOPE(radiologist_metrics[Parent_Procedure_name])
			VAR IsRadiologistInScope = ISINSCOPE(radiologist_summary[Radiologist])
			
			VAR IsProcUnderRad = IsProcedureLevel && IsRadiologistInScope
			VAR IsRadLevel = IsRadiologistInScope && NOT IsProcedureLevel
			VAR IsTeamOrTotal = NOT IsProcedureLevel && NOT IsRadiologistInScope
			
			VAR _radQualifies = [Rad_Qualifies_Opt] = 1
			VAR _examHasBoth = [Exam_Has_Both_Opt] = 1
			
			RETURN
			IF(
			    IsProcUnderRad, IF(_radQualifies && _examHasBoth, [Base_Mosaic_Eff_Opt], BLANK()),
			    IF(
			        IsRadLevel, IF(_radQualifies, [Rad_Weighted_Mosaic_Opt], BLANK()),
			        IF(IsTeamOrTotal, [_Team_Weighted_Mosaic_Opt], BLANK())
			    )
			)
