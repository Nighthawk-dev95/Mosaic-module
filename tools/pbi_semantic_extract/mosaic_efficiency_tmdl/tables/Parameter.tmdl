table Parameter
	lineageTag: bb4a24ca-ab81-41c1-ba73-409363278597

	measure mosaicexams_opt =
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			VAR _outlierView = SELECTEDVALUE('Outlier Selector'[Outlier View], "Excluded")
			
			RETURN
			SWITCH(
			    _mode,
			    "Drafting Only",
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]),
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            radiologist_metrics[Is_Drafting_Row] = 1,
			            radiologist_metrics[Modality_Code] IN {"CR","CT"},
			            radiologist_metrics[Outliers] = "Excluded"
			        ),
			    "Reporting Only",
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]),
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            radiologist_metrics[Is_Reporting_Row] = 1,
			            radiologist_metrics[Outliers] = "Excluded"
			        ),
			    "Full Mosaic",
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]),
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            radiologist_metrics[Is_Mosaic_Row] = 1,
			            radiologist_metrics[Outliers] = "Excluded"
			        ),
			    "Capture Only",
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]),
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            radiologist_metrics[Is_Capture_Row] = 1,
			            radiologist_metrics[Modality_Code] IN {"US","BD"},
			            radiologist_metrics[Outliers] = "Excluded"
			        ),
			    "Drafting + Capture",
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]),
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            (
			                (radiologist_metrics[Is_Drafting_Row] = 1 && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                || (radiologist_metrics[Is_Capture_Row] = 1 && radiologist_metrics[Modality_Code] IN {"US","BD"})
			            ),
			            radiologist_metrics[Outliers] = "Excluded"
			        ),
			    -- Default
			    CALCULATE(
			        SUM(radiologist_metrics[ExamCount]),
			        radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        radiologist_metrics[Is_Mosaic_Row] = 1,
			        radiologist_metrics[Outliers] = "Excluded"
			    )
			)
		formatString: 0
		lineageTag: d3f45fe0-4aea-4863-806e-1f27318a6787

	measure baselineexams_opt =
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			VAR _outlierView = SELECTEDVALUE('Outlier Selector'[Outlier View], "Excluded")
			
			RETURN
			SWITCH(
			    _mode,
			    "Capture Only",
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]),
			            radiologist_metrics[Is_Baseline_Row] = 1,
			            radiologist_metrics[Outliers] = "Excluded",
			            radiologist_metrics[Modality_Code] IN {"US","BD"}
			        ),
			    "Drafting Only",
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]),
			            radiologist_metrics[Is_Baseline_Row] = 1,
			            radiologist_metrics[Outliers] = "Excluded",
			            radiologist_metrics[Modality_Code] IN {"CR","CT"}
			        ),
			    "Drafting + Capture",
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]),
			            radiologist_metrics[Is_Baseline_Row] = 1,
			            radiologist_metrics[Outliers] = "Excluded",
			            radiologist_metrics[Modality_Code] IN {"CR","CT","US","BD"}
			        ),
			    -- Default: Reporting Only, Full Mosaic
			    CALCULATE(
			        SUM(radiologist_metrics[ExamCount]),
			        radiologist_metrics[Is_Baseline_Row] = 1,
			        radiologist_metrics[Outliers] = "Excluded"
			    )
			)
		formatString: 0
		lineageTag: 7d4e208a-baaa-4b86-9022-527f929ff130

	measure Base_Time_Mosaic_Opt =
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			
			RETURN
			SWITCH(
			    _mode,
			    "Drafting Only",
			        CALCULATE(
			            SUM(radiologist_metrics[TotalTime]),
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            radiologist_metrics[Is_Drafting_Row] = 1,
			            radiologist_metrics[Modality_Code] IN {"CR","CT"},
			            radiologist_metrics[Outliers] = "Excluded"
			        ),
			    "Reporting Only",
			        CALCULATE(
			            SUM(radiologist_metrics[TotalTime]),
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            radiologist_metrics[Is_Reporting_Row] = 1,
			            radiologist_metrics[Outliers] = "Excluded"
			        ),
			    "Full Mosaic",
			        CALCULATE(
			            SUM(radiologist_metrics[TotalTime]),
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            radiologist_metrics[Is_Mosaic_Row] = 1,
			            radiologist_metrics[Outliers] = "Excluded"
			        ),
			    "Capture Only",
			        CALCULATE(
			            SUM(radiologist_metrics[TotalTime]),
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            radiologist_metrics[Is_Capture_Row] = 1,
			            radiologist_metrics[Modality_Code] IN {"US","BD"},
			            radiologist_metrics[Outliers] = "Excluded"
			        ),
			    "Drafting + Capture",
			        CALCULATE(
			            SUM(radiologist_metrics[TotalTime]),
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            (
			                (radiologist_metrics[Is_Drafting_Row] = 1 && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                || (radiologist_metrics[Is_Capture_Row] = 1 && radiologist_metrics[Modality_Code] IN {"US","BD"})
			            ),
			            radiologist_metrics[Outliers] = "Excluded"
			        ),
			    -- Default
			    CALCULATE(
			        SUM(radiologist_metrics[TotalTime]),
			        radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        radiologist_metrics[Is_Mosaic_Row] = 1,
			        radiologist_metrics[Outliers] = "Excluded"
			    )
			)
		formatString: 0
		lineageTag: 13552e9a-8c65-4637-b096-d9c6f2e3ae5d

	measure Base_Mosaic_Eff_Opt =
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			
			VAR _tbwu =
			    SWITCH(
			        _mode,
			        "Drafting Only",
			            CALCULATE(
			                SUM(radiologist_metrics[TotalTBWU]),
			                radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                radiologist_metrics[Is_Drafting_Row] = 1,
			                radiologist_metrics[Modality_Code] IN {"CR","CT"},
			                radiologist_metrics[Outliers] = "Excluded"
			            ),
			        "Reporting Only",
			            CALCULATE(
			                SUM(radiologist_metrics[TotalTBWU]),
			                radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                radiologist_metrics[Is_Reporting_Row] = 1,
			                radiologist_metrics[Outliers] = "Excluded"
			            ),
			        "Full Mosaic",
			            CALCULATE(
			                SUM(radiologist_metrics[TotalTBWU]),
			                radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                radiologist_metrics[Is_Mosaic_Row] = 1,
			                radiologist_metrics[Outliers] = "Excluded"
			            ),
			        "Capture Only",
			            CALCULATE(
			                SUM(radiologist_metrics[TotalTBWU]),
			                radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                radiologist_metrics[Is_Capture_Row] = 1,
			                radiologist_metrics[Modality_Code] IN {"US","BD"},
			                radiologist_metrics[Outliers] = "Excluded"
			            ),
			        "Drafting + Capture",
			            CALCULATE(
			                SUM(radiologist_metrics[TotalTBWU]),
			                radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                (
			                    (radiologist_metrics[Is_Drafting_Row] = 1 && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                    || (radiologist_metrics[Is_Capture_Row] = 1 && radiologist_metrics[Modality_Code] IN {"US","BD"})
			                ),
			                radiologist_metrics[Outliers] = "Excluded"
			            ),
			        -- Default
			        CALCULATE(
			            SUM(radiologist_metrics[TotalTBWU]),
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            radiologist_metrics[Is_Mosaic_Row] = 1,
			            radiologist_metrics[Outliers] = "Excluded"
			        )
			    )
			
			VAR _time = [Base_Time_Mosaic_Opt]
			
			RETURN DIVIDE(_tbwu, _time / 60)
		lineageTag: bf76cdb4-1efa-4151-8059-79b80cfb79b3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Base_Baseline_Eff_Opt =
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			VAR _outlierView = SELECTEDVALUE('Outlier Selector'[Outlier View], "Excluded")
			
			RETURN
			SWITCH(
			    _mode,
			    "Capture Only",
			        IF(_outlierView = "Excluded",
			            MAX(radiologist_metrics[Baseline_USBD_Eff_Proc_Excl]),
			            MAX(radiologist_metrics[Baseline_USBD_Eff_Proc_Incl])
			        ),
			    "Drafting + Capture",
			        -- Blended baseline using both CR/CT and US/BD
			        -- Use standard baseline since it covers all modalities
			        IF(_outlierView = "Excluded",
			            MAX(radiologist_metrics[Baseline_Eff_Proc_Excl]),
			            MAX(radiologist_metrics[Baseline_Eff_Proc_Incl])
			        ),
			    -- Default: Drafting Only, Reporting Only, Full Mosaic
			    IF(_outlierView = "Excluded",
			        MAX(radiologist_metrics[Baseline_Eff_Proc_Excl]),
			        MAX(radiologist_metrics[Baseline_Eff_Proc_Incl])
			    )
			)
		lineageTag: 01cab8b6-da4a-4683-9d6e-800e11ac58f2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Has_Baseline_Opt =
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			VAR _exclOutliers = SELECTEDVALUE('Outlier Selector'[Outlier View], "Excluded") = "Excluded"
			
			RETURN
			IF(_mode = "Capture Only",
			    IF(_exclOutliers,
			        MAX(radiologist_metrics[Has_Baseline_USBD_Proc_Excl]),
			        MAX(radiologist_metrics[Has_Baseline_USBD_Proc_Incl])
			    ),
			    IF(_exclOutliers,
			        MAX(radiologist_metrics[Has_Baseline_Proc_Excl]),
			        MAX(radiologist_metrics[Has_Baseline_Proc_Incl])
			    )
			)
		formatString: 0
		lineageTag: bb383083-908d-4150-b956-23e5beb5e7f2

	measure Rad_Mosaic_Exams_Opt =
			
			CALCULATE(
			    [mosaicexams_opt],
			    ALLSELECTED(radiologist_metrics[Parent_Procedure_name])
			)
		formatString: 0
		lineageTag: 14c4e6ff-f1d9-4688-ad88-b23ebf7b5b8b

	measure Rad_Weighted_Baseline_Opt =
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			
			VAR _weightedBaseline =
			    CALCULATE(
			        DIVIDE(
			            SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]),
			            SUM(radiologist_metrics[TotalTime])
			        ),
			        radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        SWITCH(
			            _mode,
			            "Drafting Only",    radiologist_metrics[Is_Drafting_Row] = 1,
			            "Reporting Only",   radiologist_metrics[Is_Reporting_Row] = 1,
			            "Full Mosaic",      radiologist_metrics[Is_Mosaic_Row] = 1,
			            "Capture Only",     radiologist_metrics[Is_Capture_Row] = 1,
			            radiologist_metrics[Is_Mosaic_Row] = 1
			        ),
			        radiologist_metrics[Outliers] = "Excluded",
			        ALLSELECTED(radiologist_metrics[Parent_Procedure_name])
			    )
			
			VAR _weightedBaseline_DraftingOnly =
			    CALCULATE(
			        DIVIDE(
			            SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]),
			            SUM(radiologist_metrics[TotalTime])
			        ),
			        radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        radiologist_metrics[Is_Drafting_Row] = 1,
			        radiologist_metrics[Modality_Code] IN {"CR","CT"},
			        radiologist_metrics[Outliers] = "Excluded",
			        ALLSELECTED(radiologist_metrics[Parent_Procedure_name])
			    )
			
			VAR _weightedBaseline_CaptureOnly =
			    CALCULATE(
			        DIVIDE(
			            SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]),
			            SUM(radiologist_metrics[TotalTime])
			        ),
			        radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        radiologist_metrics[Is_Capture_Row] = 1,
			        radiologist_metrics[Modality_Code] IN {"US","BD"},
			        radiologist_metrics[Outliers] = "Excluded",
			        ALLSELECTED(radiologist_metrics[Parent_Procedure_name])
			    )
			
			VAR _weightedBaseline_DraftingCapture =
			    CALCULATE(
			        DIVIDE(
			            SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]),
			            SUM(radiologist_metrics[TotalTime])
			        ),
			        radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        (
			            (radiologist_metrics[Is_Drafting_Row] = 1 && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			            || (radiologist_metrics[Is_Capture_Row] = 1 && radiologist_metrics[Modality_Code] IN {"US","BD"})
			        ),
			        radiologist_metrics[Outliers] = "Excluded",
			        ALLSELECTED(radiologist_metrics[Parent_Procedure_name])
			    )
			
			RETURN
			SWITCH(
			    _mode,
			    "Drafting Only",      _weightedBaseline_DraftingOnly,
			    "Capture Only",       _weightedBaseline_CaptureOnly,
			    "Drafting + Capture", _weightedBaseline_DraftingCapture,
			    _weightedBaseline
			)
		lineageTag: c95a784b-eeeb-44fe-8f80-0a3b285bf348

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Rad_Weighted_Mosaic_Opt =
			
			CALCULATE(
			    [Base_Mosaic_Eff_Opt],
			    ALLSELECTED(radiologist_metrics[Parent_Procedure_name])
			)
		lineageTag: af804735-a4b6-4680-8f0c-5abf8c5d6eb6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Rad_Pct_Change_Opt =
			
			VAR _baseline = [Rad_Weighted_Baseline_Opt]
			VAR _mosaic = [Rad_Weighted_Mosaic_Opt]
			
			RETURN DIVIDE(_mosaic - _baseline, _baseline)
		lineageTag: dc1543ea-8929-4b2a-b593-b03cf9fdb0c4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Rad_Has_Both_Opt =
			
			VAR _baseline = [Rad_Weighted_Baseline_Opt]
			VAR _mosaic = [Rad_Weighted_Mosaic_Opt]
			
			RETURN IF(
			    NOT ISBLANK(_baseline) && _baseline > 0 && NOT ISBLANK(_mosaic),
			    1, 0
			)
		formatString: 0
		lineageTag: b52838ab-fda1-40eb-9763-e6397b96e05d

	measure Proc_AllTime_Exams_Opt = ```
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			VAR _outlierView = SELECTEDVALUE('Outlier Selector'[Outlier View], "Excluded")
			
			VAR _allTimeCount = 
			    CALCULATE(
			        SUM(radiologist_metrics[ExamCount]),
			        REMOVEFILTERS(radiologist_metrics[Exam_Date]),
			        SWITCH(
			            _mode,
			            "Drafting Only", radiologist_metrics[Is_Drafting_Row] = 1,
			            "Reporting Only", radiologist_metrics[Is_Reporting_Row] = 1,
			            "Full Mosaic", radiologist_metrics[Is_Mosaic_Row] = 1,
			            "Capture Only", radiologist_metrics[Is_Capture_Row] = 1,
			            radiologist_metrics[Is_Mosaic_Row] = 1
			        ),
			        radiologist_metrics[Outliers] = "Excluded"
			    )
			
			VAR _allTimeCountCaptureOnly = 
			    CALCULATE(
			        SUM(radiologist_metrics[ExamCount]),
			        REMOVEFILTERS(radiologist_metrics[Exam_Date]),
			        radiologist_metrics[Is_Capture_Row] = 1,
			        radiologist_metrics[Outliers] = "Excluded",
			        radiologist_metrics[Modality_Code] IN {"US", "BD"}
			    )
			
			RETURN
			IF(_mode = "Capture Only", _allTimeCountCaptureOnly, _allTimeCount)
			```
		formatString: 0
		lineageTag: 581d00cc-1b10-49f8-9440-ee55fb1744b5

