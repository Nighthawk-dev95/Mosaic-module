	measure AllTime_Exams_Exam_Page_Opt = ```
			
			VAR IsModalityLevel = ISINSCOPE(radiologist_metrics[Modality_Code])
			VAR IsExamLevel = ISINSCOPE(radiologist_metrics[Parent_Procedure_name])
			VAR IsRadiologistLevel = ISINSCOPE(radiologist_summary[Radiologist])
			
			RETURN
			IF(
			    IsModalityLevel || IsExamLevel || IsRadiologistLevel,
			    // Row levels
			    VAR IsRadUnderExam = IsModalityLevel && IsExamLevel && IsRadiologistLevel
			    VAR IsExamUnderModality = IsModalityLevel && IsExamLevel && NOT IsRadiologistLevel
			    VAR IsModalityOnly = IsModalityLevel && NOT IsExamLevel && NOT IsRadiologistLevel
			    
			    VAR _val = 
			        SWITCH(
			            TRUE(),
			            IsRadUnderExam, [Rad_Under_Exam_AllTime_Mosaic_Exams_Opt],
			            IsExamUnderModality, [Exam_AllTime_Mosaic_Exams_Opt],
			            IsModalityOnly, [Modality_AllTime_Mosaic_Exams_Exam_Page],
			            BLANK()
			        )
			    RETURN IF(_val > 0, _val, BLANK()),
			    
			    // Total level - EXACT same filters as Modality, just adds REMOVEFILTERS on Modality_Code
			    VAR _total = 
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]),
			            radiologist_metrics[Is_Mosaic_Row] = 1,
			            radiologist_metrics[Outliers] = "Excluded",
			            REMOVEFILTERS(radiologist_metrics[Exam_Date]),
			            REMOVEFILTERS(radiologist_metrics[Place_of_Service]),
			            REMOVEFILTERS(radiologist_metrics[Location_Name]),
			            REMOVEFILTERS(radiologist_metrics[working_subspecialty]),
			            REMOVEFILTERS(radiologist_metrics[Priority_Description]),
			            REMOVEFILTERS(radiologist_metrics[Parent_Procedure_name]),
			            REMOVEFILTERS(radiologist_metrics[Radiologist]),
			            REMOVEFILTERS(radiologist_metrics[Modality_Code]),
			            radiologist_metrics[Exam_Category] IN VALUES(radiologist_metrics[Exam_Category])
			        )
			    RETURN IF(_total > 0, _total, BLANK())
			)
			```
		formatString: 0
		lineageTag: 4288d765-f0f1-4ec8-8bff-9a834b513e8d

	measure _Total_Implied_RTS_Exam_Page_Opt = ```
			
			VAR SelectedMetric = SELECTEDVALUE('Metric Selector1'[Metric])
			VAR _isApplicableMetric = (SelectedMetric = "Mean RVU/min" || SelectedMetric = "Mean TBWU/min")
			VAR _minExams = SELECTEDVALUE('Mosaic Min Exams'[MinExams], 1)
			VAR _view = SELECTEDVALUE('Readtimeview'[RT View], "All")
			
			VAR _examMetrics = 
			    ADDCOLUMNS(
			        VALUES(radiologist_metrics[Parent_Procedure_name]),
			        "@ExamMosaic", CALCULATE([Exam_Total_Mosaic_Exams_Opt]),
			        "@ExamBaseline", CALCULATE([Exam_Total_Baseline_Exams_Opt]),
			        "@ExamBaselineEff", CALCULATE([Exam_Weighted_Baseline_Opt]),
			        "@ExamMosaicEff", CALCULATE([Exam_Weighted_Mosaic_Opt]),
			        "@ExamTime", CALCULATE([Exam_Total_Time_Opt])
			    )
			
			VAR _qualifiedExams = 
			    FILTER(
			        _examMetrics,
			        [@ExamMosaic] >= _minExams &&
			        [@ExamBaseline] > 0 &&
			        NOT ISBLANK([@ExamBaselineEff]) && [@ExamBaselineEff] > 0 &&
			        NOT ISBLANK([@ExamMosaicEff]) &&
			        (
			            _view = "All" ||
			            (_view = "Positive" && DIVIDE([@ExamMosaicEff] - [@ExamBaselineEff], [@ExamBaselineEff]) > 0) ||
			            (_view = "Negative" && DIVIDE([@ExamMosaicEff] - [@ExamBaselineEff], [@ExamBaselineEff]) < 0)
			        )
			    )
			
			VAR _totalBaseline = DIVIDE(
			    SUMX(_qualifiedExams, [@ExamBaselineEff] * [@ExamTime]),
			    SUMX(_qualifiedExams, [@ExamTime])
			)
			
			VAR _totalMosaic = DIVIDE(
			    SUMX(_qualifiedExams, [@ExamMosaicEff] * [@ExamTime]),
			    SUMX(_qualifiedExams, [@ExamTime])
			)
			
			RETURN 
			IF(
			    _isApplicableMetric && NOT ISBLANK(_totalBaseline) && NOT ISBLANK(_totalMosaic) && _totalMosaic <> 0,
			    DIVIDE(_totalBaseline, _totalMosaic) - 1,
			    BLANK()
			)
			```
		lineageTag: 8b5d29fc-f7fb-41d3-8d60-af57c48ef977

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Implied_RTS_Exam_Page_Opt =
			
			VAR SelectedMetric = SELECTEDVALUE('Metric Selector1'[Metric])
			VAR _isApplicableMetric = (SelectedMetric = "Mean RVU/min" || SelectedMetric = "Mean TBWU/min")
			
			VAR IsExamLevel = ISINSCOPE(radiologist_metrics[Parent_Procedure_name]) && NOT ISINSCOPE(radiologist_summary[Radiologist])
			VAR IsRadUnderExam = ISINSCOPE(radiologist_metrics[Parent_Procedure_name]) && ISINSCOPE(radiologist_summary[Radiologist])
			VAR IsTotalLevel = NOT ISINSCOPE(radiologist_metrics[Parent_Procedure_name]) && NOT ISINSCOPE(radiologist_summary[Radiologist])
			
			VAR _examQualifies = [Exam_Qualifies_Opt] = 1
			VAR _radHasData = [Rad_Has_Mosaic_Data_For_Exam_Opt] = 1
			
			RETURN
			IF(
			    NOT _isApplicableMetric, BLANK(),
			    IF(
			        IsExamLevel,
			        VAR _examBaseline = [Exam_Weighted_Baseline_Opt]
			        VAR _examMosaic = [Exam_Weighted_Mosaic_Opt]
			        RETURN IF(_examQualifies && _examMosaic <> 0, DIVIDE(_examBaseline, _examMosaic) - 1, BLANK()),
			        IF(
			            IsRadUnderExam,
			            VAR _radBaseline = [Base_Baseline_Eff_Opt]
			            VAR _radMosaic = [Base_Mosaic_Eff_Opt]
			            RETURN IF(_examQualifies && _radHasData && _radMosaic <> 0, DIVIDE(_radBaseline, _radMosaic) - 1, BLANK()),
			            IF(
			                IsTotalLevel,
			                VAR _totalBaseline = [_Exam_Page_Total_Baseline_Eff_Opt]
			                VAR _totalMosaic = [_Exam_Page_Total_Mosaic_Eff_Opt]
			                RETURN IF(_totalMosaic <> 0, DIVIDE(_totalBaseline, _totalMosaic) - 1, BLANK()),
			                BLANK()
			            )
			        )
			    )
			)
		formatString: 0%;-0%;0%
		lineageTag: 06fc37ab-5f9d-4945-bc1e-e308ebbb41f7

	measure Exam_AllTime_Exams_Opt = ```
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			
			VAR _allTimeCount = 
			    CALCULATE(
			        SUM(radiologist_metrics[ExamCount]),
			        REMOVEFILTERS(radiologist_metrics[Exam_Date]),
			        SWITCH(
			            _mode,
			            "Drafting Only", radiologist_metrics[Is_Drafting_Row] = 1,
			            "Reporting Only", radiologist_metrics[Is_Reporting_Row] = 1,
			            "Full Mosaic", radiologist_metrics[Is_Mosaic_Row] = 1,
			            "Capture Only", radiologist_metrics[Is_Capture_Row] = 1,
			            radiologist_metrics[Is_Mosaic_Row] = 1
			        ),
			        radiologist_metrics[Outliers] = "Excluded",
			        ALLSELECTED(radiologist_metrics[Radiologist])
			    )
			
			VAR _allTimeCountCaptureOnly = 
			    CALCULATE(
			        SUM(radiologist_metrics[ExamCount]),
			        REMOVEFILTERS(radiologist_metrics[Exam_Date]),
			        radiologist_metrics[Is_Capture_Row] = 1,
			        radiologist_metrics[Outliers] = "Excluded",
			        radiologist_metrics[Modality_Code] IN {"US", "BD"},
			        ALLSELECTED(radiologist_metrics[Radiologist])
			    )
			
			RETURN
