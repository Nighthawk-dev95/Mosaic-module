	measure Radiologist_Count_Display_Opt = ```
			
			VAR IsRadiologistInScope = ISINSCOPE(radiologist_summary[Radiologist])
			VAR TeamCount = COUNTROWS(VALUES(radiologist_summary[Team]))
			VAR IsTeamLevel = NOT IsRadiologistInScope && TeamCount = 1
			VAR IsTotalLevel = NOT IsRadiologistInScope && TeamCount > 1
			
			VAR _qualifiedRads = 
			    FILTER(
			        VALUES(radiologist_summary[Radiologist]),
			        CALCULATE([Rad_Qualifies_Opt]) = 1
			    )
			
			VAR _count = COUNTROWS(_qualifiedRads)
			
			RETURN
			SWITCH(
			    TRUE(),
			    IsRadiologistInScope, BLANK(),  // Don't show at Rad level (it's always 1)
			    IsTeamLevel, _count,
			    IsTotalLevel, _count,
			    _count
			)
			```
		formatString: 0
		lineageTag: 3b60cd2d-b320-42b3-b3f2-92c6fa9f82be

	measure mosaictbwu_opt =
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			VAR _outlierView = SELECTEDVALUE('Outlier Selector'[Outlier View], "Excluded")
			
			RETURN
			SWITCH(
			    _mode,
			    "Drafting Only",
			        CALCULATE(
			            SUM(radiologist_metrics[TotalTBWU]),
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            radiologist_metrics[Is_Drafting_Row] = 1,
			            radiologist_metrics[Modality_Code] IN {"CR","CT"},
			            radiologist_metrics[Outliers] = "Excluded"
			        ),
			    "Reporting Only",
			        CALCULATE(
			            SUM(radiologist_metrics[TotalTBWU]),
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            radiologist_metrics[Is_Reporting_Row] = 1,
			            radiologist_metrics[Outliers] = "Excluded"
			        ),
			    "Full Mosaic",
			        CALCULATE(
			            SUM(radiologist_metrics[TotalTBWU]),
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            radiologist_metrics[Is_Mosaic_Row] = 1,
			            radiologist_metrics[Outliers] = "Excluded"
			        ),
			    "Capture Only",
			        CALCULATE(
			            SUM(radiologist_metrics[TotalTBWU]),
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            radiologist_metrics[Is_Capture_Row] = 1,
			            radiologist_metrics[Modality_Code] IN {"US","BD"},
			            radiologist_metrics[Outliers] = "Excluded"
			        ),
			    "Drafting + Capture",
			        CALCULATE(
			            SUM(radiologist_metrics[TotalTBWU]),
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            (
			                (radiologist_metrics[Is_Drafting_Row] = 1 && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                || (radiologist_metrics[Is_Capture_Row] = 1 && radiologist_metrics[Modality_Code] IN {"US","BD"})
			            ),
			            radiologist_metrics[Outliers] = "Excluded"
			        ),
			    -- Default
			    CALCULATE(
			        SUM(radiologist_metrics[TotalTBWU]),
			        radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        radiologist_metrics[Is_Mosaic_Row] = 1,
			        radiologist_metrics[Outliers] = "Excluded"
			    )
			)
		lineageTag: ab49168e-1fa8-4a97-aae7-bebcca1799ff

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Rad_Mosaic_TBWU_Opt =
			
			CALCULATE(
			    [mosaictbwu_opt],
			    ALLSELECTED(radiologist_metrics[Parent_Procedure_name])
			)
		lineageTag: af392563-29c8-483c-a4ae-ce7d83a9c7af

