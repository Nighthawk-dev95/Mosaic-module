	measure _Total_Baseline_Exam_Page_Opt = ```
			
			VAR _minExams = SELECTEDVALUE('Mosaic Min Exams'[MinExams], 1)
			VAR _view = SELECTEDVALUE('Readtimeview'[RT View], "All")
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			VAR _exclOutliers = SELECTEDVALUE('Outlier Selector'[Outlier View], "Excluded") = "Excluded"
			
			VAR _examMetrics = 
			    ADDCOLUMNS(
			        VALUES(radiologist_metrics[Parent_Procedure_name]),
			        "@Mosaic", CALCULATE([mosaicexams_opt], ALLSELECTED(radiologist_summary[Radiologist])),
			        "@Baseline", CALCULATE([baselineexams_opt], ALLSELECTED(radiologist_summary[Radiologist])),
			        "@BaseEff", CALCULATE([Exam_Weighted_Baseline_Opt]),
			        "@MosEff", CALCULATE([Exam_Weighted_Mosaic_Opt]),
			        "@Time", CALCULATE([Exam_Total_Time_Opt])
			    )
			
			VAR _qualified = 
			    FILTER(
			        _examMetrics,
			        [@Mosaic] >= _minExams &&
			        [@Baseline] > 0 &&
			        NOT ISBLANK([@BaseEff]) && [@BaseEff] > 0 &&
			        NOT ISBLANK([@MosEff]) &&
			        (_view = "All" || (_view = "Positive" && DIVIDE([@MosEff] - [@BaseEff], [@BaseEff]) > 0) || (_view = "Negative" && DIVIDE([@MosEff] - [@BaseEff], [@BaseEff]) < 0))
			    )
			
			RETURN DIVIDE(SUMX(_qualified, [@BaseEff] * [@Time]), SUMX(_qualified, [@Time]))
