	measure AllTime_Exams_Display_Opt = ```
			
			VAR IsProcedureLevel = ISINSCOPE(radiologist_metrics[Parent_Procedure_name])
			VAR IsRadiologistInScope = ISINSCOPE(radiologist_summary[Radiologist])
			VAR IsProcedureUnderRad = IsProcedureLevel && IsRadiologistInScope
			VAR IsRadiologistLevel = IsRadiologistInScope && NOT IsProcedureLevel
			VAR TeamCount = COUNTROWS(VALUES(radiologist_summary[Team]))
			VAR IsTeamLevel = NOT IsProcedureLevel && NOT IsRadiologistInScope && TeamCount = 1
			VAR IsActualTotalLevel = NOT IsProcedureLevel && NOT IsRadiologistInScope && TeamCount > 1
			
			VAR _radQualifies = [Rad_Qualifies_Opt] = 1
			VAR _examHasBoth = [Exam_Has_Both_Opt] = 1
			
			VAR _qualifiedRads = 
			    FILTER(
			        VALUES(radiologist_summary[Radiologist]),
			        CALCULATE([Rad_Qualifies_Opt]) = 1
			    )
			
			VAR _hasQualifyingRads = COUNTROWS(_qualifiedRads) > 0
			
			VAR _teamTotal = 
			    SUMX(
			        _qualifiedRads,
			        CALCULATE([Rad_AllTime_Mosaic_Exams_Opt])
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			    IsProcedureUnderRad, IF(_radQualifies && _examHasBoth, [Proc_AllTime_Mosaic_Exams_Opt], BLANK()),
			    IsRadiologistLevel, IF(_radQualifies, [Rad_AllTime_Mosaic_Exams_Opt], BLANK()),
			    IsTeamLevel, IF(_hasQualifyingRads, _teamTotal, BLANK()),
			    IsActualTotalLevel, IF(_hasQualifyingRads, _teamTotal, BLANK()),
			    IF(_hasQualifyingRads, _teamTotal, BLANK())
			)
			```
		formatString: 0
		lineageTag: dc920f9a-0606-47f8-b33b-6315c2245bfe

	measure Implied_RTS_Opt =
			
			VAR SelectedMetric = SELECTEDVALUE('Metric Selector1'[Metric])
			VAR _isApplicableMetric = (SelectedMetric = "Mean RVU/min" || SelectedMetric = "Mean TBWU/min")
			
			VAR IsProcedureLevel = ISINSCOPE(radiologist_metrics[Parent_Procedure_name])
			VAR IsRadiologistInScope = ISINSCOPE(radiologist_summary[Radiologist])
			
			VAR IsProcUnderRad = IsProcedureLevel && IsRadiologistInScope
			VAR IsRadLevel = IsRadiologistInScope && NOT IsProcedureLevel
			VAR IsTeamOrTotal = NOT IsProcedureLevel && NOT IsRadiologistInScope
			
			VAR _radQualifies = [Rad_Qualifies_Opt] = 1
			VAR _examHasBoth = [Exam_Has_Both_Opt] = 1
			
			// Procedure-specific
			VAR _procBaseline = [Base_Baseline_Eff_Opt]
			VAR _procMosaic = [Base_Mosaic_Eff_Opt]
			VAR _procImpliedRTS = DIVIDE(_procBaseline, _procMosaic) - 1
			
			// Radiologist-level
			VAR _radBaseline = [Rad_Weighted_Baseline_Opt]
			VAR _radMosaic = [Rad_Weighted_Mosaic_Opt]
			VAR _radImpliedRTS = DIVIDE(_radBaseline, _radMosaic) - 1
			
			// Team/Total level
			VAR _teamBaseline = [_Team_Weighted_Baseline_Opt]
			VAR _teamMosaic = [_Team_Weighted_Mosaic_Opt]
			VAR _teamImpliedRTS = DIVIDE(_teamBaseline, _teamMosaic) - 1
			
			RETURN
			IF(
			    NOT _isApplicableMetric, BLANK(),
			    IF(
			        IsProcUnderRad, IF(_radQualifies && _examHasBoth && _procMosaic <> 0, _procImpliedRTS, BLANK()),
			        IF(
			            IsRadLevel, IF(_radQualifies && _radMosaic <> 0, _radImpliedRTS, BLANK()),
			            IF(IsTeamOrTotal && _teamMosaic <> 0, _teamImpliedRTS, BLANK())
			        )
			    )
			)
		formatString: 0%;-0%;0%
		lineageTag: de3a9c4b-8aac-425a-b019-d5c2a3c2354b

	measure _Team_Implied_RTS_Opt = ```
			
			VAR SelectedMetric = SELECTEDVALUE('Metric Selector1'[Metric])
			VAR _isApplicableMetric = (SelectedMetric = "Mean RVU/min" || SelectedMetric = "Mean TBWU/min")
			VAR _minExams = SELECTEDVALUE('Mosaic Min Exams'[MinExams], 1)
			VAR _view = SELECTEDVALUE('Readtimeview'[RT View], "All")
			
			VAR _radMetrics = 
			    ADDCOLUMNS(
			        VALUES(radiologist_summary[Radiologist]),
			        "@RadExams", CALCULATE([Rad_Mosaic_Exams_Opt]),
			        "@RadBaseline", CALCULATE([Rad_Weighted_Baseline_Opt]),
			        "@RadMosaic", CALCULATE([Rad_Weighted_Mosaic_Opt]),
			        "@RadTime", CALCULATE([Base_Time_Mosaic_Opt], ALLSELECTED(radiologist_metrics[Parent_Procedure_name]))
			    )
			
			VAR _qualifiedRads = 
			    FILTER(
			        _radMetrics,
			        [@RadExams] >= _minExams &&
			        NOT ISBLANK([@RadBaseline]) && [@RadBaseline] > 0 &&
			        NOT ISBLANK([@RadMosaic]) &&
			        (
			            _view = "All" ||
			            (_view = "Positive" && DIVIDE([@RadMosaic] - [@RadBaseline], [@RadBaseline]) > 0) ||
			            (_view = "Negative" && DIVIDE([@RadMosaic] - [@RadBaseline], [@RadBaseline]) < 0)
			        )
			    )
			
			VAR _teamBaseline = DIVIDE(SUMX(_qualifiedRads, [@RadBaseline] * [@RadTime]), SUMX(_qualifiedRads, [@RadTime]))
			VAR _teamMosaic = DIVIDE(SUMX(_qualifiedRads, [@RadMosaic] * [@RadTime]), SUMX(_qualifiedRads, [@RadTime]))
			
			RETURN 
			IF(
			    _isApplicableMetric && NOT ISBLANK(_teamBaseline) && NOT ISBLANK(_teamMosaic) && _teamMosaic <> 0,
			    DIVIDE(_teamBaseline, _teamMosaic) - 1,
			    BLANK()
			)
			```
		lineageTag: f46f637c-0d74-415b-aff7-a09ecef709d3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _Team_Pct_Change_Opt =
			
			VAR _baseline = [_Team_Weighted_Baseline_Opt]
			VAR _mosaic = [_Team_Weighted_Mosaic_Opt]
			
			RETURN DIVIDE(_mosaic - _baseline, _baseline)
		lineageTag: 2bdbe8a5-afc4-453f-bd37-23bdbb6a984b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Exam_Total_Mosaic_Exams_Opt =
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			
			RETURN
			SWITCH(
			    _mode,
			    "Drafting Only",
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]),
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            radiologist_metrics[Is_Drafting_Row] = 1,
			            radiologist_metrics[Modality_Code] IN {"CR","CT"},
			            radiologist_metrics[Outliers] = "Excluded",
			            ALLSELECTED(radiologist_metrics[Radiologist])
			        ),
			    "Reporting Only",
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]),
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            radiologist_metrics[Is_Reporting_Row] = 1,
			            radiologist_metrics[Outliers] = "Excluded",
			            ALLSELECTED(radiologist_metrics[Radiologist])
			        ),
			    "Full Mosaic",
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]),
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            radiologist_metrics[Is_Mosaic_Row] = 1,
			            radiologist_metrics[Outliers] = "Excluded",
			            ALLSELECTED(radiologist_metrics[Radiologist])
			        ),
			    "Capture Only",
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]),
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            radiologist_metrics[Is_Capture_Row] = 1,
			            radiologist_metrics[Modality_Code] IN {"US","BD"},
			            radiologist_metrics[Outliers] = "Excluded",
			            ALLSELECTED(radiologist_metrics[Radiologist])
			        ),
			    "Drafting + Capture",
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]),
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            (
			                (radiologist_metrics[Is_Drafting_Row] = 1 && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                || (radiologist_metrics[Is_Capture_Row] = 1 && radiologist_metrics[Modality_Code] IN {"US","BD"})
			            ),
			            radiologist_metrics[Outliers] = "Excluded",
			            ALLSELECTED(radiologist_metrics[Radiologist])
			        ),
			    -- Default
			    CALCULATE(
			        SUM(radiologist_metrics[ExamCount]),
			        radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        radiologist_metrics[Is_Mosaic_Row] = 1,
			        radiologist_metrics[Outliers] = "Excluded",
			        ALLSELECTED(radiologist_metrics[Radiologist])
			    )
			)
		formatString: 0
		lineageTag: 1fa03c9f-209d-48cd-812e-bf77737016d3

