	measure Pct_Rads_Positive_By_Exam = ```
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			VAR _minExams = SELECTEDVALUE('Mosaic Min Exams'[MinExams], 1)
			VAR _isCaptureOnly = (_mode = "Capture Only")
			
			// All rads who meet the exam threshold
			VAR _qualifiedRads = 
			    FILTER(
			        VALUES(radiologist_metrics[Radiologist]),
			        VAR _examCountStandard = 
			            CALCULATE(
			                SUM(radiologist_metrics[ExamCount]),
			                radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                SWITCH(
			                    _mode,
			                    "Drafting Only", radiologist_metrics[Is_Drafting_Row] = 1,
			                    "Reporting Only", radiologist_metrics[Is_Reporting_Row] = 1,
			                    "Full Mosaic", radiologist_metrics[Is_Mosaic_Row] = 1,
			                    "Capture Only", radiologist_metrics[Is_Capture_Row] = 1,
			                    radiologist_metrics[Is_Mosaic_Row] = 1
			                ),
			                radiologist_metrics[Outliers] = "Excluded"
			            )
			        VAR _examCountCaptureOnly = 
			            CALCULATE(
			                SUM(radiologist_metrics[ExamCount]),
			                radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                radiologist_metrics[Is_Capture_Row] = 1,
			                radiologist_metrics[Outliers] = "Excluded",
			                radiologist_metrics[Modality_Code] IN {"US", "BD"}
			            )
			        VAR _examCount = IF(_isCaptureOnly, _examCountCaptureOnly, _examCountStandard)
			        RETURN _examCount >= _minExams
			    )
			
			// Rads with both metrics
			VAR _radsWithBoth = 
			    FILTER(
			        _qualifiedRads,
			        VAR _baseline = [Base_Baseline_Eff_Opt]
			        VAR _mosaic = [Base_Mosaic_Eff_Opt]
			        RETURN NOT ISBLANK(_baseline) && NOT ISBLANK(_mosaic)
			    )
			
			// Rads with positive improvement
			VAR _radsPositive = 
			    FILTER(
			        _radsWithBoth,
			        VAR _baseline = [Base_Baseline_Eff_Opt]
			        VAR _mosaic = [Base_Mosaic_Eff_Opt]
			        VAR _pctChange = DIVIDE(_mosaic - _baseline, _baseline)
			        RETURN _pctChange > 0
			    )
			
			VAR _totalRads = COUNTROWS(_radsWithBoth)
			VAR _positiveRads = COUNTROWS(_radsPositive)
			
			RETURN
			IF(_totalRads > 0, DIVIDE(_positiveRads, _totalRads), BLANK())
			```
		formatString: 0%;-0%;0%
		lineageTag: 4d210fa4-8991-4dcd-84ec-8617ed10895b

