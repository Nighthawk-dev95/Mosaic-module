			                    "Reporting Only", radiologist_metrics[Is_Reporting_Row] = 1,
			                    "Full Mosaic", radiologist_metrics[Is_Mosaic_Row] = 1,
			                    "Capture Only", radiologist_metrics[Is_Capture_Row] = 1,
			                    radiologist_metrics[Is_Mosaic_Row] = 1
			                ),
			                radiologist_metrics[Outliers] = "Excluded"
			            )
			        VAR _examCountCaptureOnly = 
			            CALCULATE(
			                SUM(radiologist_metrics[ExamCount]),
			                radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			                radiologist_metrics[Is_Capture_Row] = 1,
			                radiologist_metrics[Outliers] = "Excluded",
			                radiologist_metrics[Modality_Code] IN {"US", "BD"}
			            )
			        VAR _examCount = IF(_isCaptureOnly, _examCountCaptureOnly, _examCountStandard)
			        RETURN _examCount >= _minExams
			    )
			
			// Rads with positive improvement
			VAR _radsPositive = 
			    FILTER(
			        _qualifiedRads,
			        VAR _baseline = [Base_Baseline_Eff_Opt]
			        VAR _mosaic = [Base_Mosaic_Eff_Opt]
			        VAR _pctChange = DIVIDE(_mosaic - _baseline, _baseline)
			        RETURN NOT ISBLANK(_baseline) && NOT ISBLANK(_mosaic) && _pctChange > 0
			    )
			
			RETURN COUNTROWS(_radsPositive)
			```
		formatString: 0
		lineageTag: 14c1377e-c8f2-420e-b09a-d846c8cba00a

