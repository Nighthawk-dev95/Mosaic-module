	measure Mosaic_TBWU_Display_Opt =
			
			VAR IsProcedureLevel = ISINSCOPE(radiologist_metrics[Parent_Procedure_name])
			VAR IsRadiologistInScope = ISINSCOPE(radiologist_summary[Radiologist])
			
			VAR IsProcUnderRad = IsProcedureLevel && IsRadiologistInScope
			VAR IsRadLevel = IsRadiologistInScope && NOT IsProcedureLevel
			VAR IsTeamOrTotal = NOT IsProcedureLevel && NOT IsRadiologistInScope
			
			VAR _radQualifies = [Rad_Qualifies_Opt] = 1
			VAR _examHasBoth = [Exam_Has_Both_Opt] = 1
			
			RETURN
			IF(
			    IsProcUnderRad, IF(_radQualifies && _examHasBoth, [mosaictbwu_opt], BLANK()),
			    IF(
			        IsRadLevel, IF(_radQualifies, [Rad_Mosaic_TBWU_Opt], BLANK()),
			        IF(IsTeamOrTotal, [_Team_Mosaic_TBWU_Opt], BLANK())
			    )
			)
		formatString: 0
		lineageTag: 7087f68b-295a-4eb5-9bbf-ba8d5141f34e

		annotation PBI_FormatHint = {"isDecimal":true}

