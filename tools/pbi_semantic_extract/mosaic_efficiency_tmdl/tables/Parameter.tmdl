			                (_mode = "Full Mosaic" && radiologist_metrics[Is_Mosaic_Row] = 1) ||
			                (_mode = "Capture Only" && radiologist_metrics[Is_Capture_Row] = 1),
			                (_exclOutliers || radiologist_metrics[Outliers] = "Excluded"),
			                ALLSELECTED(radiologist_metrics[Radiologist])
			            ),
			        "@Baseline", CALCULATE([baselineexams_opt], ALLSELECTED(radiologist_metrics[Radiologist])),
			        "@BaseEff", CALCULATE([Exam_Weighted_Baseline_Opt]),
			        "@MosEff", CALCULATE([Exam_Weighted_Mosaic_Opt])
