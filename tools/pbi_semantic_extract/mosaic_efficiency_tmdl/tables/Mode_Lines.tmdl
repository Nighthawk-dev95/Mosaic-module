			VAR _mosaicEffCaptureOnly = DIVIDE(_totalTBWUCaptureOnly, _totalTimeCaptureOnly / 60)
			VAR _baselineEffCaptureOnly = DIVIDE(_totalBaselineContribCaptureOnly, _totalTimeCaptureOnly)
			VAR _effChangeCaptureOnly = DIVIDE(_mosaicEffCaptureOnly - _baselineEffCaptureOnly, _baselineEffCaptureOnly)
			
			// ===== RETURN BASED ON LINE =====
			RETURN
			SWITCH(
			    _modeLine,
			    "Drafting Only",      IF(_draftingVisible, _effChangeDrafting),
			    "Reporting Only",     _effChangeReporting,
			    "Full Mosaic",        _effChangeFullMosaic,
			    "Drafting + Capture", IF(_draftingCaptureVisible, _effChangeDraftingCapture),
			    "Capture Only",       IF(_captureVisible, _effChangeCaptureOnly),
			    BLANK()
			)
