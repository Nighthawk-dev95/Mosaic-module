table Mode_Lines
	lineageTag: d624a5ce-91a4-44ee-91f5-f6e5602dcc91

	measure Efficiency_Change_By_Mode_Line = ```
			
			VAR _modeLine = SELECTEDVALUE(Mode_Lines[ModeLine])
			VAR _minExams = SELECTEDVALUE('Mosaic Min Exams'[MinExams], 0)
			VAR _rtView = SELECTEDVALUE(Readtimeview[RT View], "All")
			VAR _draftingVisible =
			    COUNTROWS(FILTER(VALUES(radiologist_metrics[Modality_Code]), radiologist_metrics[Modality_Code] IN {"CR","CT"})) > 0
			VAR _captureVisible =
			    COUNTROWS(FILTER(VALUES(radiologist_metrics[Modality_Code]), radiologist_metrics[Modality_Code] IN {"US","BD"})) > 0
			VAR _draftingCaptureVisible =
			    COUNTROWS(FILTER(VALUES(radiologist_metrics[Modality_Code]), radiologist_metrics[Modality_Code] IN {"CR","CT","US","BD"})) > 0
			
			// ===== DRAFTING ONLY (CR + CT only) =====
			VAR _qualifyingRadsDrafting = 
			    FILTER(
			        CALCULATETABLE(
			            DISTINCT(radiologist_metrics[Radiologist]),
			            radiologist_metrics[Is_Drafting_Row] = 1,
			            KEEPFILTERS(radiologist_metrics[Modality_Code] IN {"CR","CT"}),
			            radiologist_metrics[Outliers] = "Excluded",
			            ALLSELECTED(radiologist_metrics[Exam_Date], radiologist_metrics[Beginning_of_Month], radiologist_metrics[Week_Date])
			        ),
			        VAR _currentRad = [Radiologist]
			        VAR _radExamsAllTime = 
			            CALCULATE(
			                SUM(radiologist_metrics[ExamCount]),
			                FILTER(ALL(radiologist_metrics),
			                    radiologist_metrics[Radiologist] = _currentRad &&
			                    radiologist_metrics[Is_Drafting_Row] = 1 &&
			                    radiologist_metrics[Modality_Code] IN {"CR","CT"} &&
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            )
			        VAR _radTBWUAllTime = 
			            CALCULATE(
			                SUM(radiologist_metrics[TotalTBWU]),
			                FILTER(ALL(radiologist_metrics),
			                    radiologist_metrics[Radiologist] = _currentRad &&
			                    radiologist_metrics[Is_Drafting_Row] = 1 &&
			                    radiologist_metrics[Modality_Code] IN {"CR","CT"} &&
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            )
			        VAR _radTimeAllTime = 
			            CALCULATE(
			                SUM(radiologist_metrics[TotalTime]),
			                FILTER(ALL(radiologist_metrics),
			                    radiologist_metrics[Radiologist] = _currentRad &&
			                    radiologist_metrics[Is_Drafting_Row] = 1 &&
			                    radiologist_metrics[Modality_Code] IN {"CR","CT"} &&
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            )
			        VAR _radMosaicEffAllTime = DIVIDE(_radTBWUAllTime, _radTimeAllTime / 60)
			        VAR _radBaselineContribAllTime = 
			            CALCULATE(
			                SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]),
			                FILTER(ALL(radiologist_metrics),
			                    radiologist_metrics[Radiologist] = _currentRad &&
			                    radiologist_metrics[Is_Drafting_Row] = 1 &&
			                    radiologist_metrics[Modality_Code] IN {"CR","CT"} &&
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            )
			        VAR _radBaselineEffAllTime = DIVIDE(_radBaselineContribAllTime, _radTimeAllTime)
			        VAR _pctChangeAllTime = DIVIDE(_radMosaicEffAllTime - _radBaselineEffAllTime, _radBaselineEffAllTime)
			        VAR _isPositive = _pctChangeAllTime > 0
			        VAR _isNegative = _pctChangeAllTime <= 0
			        VAR _hasBoth = NOT ISBLANK(_radMosaicEffAllTime) && NOT ISBLANK(_radBaselineEffAllTime)
			        VAR _passesRTFilter = 
			            SWITCH(_rtView,
			                "Positive", _hasBoth && _isPositive,
			                "Negative", _hasBoth && _isNegative,
			                _hasBoth)
			        RETURN _radExamsAllTime >= _minExams && _passesRTFilter
			    )
			
			VAR _totalTBWUDrafting = 
			    SUMX(_qualifyingRadsDrafting,
			        VAR _currentRad = [Radiologist]
			        RETURN CALCULATE(SUM(radiologist_metrics[TotalTBWU]),
			            radiologist_metrics[Radiologist] = _currentRad,
			            radiologist_metrics[Is_Drafting_Row] = 1,
			            KEEPFILTERS(radiologist_metrics[Modality_Code] IN {"CR","CT"}),
			            radiologist_metrics[Outliers] = "Excluded"))
			
			VAR _totalTimeDrafting = 
			    SUMX(_qualifyingRadsDrafting,
			        VAR _currentRad = [Radiologist]
			        RETURN CALCULATE(SUM(radiologist_metrics[TotalTime]),
			            radiologist_metrics[Radiologist] = _currentRad,
			            radiologist_metrics[Is_Drafting_Row] = 1,
			            KEEPFILTERS(radiologist_metrics[Modality_Code] IN {"CR","CT"}),
			            radiologist_metrics[Outliers] = "Excluded"))
			
			VAR _totalBaselineContribDrafting = 
			    SUMX(_qualifyingRadsDrafting,
			        VAR _currentRad = [Radiologist]
			        RETURN CALCULATE(SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]),
			            radiologist_metrics[Radiologist] = _currentRad,
			            radiologist_metrics[Is_Drafting_Row] = 1,
			            KEEPFILTERS(radiologist_metrics[Modality_Code] IN {"CR","CT"}),
			            radiologist_metrics[Outliers] = "Excluded"))
			
			VAR _mosaicEffDrafting = DIVIDE(_totalTBWUDrafting, _totalTimeDrafting / 60)
			VAR _baselineEffDrafting = DIVIDE(_totalBaselineContribDrafting, _totalTimeDrafting)
			VAR _effChangeDrafting = DIVIDE(_mosaicEffDrafting - _baselineEffDrafting, _baselineEffDrafting)
			
			// ===== REPORTING ONLY =====
			VAR _qualifyingRadsReporting = 
			    FILTER(
			        CALCULATETABLE(
			            DISTINCT(radiologist_metrics[Radiologist]),
			            radiologist_metrics[Is_Reporting_Row] = 1,
			            radiologist_metrics[Outliers] = "Excluded",
			            ALLSELECTED(radiologist_metrics[Exam_Date], radiologist_metrics[Beginning_of_Month], radiologist_metrics[Week_Date])
			        ),
			        VAR _currentRad = [Radiologist]
			        VAR _radExamsAllTime = 
			            CALCULATE(SUM(radiologist_metrics[ExamCount]),
			                FILTER(ALL(radiologist_metrics),
			                    radiologist_metrics[Radiologist] = _currentRad &&
			                    radiologist_metrics[Is_Reporting_Row] = 1 &&
			                    radiologist_metrics[Outliers] = "Excluded"))
			        VAR _radTBWUAllTime = 
			            CALCULATE(SUM(radiologist_metrics[TotalTBWU]),
			                FILTER(ALL(radiologist_metrics),
			                    radiologist_metrics[Radiologist] = _currentRad &&
			                    radiologist_metrics[Is_Reporting_Row] = 1 &&
			                    radiologist_metrics[Outliers] = "Excluded"))
			        VAR _radTimeAllTime = 
			            CALCULATE(SUM(radiologist_metrics[TotalTime]),
			                FILTER(ALL(radiologist_metrics),
			                    radiologist_metrics[Radiologist] = _currentRad &&
			                    radiologist_metrics[Is_Reporting_Row] = 1 &&
			                    radiologist_metrics[Outliers] = "Excluded"))
			        VAR _radMosaicEffAllTime = DIVIDE(_radTBWUAllTime, _radTimeAllTime / 60)
			        VAR _radBaselineContribAllTime = 
			            CALCULATE(SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]),
			                FILTER(ALL(radiologist_metrics),
			                    radiologist_metrics[Radiologist] = _currentRad &&
			                    radiologist_metrics[Is_Reporting_Row] = 1 &&
			                    radiologist_metrics[Outliers] = "Excluded"))
			        VAR _radBaselineEffAllTime = DIVIDE(_radBaselineContribAllTime, _radTimeAllTime)
			        VAR _pctChangeAllTime = DIVIDE(_radMosaicEffAllTime - _radBaselineEffAllTime, _radBaselineEffAllTime)
			        VAR _isPositive = _pctChangeAllTime > 0
			        VAR _isNegative = _pctChangeAllTime <= 0
			        VAR _hasBoth = NOT ISBLANK(_radMosaicEffAllTime) && NOT ISBLANK(_radBaselineEffAllTime)
			        VAR _passesRTFilter = 
			            SWITCH(_rtView,
			                "Positive", _hasBoth && _isPositive,
			                "Negative", _hasBoth && _isNegative,
			                _hasBoth)
			        RETURN _radExamsAllTime >= _minExams && _passesRTFilter
			    )
			
			VAR _totalTBWUReporting = 
			    SUMX(_qualifyingRadsReporting,
			        VAR _currentRad = [Radiologist]
			        RETURN CALCULATE(SUM(radiologist_metrics[TotalTBWU]),
			            radiologist_metrics[Radiologist] = _currentRad,
			            radiologist_metrics[Is_Reporting_Row] = 1,
			            radiologist_metrics[Outliers] = "Excluded"))
			
			VAR _totalTimeReporting = 
			    SUMX(_qualifyingRadsReporting,
			        VAR _currentRad = [Radiologist]
			        RETURN CALCULATE(SUM(radiologist_metrics[TotalTime]),
			            radiologist_metrics[Radiologist] = _currentRad,
			            radiologist_metrics[Is_Reporting_Row] = 1,
			            radiologist_metrics[Outliers] = "Excluded"))
			
			VAR _totalBaselineContribReporting = 
			    SUMX(_qualifyingRadsReporting,
			        VAR _currentRad = [Radiologist]
			        RETURN CALCULATE(SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]),
			            radiologist_metrics[Radiologist] = _currentRad,
			            radiologist_metrics[Is_Reporting_Row] = 1,
			            radiologist_metrics[Outliers] = "Excluded"))
			
			VAR _mosaicEffReporting = DIVIDE(_totalTBWUReporting, _totalTimeReporting / 60)
			VAR _baselineEffReporting = DIVIDE(_totalBaselineContribReporting, _totalTimeReporting)
			VAR _effChangeReporting = DIVIDE(_mosaicEffReporting - _baselineEffReporting, _baselineEffReporting)
			
			// ===== FULL MOSAIC =====
			VAR _qualifyingRadsFullMosaic = 
			    FILTER(
			        CALCULATETABLE(
			            DISTINCT(radiologist_metrics[Radiologist]),
			            radiologist_metrics[Is_Mosaic_Row] = 1,
			            radiologist_metrics[Outliers] = "Excluded",
			            ALLSELECTED(radiologist_metrics[Exam_Date], radiologist_metrics[Beginning_of_Month], radiologist_metrics[Week_Date])
			        ),
			        VAR _currentRad = [Radiologist]
			        VAR _radExamsAllTime = 
			            CALCULATE(SUM(radiologist_metrics[ExamCount]),
			                FILTER(ALL(radiologist_metrics),
			                    radiologist_metrics[Radiologist] = _currentRad &&
			                    radiologist_metrics[Is_Mosaic_Row] = 1 &&
			                    radiologist_metrics[Outliers] = "Excluded"))
			        VAR _radTBWUAllTime = 
			            CALCULATE(SUM(radiologist_metrics[TotalTBWU]),
			                FILTER(ALL(radiologist_metrics),
			                    radiologist_metrics[Radiologist] = _currentRad &&
			                    radiologist_metrics[Is_Mosaic_Row] = 1 &&
			                    radiologist_metrics[Outliers] = "Excluded"))
			        VAR _radTimeAllTime = 
			            CALCULATE(SUM(radiologist_metrics[TotalTime]),
			                FILTER(ALL(radiologist_metrics),
			                    radiologist_metrics[Radiologist] = _currentRad &&
			                    radiologist_metrics[Is_Mosaic_Row] = 1 &&
			                    radiologist_metrics[Outliers] = "Excluded"))
			        VAR _radMosaicEffAllTime = DIVIDE(_radTBWUAllTime, _radTimeAllTime / 60)
			        VAR _radBaselineContribAllTime = 
			            CALCULATE(SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]),
			                FILTER(ALL(radiologist_metrics),
			                    radiologist_metrics[Radiologist] = _currentRad &&
			                    radiologist_metrics[Is_Mosaic_Row] = 1 &&
			                    radiologist_metrics[Outliers] = "Excluded"))
			        VAR _radBaselineEffAllTime = DIVIDE(_radBaselineContribAllTime, _radTimeAllTime)
			        VAR _pctChangeAllTime = DIVIDE(_radMosaicEffAllTime - _radBaselineEffAllTime, _radBaselineEffAllTime)
			        VAR _isPositive = _pctChangeAllTime > 0
			        VAR _isNegative = _pctChangeAllTime <= 0
			        VAR _hasBoth = NOT ISBLANK(_radMosaicEffAllTime) && NOT ISBLANK(_radBaselineEffAllTime)
			        VAR _passesRTFilter = 
			            SWITCH(_rtView,
			                "Positive", _hasBoth && _isPositive,
			                "Negative", _hasBoth && _isNegative,
			                _hasBoth)
			        RETURN _radExamsAllTime >= _minExams && _passesRTFilter
			    )
			
			VAR _totalTBWUFullMosaic = 
			    SUMX(_qualifyingRadsFullMosaic,
			        VAR _currentRad = [Radiologist]
			        RETURN CALCULATE(SUM(radiologist_metrics[TotalTBWU]),
			            radiologist_metrics[Radiologist] = _currentRad,
			            radiologist_metrics[Is_Mosaic_Row] = 1,
			            radiologist_metrics[Outliers] = "Excluded"))
			
			VAR _totalTimeFullMosaic = 
			    SUMX(_qualifyingRadsFullMosaic,
			        VAR _currentRad = [Radiologist]
			        RETURN CALCULATE(SUM(radiologist_metrics[TotalTime]),
			            radiologist_metrics[Radiologist] = _currentRad,
			            radiologist_metrics[Is_Mosaic_Row] = 1,
			            radiologist_metrics[Outliers] = "Excluded"))
			
			VAR _totalBaselineContribFullMosaic = 
			    SUMX(_qualifyingRadsFullMosaic,
			        VAR _currentRad = [Radiologist]
			        RETURN CALCULATE(SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]),
			            radiologist_metrics[Radiologist] = _currentRad,
			            radiologist_metrics[Is_Mosaic_Row] = 1,
			            radiologist_metrics[Outliers] = "Excluded"))
			
			VAR _mosaicEffFullMosaic = DIVIDE(_totalTBWUFullMosaic, _totalTimeFullMosaic / 60)
			VAR _baselineEffFullMosaic = DIVIDE(_totalBaselineContribFullMosaic, _totalTimeFullMosaic)
			VAR _effChangeFullMosaic = DIVIDE(_mosaicEffFullMosaic - _baselineEffFullMosaic, _baselineEffFullMosaic)
			
			// ===== DRAFTING + CAPTURE (CR, CT, US, BD) =====
			VAR _qualifyingRadsDraftingCapture = 
			    FILTER(
			        CALCULATETABLE(
			            DISTINCT(radiologist_metrics[Radiologist]),
			            KEEPFILTERS(
			                (radiologist_metrics[Is_Drafting_Row] = 1
			                    && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                || (radiologist_metrics[Is_Capture_Row] = 1
			                    && radiologist_metrics[Modality_Code] IN {"US","BD"})
			            ),
			            radiologist_metrics[Outliers] = "Excluded",
			            ALLSELECTED(radiologist_metrics[Exam_Date], radiologist_metrics[Beginning_of_Month], radiologist_metrics[Week_Date])
			        ),
			        VAR _currentRad = [Radiologist]
			        VAR _radExamsAllTime = 
			            CALCULATE(SUM(radiologist_metrics[ExamCount]),
			                FILTER(ALL(radiologist_metrics),
			                    radiologist_metrics[Radiologist] = _currentRad &&
			                    (
			                        (radiologist_metrics[Is_Drafting_Row] = 1
			                            && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                        || (radiologist_metrics[Is_Capture_Row] = 1
			                            && radiologist_metrics[Modality_Code] IN {"US","BD"})
			                    ) &&
			                    radiologist_metrics[Outliers] = "Excluded"))
			        VAR _radTBWUAllTime = 
			            CALCULATE(SUM(radiologist_metrics[TotalTBWU]),
			                FILTER(ALL(radiologist_metrics),
			                    radiologist_metrics[Radiologist] = _currentRad &&
			                    (
			                        (radiologist_metrics[Is_Drafting_Row] = 1
			                            && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                        || (radiologist_metrics[Is_Capture_Row] = 1
			                            && radiologist_metrics[Modality_Code] IN {"US","BD"})
			                    ) &&
			                    radiologist_metrics[Outliers] = "Excluded"))
			        VAR _radTimeAllTime = 
			            CALCULATE(SUM(radiologist_metrics[TotalTime]),
			                FILTER(ALL(radiologist_metrics),
			                    radiologist_metrics[Radiologist] = _currentRad &&
			                    (
			                        (radiologist_metrics[Is_Drafting_Row] = 1
			                            && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                        || (radiologist_metrics[Is_Capture_Row] = 1
			                            && radiologist_metrics[Modality_Code] IN {"US","BD"})
			                    ) &&
			                    radiologist_metrics[Outliers] = "Excluded"))
			        VAR _radMosaicEffAllTime = DIVIDE(_radTBWUAllTime, _radTimeAllTime / 60)
			        VAR _radBaselineContribAllTime = 
			            CALCULATE(SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]),
			                FILTER(ALL(radiologist_metrics),
			                    radiologist_metrics[Radiologist] = _currentRad &&
			                    (
			                        (radiologist_metrics[Is_Drafting_Row] = 1
			                            && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                        || (radiologist_metrics[Is_Capture_Row] = 1
			                            && radiologist_metrics[Modality_Code] IN {"US","BD"})
			                    ) &&
			                    radiologist_metrics[Outliers] = "Excluded"))
			        VAR _radBaselineEffAllTime = DIVIDE(_radBaselineContribAllTime, _radTimeAllTime)
			        VAR _pctChangeAllTime = DIVIDE(_radMosaicEffAllTime - _radBaselineEffAllTime, _radBaselineEffAllTime)
			        VAR _isPositive = _pctChangeAllTime > 0
			        VAR _isNegative = _pctChangeAllTime <= 0
			        VAR _hasBoth = NOT ISBLANK(_radMosaicEffAllTime) && NOT ISBLANK(_radBaselineEffAllTime)
			        VAR _passesRTFilter = 
			            SWITCH(_rtView,
			                "Positive", _hasBoth && _isPositive,
			                "Negative", _hasBoth && _isNegative,
			                _hasBoth)
			        RETURN _radExamsAllTime >= _minExams && _passesRTFilter
			    )
			
			VAR _totalTBWUDraftingCapture = 
			    SUMX(_qualifyingRadsDraftingCapture,
			        VAR _currentRad = [Radiologist]
			        RETURN CALCULATE(SUM(radiologist_metrics[TotalTBWU]),
			            radiologist_metrics[Radiologist] = _currentRad,
			            KEEPFILTERS(
			                (radiologist_metrics[Is_Drafting_Row] = 1
			                    && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                || (radiologist_metrics[Is_Capture_Row] = 1
			                    && radiologist_metrics[Modality_Code] IN {"US","BD"})
			            ),
			            radiologist_metrics[Outliers] = "Excluded"))
			
			VAR _totalTimeDraftingCapture = 
			    SUMX(_qualifyingRadsDraftingCapture,
			        VAR _currentRad = [Radiologist]
			        RETURN CALCULATE(SUM(radiologist_metrics[TotalTime]),
			            radiologist_metrics[Radiologist] = _currentRad,
			            KEEPFILTERS(
			                (radiologist_metrics[Is_Drafting_Row] = 1
			                    && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                || (radiologist_metrics[Is_Capture_Row] = 1
			                    && radiologist_metrics[Modality_Code] IN {"US","BD"})
			            ),
			            radiologist_metrics[Outliers] = "Excluded"))
			
			VAR _totalBaselineContribDraftingCapture = 
			    SUMX(_qualifyingRadsDraftingCapture,
			        VAR _currentRad = [Radiologist]
			        RETURN CALCULATE(SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]),
			            radiologist_metrics[Radiologist] = _currentRad,
			            KEEPFILTERS(
			                (radiologist_metrics[Is_Drafting_Row] = 1
			                    && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                || (radiologist_metrics[Is_Capture_Row] = 1
			                    && radiologist_metrics[Modality_Code] IN {"US","BD"})
			            ),
			            radiologist_metrics[Outliers] = "Excluded"))
			
			VAR _mosaicEffDraftingCapture = DIVIDE(_totalTBWUDraftingCapture, _totalTimeDraftingCapture / 60)
			VAR _baselineEffDraftingCapture = DIVIDE(_totalBaselineContribDraftingCapture, _totalTimeDraftingCapture)
			VAR _effChangeDraftingCapture = DIVIDE(_mosaicEffDraftingCapture - _baselineEffDraftingCapture, _baselineEffDraftingCapture)
			
			// ===== CAPTURE ONLY (US + BD) =====
			VAR _qualifyingRadsCaptureOnly = 
			    FILTER(
			        CALCULATETABLE(
