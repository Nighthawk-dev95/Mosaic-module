	partition Case_Buckets = calculated
		mode: import
		source = ```
				
				DATATABLE(
				    "Bucket", STRING,
				    "BucketOrder", INTEGER,
				    "MinExams", INTEGER,
				    "MaxExams", INTEGER,
				    {
				        {"0-200", 1, 0, 200},
				        {"201-400", 2, 201, 400},
				        {"401-600", 3, 401, 600},
				        {"601-1000", 4, 601, 1000}, 
				   
				        {"1001+", 5, 1001, 999999}
				    }
				)
				```

