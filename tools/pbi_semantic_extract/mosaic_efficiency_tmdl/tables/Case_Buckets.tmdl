	measure Pct_Rads_Positive_Monthly =
			
			DIVIDE(
			    [Count_Rads_Positive_Monthly],
			    [Count_Rads_With_Both_Monthly]
			)
		formatString: 0%;-0%;0%
		lineageTag: e33466ec-fcf4-490f-8f2c-f9ccee3917b1

