table Case_Buckets
	lineageTag: d00713d1-0647-4d62-a57f-f2cca2ac6bb0

	measure Rad_Monthly_Exams = ```
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			
			VAR _exams = 
			    CALCULATE(
			        SUM(radiologist_metrics[ExamCount]),
			        radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        SWITCH(
			            _mode,
			            "Drafting Only", radiologist_metrics[Is_Drafting_Row] = 1,
			            "Reporting Only", radiologist_metrics[Is_Reporting_Row] = 1,
			            "Full Mosaic", radiologist_metrics[Is_Mosaic_Row] = 1,
			            "Capture Only", radiologist_metrics[Is_Capture_Row] = 1,
			            radiologist_metrics[Is_Mosaic_Row] = 1
			        ),
			        radiologist_metrics[Outliers] = "Excluded"
			    )
			
			VAR _examsCaptureOnly = 
			    CALCULATE(
			        SUM(radiologist_metrics[ExamCount]),
			        radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        radiologist_metrics[Is_Capture_Row] = 1,
			        radiologist_metrics[Outliers] = "Excluded",
			        radiologist_metrics[Modality_Code] IN {"US", "BD"}
			    )
			
			RETURN
			IF(_mode = "Capture Only", _examsCaptureOnly, _exams)
			```
		formatString: 0
		lineageTag: dd82655c-35e7-4fdb-8fe9-d9351cb80436

	measure Count_Rads_In_Bucket = ```
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			VAR _minBucket = SELECTEDVALUE(Case_Buckets[MinExams], 0)
			VAR _maxBucket = SELECTEDVALUE(Case_Buckets[MaxExams], 999999)
			
			// Calculate result for each mode separately
			VAR _resultCaptureOnly = 
			    COUNTROWS(
			        FILTER(
			            CALCULATETABLE(
			                DISTINCT(radiologist_metrics[Radiologist]),
			                radiologist_metrics[Is_Capture_Row] = 1,
			                radiologist_metrics[Outliers] = "Excluded",
			                radiologist_metrics[Modality_Code] IN {"US", "BD"}
			            ),
			            VAR _currentRad = [Radiologist]
			            VAR _exams = 
			                CALCULATE(
			                    SUM(radiologist_metrics[ExamCount]),
			                    radiologist_metrics[Radiologist] = _currentRad,
			                    radiologist_metrics[Is_Capture_Row] = 1,
			                    radiologist_metrics[Outliers] = "Excluded",
			                    radiologist_metrics[Modality_Code] IN {"US", "BD"}
			                )
			            RETURN _exams >= _minBucket && _exams <= _maxBucket
			        )
			    )
			
			VAR _resultDraftingOnly = 
			    COUNTROWS(
			        FILTER(
			            CALCULATETABLE(
			                DISTINCT(radiologist_metrics[Radiologist]),
			                radiologist_metrics[Is_Drafting_Row] = 1,
			                radiologist_metrics[Outliers] = "Excluded"
			            ),
			            VAR _currentRad = [Radiologist]
			            VAR _exams = 
			                CALCULATE(
			                    SUM(radiologist_metrics[ExamCount]),
			                    radiologist_metrics[Radiologist] = _currentRad,
			                    radiologist_metrics[Is_Drafting_Row] = 1,
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            RETURN _exams >= _minBucket && _exams <= _maxBucket
			        )
			    )
			
			VAR _resultReportingOnly = 
			    COUNTROWS(
			        FILTER(
			            CALCULATETABLE(
			                DISTINCT(radiologist_metrics[Radiologist]),
			                radiologist_metrics[Is_Reporting_Row] = 1,
			                radiologist_metrics[Outliers] = "Excluded"
			            ),
			            VAR _currentRad = [Radiologist]
			            VAR _exams = 
			                CALCULATE(
			                    SUM(radiologist_metrics[ExamCount]),
			                    radiologist_metrics[Radiologist] = _currentRad,
			                    radiologist_metrics[Is_Reporting_Row] = 1,
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            RETURN _exams >= _minBucket && _exams <= _maxBucket
			        )
			    )
			
			VAR _resultFullMosaic = 
			    COUNTROWS(
			        FILTER(
			            CALCULATETABLE(
			                DISTINCT(radiologist_metrics[Radiologist]),
			                radiologist_metrics[Is_Mosaic_Row] = 1,
			                radiologist_metrics[Outliers] = "Excluded"
			            ),
			            VAR _currentRad = [Radiologist]
			            VAR _exams = 
			                CALCULATE(
			                    SUM(radiologist_metrics[ExamCount]),
			                    radiologist_metrics[Radiologist] = _currentRad,
			                    radiologist_metrics[Is_Mosaic_Row] = 1,
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            RETURN _exams >= 1 && _exams >= _minBucket && _exams <= _maxBucket
			        )
			    )
			
			RETURN
			SWITCH(
			    _mode,
			    "Capture Only", _resultCaptureOnly,
			    "Drafting Only", _resultDraftingOnly,
			    "Reporting Only", _resultReportingOnly,
			    _resultFullMosaic
			)
			```
		formatString: 0
		lineageTag: 61f60d5d-d1b5-4f73-bd4c-1b0c8646a68f

	measure Count_Rads_With_Both_Monthly = ```
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			
			-- Capture Only (unchanged)
			VAR _resultCaptureOnly = 
			    COUNTROWS(
			        FILTER(
			            CALCULATETABLE(
			                DISTINCT(radiologist_metrics[Radiologist]),
			                radiologist_metrics[Is_Capture_Row] = 1,
			                radiologist_metrics[Outliers] = "Excluded",
			                radiologist_metrics[Modality_Code] IN {"US","BD"}
			            ),
			            VAR _currentRad = [Radiologist]
			            VAR _mosaicEff = 
			                CALCULATE(
			                    DIVIDE(SUM(radiologist_metrics[TotalTBWU]), SUM(radiologist_metrics[TotalTime]) / 60),
			                    radiologist_metrics[Radiologist] = _currentRad,
			                    radiologist_metrics[Is_Capture_Row] = 1,
			                    radiologist_metrics[Outliers] = "Excluded",
			                    radiologist_metrics[Modality_Code] IN {"US","BD"}
			                )
			            VAR _baselineEff = 
			                CALCULATE(
			                    DIVIDE(SUM(radiologist_metrics[Weighted_Baseline_USBD_Contrib_Excl]), SUM(radiologist_metrics[TotalTime])),
			                    radiologist_metrics[Radiologist] = _currentRad,
			                    radiologist_metrics[Is_Capture_Row] = 1,
			                    radiologist_metrics[Outliers] = "Excluded",
			                    radiologist_metrics[Modality_Code] IN {"US","BD"}
			                )
			            RETURN NOT ISBLANK(_mosaicEff) && NOT ISBLANK(_baselineEff)
			        )
			    )
			
			-- Drafting Only (CR + CT only)
			VAR _resultDraftingOnly = 
			    COUNTROWS(
			        FILTER(
			            CALCULATETABLE(
			                DISTINCT(radiologist_metrics[Radiologist]),
			                radiologist_metrics[Is_Drafting_Row] = 1,
			                radiologist_metrics[Modality_Code] IN {"CR","CT"},
			                radiologist_metrics[Outliers] = "Excluded"
			            ),
			            VAR _currentRad = [Radiologist]
			            VAR _mosaicEff = 
			                CALCULATE(
			                    DIVIDE(SUM(radiologist_metrics[TotalTBWU]), SUM(radiologist_metrics[TotalTime]) / 60),
			                    radiologist_metrics[Radiologist] = _currentRad,
			                    radiologist_metrics[Is_Drafting_Row] = 1,
			                    radiologist_metrics[Modality_Code] IN {"CR","CT"},
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            VAR _baselineEff = 
			                CALCULATE(
			                    DIVIDE(SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]), SUM(radiologist_metrics[TotalTime])),
			                    radiologist_metrics[Radiologist] = _currentRad,
			                    radiologist_metrics[Is_Drafting_Row] = 1,
			                    radiologist_metrics[Modality_Code] IN {"CR","CT"},
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            RETURN NOT ISBLANK(_mosaicEff) && NOT ISBLANK(_baselineEff)
			        )
			    )
			
			-- Reporting Only (unchanged)
			VAR _resultReportingOnly = 
			    COUNTROWS(
			        FILTER(
			            CALCULATETABLE(
			                DISTINCT(radiologist_metrics[Radiologist]),
			                radiologist_metrics[Is_Reporting_Row] = 1,
			                radiologist_metrics[Outliers] = "Excluded"
			            ),
			            VAR _currentRad = [Radiologist]
			            VAR _mosaicEff = 
			                CALCULATE(
			                    DIVIDE(SUM(radiologist_metrics[TotalTBWU]), SUM(radiologist_metrics[TotalTime]) / 60),
			                    radiologist_metrics[Radiologist] = _currentRad,
			                    radiologist_metrics[Is_Reporting_Row] = 1,
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            VAR _baselineEff = 
			                CALCULATE(
			                    DIVIDE(SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]), SUM(radiologist_metrics[TotalTime])),
			                    radiologist_metrics[Radiologist] = _currentRad,
			                    radiologist_metrics[Is_Reporting_Row] = 1,
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            RETURN NOT ISBLANK(_mosaicEff) && NOT ISBLANK(_baselineEff)
			        )
			    )
			
			-- Full Mosaic (unchanged)
			VAR _resultFullMosaic = 
			    COUNTROWS(
			        FILTER(
			            CALCULATETABLE(
			                DISTINCT(radiologist_metrics[Radiologist]),
			                radiologist_metrics[Is_Mosaic_Row] = 1,
			                radiologist_metrics[Outliers] = "Excluded"
			            ),
			            VAR _currentRad = [Radiologist]
			            VAR _mosaicEff = 
			                CALCULATE(
			                    DIVIDE(SUM(radiologist_metrics[TotalTBWU]), SUM(radiologist_metrics[TotalTime]) / 60),
			                    radiologist_metrics[Radiologist] = _currentRad,
			                    radiologist_metrics[Is_Mosaic_Row] = 1,
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            VAR _baselineEff = 
			                CALCULATE(
			                    DIVIDE(SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]), SUM(radiologist_metrics[TotalTime])),
			                    radiologist_metrics[Radiologist] = _currentRad,
			                    radiologist_metrics[Is_Mosaic_Row] = 1,
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            RETURN NOT ISBLANK(_mosaicEff) && NOT ISBLANK(_baselineEff)
			        )
			    )
			
			-- Drafting + Capture (new)
			VAR _resultDraftingCapture = 
			    COUNTROWS(
			        FILTER(
			            CALCULATETABLE(
			                DISTINCT(radiologist_metrics[Radiologist]),
			                (
			                    (radiologist_metrics[Is_Drafting_Row] = 1
			                        && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                    || (radiologist_metrics[Is_Capture_Row] = 1
			                        && radiologist_metrics[Modality_Code] IN {"US","BD"})
			                ),
			                radiologist_metrics[Outliers] = "Excluded"
			            ),
			            VAR _currentRad = [Radiologist]
			            VAR _mosaicEff = 
			                CALCULATE(
			                    DIVIDE(SUM(radiologist_metrics[TotalTBWU]), SUM(radiologist_metrics[TotalTime]) / 60),
			                    radiologist_metrics[Radiologist] = _currentRad,
			                    (
			                        (radiologist_metrics[Is_Drafting_Row] = 1
			                            && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                        || (radiologist_metrics[Is_Capture_Row] = 1
			                            && radiologist_metrics[Modality_Code] IN {"US","BD"})
			                    ),
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            VAR _baselineEff = 
			                CALCULATE(
			                    DIVIDE(SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]), SUM(radiologist_metrics[TotalTime])),
			                    radiologist_metrics[Radiologist] = _currentRad,
			                    (
			                        (radiologist_metrics[Is_Drafting_Row] = 1
			                            && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                        || (radiologist_metrics[Is_Capture_Row] = 1
			                            && radiologist_metrics[Modality_Code] IN {"US","BD"})
			                    ),
			                    radiologist_metrics[Outliers] = "Excluded"
			                )
			            RETURN NOT ISBLANK(_mosaicEff) && NOT ISBLANK(_baselineEff)
			        )
			    )
			
			RETURN
			SWITCH(
			    _mode,
			    "Capture Only",       _resultCaptureOnly,
			    "Drafting Only",      _resultDraftingOnly,
			    "Reporting Only",     _resultReportingOnly,
			    "Drafting + Capture", _resultDraftingCapture,
			    _resultFullMosaic
			)
			```
		formatString: 0
		lineageTag: 0333be77-6f69-4579-b555-e0dbf66ebf8f

	measure Count_Rads_Positive_Monthly = ```
			
			VAR _mode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			
			-- Capture Only (unchanged)
			VAR _resultCaptureOnly = 
			    COUNTROWS(
			        FILTER(
			            CALCULATETABLE(
			                DISTINCT(radiologist_metrics[Radiologist]),
			                radiologist_metrics[Is_Capture_Row] = 1,
			                radiologist_metrics[Outliers] = "Excluded",
			                radiologist_metrics[Modality_Code] IN {"US","BD"}
			            ),
			            VAR _currentRad = [Radiologist]
			            VAR _mosaicEff = 
			                CALCULATE(
			                    DIVIDE(SUM(radiologist_metrics[TotalTBWU]), SUM(radiologist_metrics[TotalTime]) / 60),
			                    radiologist_metrics[Radiologist] = _currentRad,
			                    radiologist_metrics[Is_Capture_Row] = 1,
			                    radiologist_metrics[Outliers] = "Excluded",
			                    radiologist_metrics[Modality_Code] IN {"US","BD"}
			                )
			            VAR _baselineEff = 
			                CALCULATE(
			                    DIVIDE(SUM(radiologist_metrics[Weighted_Baseline_USBD_Contrib_Excl]), SUM(radiologist_metrics[TotalTime])),
			                    radiologist_metrics[Radiologist] = _currentRad,
			                    radiologist_metrics[Is_Capture_Row] = 1,
			                    radiologist_metrics[Outliers] = "Excluded",
			                    radiologist_metrics[Modality_Code] IN {"US","BD"}
			                )
			            VAR _pctChange = DIVIDE(_mosaicEff - _baselineEff, _baselineEff)
			            RETURN NOT ISBLANK(_mosaicEff) && NOT ISBLANK(_baselineEff) && _pctChange > 0
			        )
			    )
			
			-- Drafting Only (CR + CT only)
			VAR _resultDraftingOnly = 
			    COUNTROWS(
			        FILTER(
			            CALCULATETABLE(
			                DISTINCT(radiologist_metrics[Radiologist]),
