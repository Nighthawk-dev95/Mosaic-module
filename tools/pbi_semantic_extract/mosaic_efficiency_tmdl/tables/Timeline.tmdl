	measure 'Reporting TBWU per Min TS' = ```
			
			VAR SelectedVRA = SELECTEDVALUE('Mosaic VRA Slicer'[VRA_Mosaic])
			
			VAR TotalTBWU = 
			    IF(
			        ISBLANK(SelectedVRA),
			        CALCULATE(
			            SUM(radiologist_metrics[TotalTBWU]),
			            radiologist_metrics[Period_Type] = "Reporting",
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date])
			        ),
			        CALCULATE(
			            SUM(radiologist_metrics[TotalTBWU]),
			            radiologist_metrics[Period_Type] = "Reporting",
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            radiologist_metrics[vra_assisted_flag] = SelectedVRA
			        )
			    )
			
			VAR TotalTime = 
			    IF(
			        ISBLANK(SelectedVRA),
			        CALCULATE(
			            SUM(radiologist_metrics[TotalTime]),
			            radiologist_metrics[Period_Type] = "Reporting",
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date])
			        ),
			        CALCULATE(
			            SUM(radiologist_metrics[TotalTime]),
			            radiologist_metrics[Period_Type] = "Reporting",
			            radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			            radiologist_metrics[vra_assisted_flag] = SelectedVRA
			        )
			    )
			
			RETURN
			DIVIDE(TotalTBWU, TotalTime / 60)
			```
