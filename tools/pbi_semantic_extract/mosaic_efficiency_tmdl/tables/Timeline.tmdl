			                (
			                    (radiologist_metrics[Is_Drafting_Row] = 1
			                        && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                    || (radiologist_metrics[Is_Capture_Row] = 1
			                        && radiologist_metrics[Modality_Code] IN {"US","BD"})
			                ),
			            radiologist_metrics[Is_Mosaic_Row] = 1
			        ),
			        IF(
			            _outlierView = "Excluded",
			            radiologist_metrics[Outliers] = "Excluded",
			            TRUE()
			        )
			    )
			
			VAR _baselineRaw =
			    CALCULATE(
			        SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]),
			        radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        SWITCH(
			            _mode,
			            "Drafting Only",
			                radiologist_metrics[Is_Drafting_Row] = 1
			                    && radiologist_metrics[Modality_Code] IN {"CR","CT"},
			            "Reporting Only",
			                radiologist_metrics[Is_Reporting_Row] = 1,
			            "Capture Only",
			                radiologist_metrics[Is_Capture_Row] = 1
			                    && radiologist_metrics[Modality_Code] IN {"US","BD"},
			            "Drafting + Capture",
			                (
			                    (radiologist_metrics[Is_Drafting_Row] = 1
			                        && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                    || (radiologist_metrics[Is_Capture_Row] = 1
			                        && radiologist_metrics[Modality_Code] IN {"US","BD"})
			                ),
			            radiologist_metrics[Is_Mosaic_Row] = 1
			        ),
			        IF(
			            _outlierView = "Excluded",
			            radiologist_metrics[Outliers] = "Excluded",
			            TRUE()
			        )
			    )
			
			VAR _mosaicRaw =
			    CALCULATE(
			        SUM(radiologist_metrics[TotalTBWU]),
			        radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        SWITCH(
			            _mode,
			            "Drafting Only",
			                radiologist_metrics[Is_Drafting_Row] = 1
			                    && radiologist_metrics[Modality_Code] IN {"CR","CT"},
			            "Reporting Only",
			                radiologist_metrics[Is_Reporting_Row] = 1,
			            "Capture Only",
			                radiologist_metrics[Is_Capture_Row] = 1
			                    && radiologist_metrics[Modality_Code] IN {"US","BD"},
			            "Drafting + Capture",
			                (
			                    (radiologist_metrics[Is_Drafting_Row] = 1
			                        && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                    || (radiologist_metrics[Is_Capture_Row] = 1
			                        && radiologist_metrics[Modality_Code] IN {"US","BD"})
			                ),
			            radiologist_metrics[Is_Mosaic_Row] = 1
			        ),
			        IF(
			            _outlierView = "Excluded",
			            radiologist_metrics[Outliers] = "Excluded",
			            TRUE()
			        )
			    )
			
			VAR _timeRaw =
			    CALCULATE(
			        SUM(radiologist_metrics[TotalTime]),
			        radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        SWITCH(
			            _mode,
			            "Drafting Only",
			                radiologist_metrics[Is_Drafting_Row] = 1
			                    && radiologist_metrics[Modality_Code] IN {"CR","CT"},
			            "Reporting Only",
			                radiologist_metrics[Is_Reporting_Row] = 1,
			            "Capture Only",
			                radiologist_metrics[Is_Capture_Row] = 1
			                    && radiologist_metrics[Modality_Code] IN {"US","BD"},
			            "Drafting + Capture",
			                (
			                    (radiologist_metrics[Is_Drafting_Row] = 1
			                        && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                    || (radiologist_metrics[Is_Capture_Row] = 1
			                        && radiologist_metrics[Modality_Code] IN {"US","BD"})
			                ),
			            radiologist_metrics[Is_Mosaic_Row] = 1
			        ),
			        IF(
			            _outlierView = "Excluded",
			            radiologist_metrics[Outliers] = "Excluded",
			            TRUE()
			        )
			    )
			
			RETURN
			IF(
			    COALESCE(_mosaicExamsRaw, 0) > 0
			        && NOT ISBLANK(_baselineRaw)
			        && NOT ISBLANK(_mosaicRaw)
			        && COALESCE(_timeRaw, 0) > 0,
			    1,
			    0
			)
		formatString: 0
		lineageTag: fa8a9704-f399-4615-9c9f-6e1779eefb0b

	column Date
		formatString: General Date
		lineageTag: fc69f3ad-3a14-4bdc-b088-b4567bc399c4
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		variation Variation
			isDefault
			relationship: dc9dc873-5fcf-4f39-9cd4-c16ad1416041
			defaultHierarchy: LocalDateTable_259f894e-d53e-4e47-a23b-22a215dc3b16.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	partition Timeline = calculated
		mode: import
		source = ```
				
				VAR AllDates = 
				    UNION(
				        SELECTCOLUMNS('Baseline_Calendar', "Date", 'Baseline_Calendar'[Date]),
				        SELECTCOLUMNS('Mosaic_Calendar', "Date", 'Mosaic_Calendar'[Date])
				    )
				RETURN
				DISTINCT(AllDates)
				```

	annotation PBI_Id = f70093dae66b4d8d9891824187123c70

