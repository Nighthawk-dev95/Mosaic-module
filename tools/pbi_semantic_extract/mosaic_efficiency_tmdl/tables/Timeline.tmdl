	measure Base_Baseline_Efficiency_Site =
			
			VAR _mode =
			    SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			
			VAR _outlierView =
			    SELECTEDVALUE('Outlier Selector'[Outlier View], "Excluded")
			
			VAR _showRow =
			    [Show Site Practice Row]
			
			VAR _weightedBaseline =
			    CALCULATE(
			        SUM(radiologist_metrics[Weighted_Baseline_Contrib_Excl]),
			        radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        SWITCH(
			            _mode,
			            "Drafting Only",
			                radiologist_metrics[Period_Type] = "Drafting"
			                    && radiologist_metrics[Modality_Code] IN {"CR","CT"},
			            "Reporting Only",
			                radiologist_metrics[Period_Type] = "Reporting",
			            "Capture Only",
			                radiologist_metrics[Period_Type] = "Drafting"
			                    && radiologist_metrics[Modality_Code] IN {"US","BD"},
			            "Drafting + Capture",
			                (
			                    (radiologist_metrics[Period_Type] = "Drafting"
			                        && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                    || (radiologist_metrics[Period_Type] = "Drafting"
			                        && radiologist_metrics[Modality_Code] IN {"US","BD"})
			                ),
			            radiologist_metrics[Period_Type] IN {"Drafting","Reporting"}
			        ),
			        IF(
			            _outlierView = "Excluded",
			            radiologist_metrics[Outliers] = "Excluded",
			            TRUE()
			        )
			    )
			
			VAR _time =
			    CALCULATE(
			        SUM(radiologist_metrics[TotalTime]),
			        radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        SWITCH(
			            _mode,
			            "Drafting Only",
			                radiologist_metrics[Period_Type] = "Drafting"
			                    && radiologist_metrics[Modality_Code] IN {"CR","CT"},
			            "Reporting Only",
			                radiologist_metrics[Period_Type] = "Reporting",
			            "Capture Only",
			                radiologist_metrics[Period_Type] = "Drafting"
			                    && radiologist_metrics[Modality_Code] IN {"US","BD"},
			            "Drafting + Capture",
			                (
			                    (radiologist_metrics[Period_Type] = "Drafting"
			                        && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                    || (radiologist_metrics[Period_Type] = "Drafting"
			                        && radiologist_metrics[Modality_Code] IN {"US","BD"})
			                ),
			            radiologist_metrics[Period_Type] IN {"Drafting","Reporting"}
			        ),
			        IF(
			            _outlierView = "Excluded",
			            radiologist_metrics[Outliers] = "Excluded",
			            TRUE()
			        )
			    )
			
			RETURN
			IF(
			    _showRow = 1
			        && COALESCE(_time, 0) > 0
			        && NOT ISBLANK(_weightedBaseline),
			    DIVIDE(_weightedBaseline, _time),
			    BLANK()
			)
		lineageTag: e1159b2b-5645-409a-becb-dc45e95e046a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

