	measure 'Practice Mosaic Exams Selected Period' = ```
			
			VAR _mosaicMode = SELECTEDVALUE('Mosaic Mode Selector'[Mode], "Full Mosaic")
			VAR _outlierView = SELECTEDVALUE('Outlier Selector'[Outlier View], "Excluded")
			VAR IncludeAllExams = (_outlierView = "Included")
			
			VAR IsSiteLevel = ISINSCOPE(radiologist_metrics[Location_Name])
			
			VAR PracticeTotal = 
			    CALCULATE(
			        SUM(radiologist_metrics[ExamCount]),
			        radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        SWITCH(
			            _mosaicMode,
			            "Drafting Only",
			                radiologist_metrics[Is_Drafting_Row] = 1
			                    && radiologist_metrics[Modality_Code] IN {"CR","CT"},
			            "Reporting Only",
			                radiologist_metrics[Is_Reporting_Row] = 1,
			            "Full Mosaic",
			                radiologist_metrics[Is_Mosaic_Row] = 1,
			            "Capture Only",
			                radiologist_metrics[Is_Capture_Row] = 1
			                    && radiologist_metrics[Modality_Code] IN {"US","BD"},
			            "Drafting + Capture",
			                (
			                    (radiologist_metrics[Is_Drafting_Row] = 1
			                        && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                    || (radiologist_metrics[Is_Capture_Row] = 1
			                        && radiologist_metrics[Modality_Code] IN {"US","BD"})
			                ),
			            radiologist_metrics[Is_Mosaic_Row] = 1
			        ),
			        IF(
			            IncludeAllExams,
			            TRUE(),
			            radiologist_metrics[Outliers] = "Excluded"
			        )
			    )
			
			VAR PracticeTotalFromSite = 
			    CALCULATE(
			        SUM(radiologist_metrics[ExamCount]),
			        ALL(radiologist_metrics[Location_Name]),
			        radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date]),
			        SWITCH(
			            _mosaicMode,
			            "Drafting Only",
			                radiologist_metrics[Is_Drafting_Row] = 1
			                    && radiologist_metrics[Modality_Code] IN {"CR","CT"},
			            "Reporting Only",
			                radiologist_metrics[Is_Reporting_Row] = 1,
			            "Full Mosaic",
			                radiologist_metrics[Is_Mosaic_Row] = 1,
			            "Capture Only",
			                radiologist_metrics[Is_Capture_Row] = 1
			                    && radiologist_metrics[Modality_Code] IN {"US","BD"},
			            "Drafting + Capture",
			                (
			                    (radiologist_metrics[Is_Drafting_Row] = 1
			                        && radiologist_metrics[Modality_Code] IN {"CR","CT"})
			                    || (radiologist_metrics[Is_Capture_Row] = 1
			                        && radiologist_metrics[Modality_Code] IN {"US","BD"})
			                ),
			            radiologist_metrics[Is_Mosaic_Row] = 1
			        ),
			        IF(
			            IncludeAllExams,
			            TRUE(),
			            radiologist_metrics[Outliers] = "Excluded"
			        )
			    )
			
			RETURN
			IF(IsSiteLevel, PracticeTotalFromSite, PracticeTotal)
