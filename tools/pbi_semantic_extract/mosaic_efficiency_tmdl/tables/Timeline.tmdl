	measure 'Drafting TBWU per Min TS' = ```
			
			VAR TotalTBWU = 
			    CALCULATE(
			        SUM(radiologist_metrics[TotalTBWU]),
			        radiologist_metrics[Period_Type] = "Drafting",
			        radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date])
			    )
			
			VAR TotalTime = 
			    CALCULATE(
			        SUM(radiologist_metrics[TotalTime]),
			        radiologist_metrics[Period_Type] = "Drafting",
			        radiologist_metrics[Exam_Date] IN VALUES('Mosaic_Calendar'[Date])
			    )
			
			RETURN
			DIVIDE(TotalTBWU, TotalTime / 60)
			```
