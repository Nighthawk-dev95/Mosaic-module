table 'Mosaic metric'
	lineageTag: 2121be21-89a7-4c07-96a0-2e07da2a3919

	measure Volume = ```
			
			VAR MosaicSel = SELECTEDVALUE('Mosaic metric'[Mosaic Flag])
			VAR SelectedOutlierView = SELECTEDVALUE('Outlier Selector'[Outlier View], "Excluded")
			VAR IncludeAllExams = (SelectedOutlierView = "Included")
			
			RETURN
			SWITCH(
			    MosaicSel,
			    "Drafting Only", 
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]), 
			            radiologist_metrics[Period_Type] = "Drafting",
			            IncludeAllExams || radiologist_metrics[Outliers] = "Excluded"
			        ),
			    "Reporting Only", 
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]), 
			            radiologist_metrics[Period_Type] = "Reporting",
			            IncludeAllExams || radiologist_metrics[Outliers] = "Excluded"
			        ),
			    "Non-Mosaic", 
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]), 
			            radiologist_metrics[Period_Type] = "Baseline",
			            IncludeAllExams || radiologist_metrics[Outliers] = "Excluded"
			        ),
			    "Full Mosaic", 
			        CALCULATE(
			            SUM(radiologist_metrics[ExamCount]), 
			            radiologist_metrics[Period_Type] IN {"Drafting", "Reporting"},
			            IncludeAllExams || radiologist_metrics[Outliers] = "Excluded"
			        ),
			    BLANK()
			)
			```
		formatString: 0
		lineageTag: a17e1f11-ec4f-42d4-8572-90c9c00e285c

	measure 'has volume' =
			
			IF(
			
			NOT ISBLANK([Volume]) && [Volume] >0 ,1,0)
		formatString: 0
		lineageTag: 52f8c69b-f421-4805-9632-a16a7539d29e

	measure 'Mean Dictation (With Vol)' = ```
			
			VAR MosaicSel = SELECTEDVALUE('Mosaic metric'[Mosaic Flag])
			VAR SelectedVRA = SELECTEDVALUE('VRA Slicer'[VRA])
			VAR SelectedOutlierView = SELECTEDVALUE('Outlier Selector'[Outlier View], "Excluded")
			VAR IncludeAllExams = (SelectedOutlierView = "Included")
			
			VAR TotalTime = 
			    SWITCH(
			        MosaicSel,
			        "Drafting Only", 
			            CALCULATE(
			                SUM(radiologist_metrics[TotalTime]), 
			                radiologist_metrics[Period_Type] = "Drafting",
			                IncludeAllExams || radiologist_metrics[Outliers] = "Excluded",
			                ISBLANK(SelectedVRA) || radiologist_metrics[vra_assisted_flag] = SelectedVRA
			            ),
			        "Reporting Only", 
			            CALCULATE(
			                SUM(radiologist_metrics[TotalTime]), 
			                radiologist_metrics[Period_Type] = "Reporting",
			                IncludeAllExams || radiologist_metrics[Outliers] = "Excluded",
			                ISBLANK(SelectedVRA) || radiologist_metrics[vra_assisted_flag] = SelectedVRA
			            ),
			        "Non-Mosaic", 
			            CALCULATE(
			                SUM(radiologist_metrics[TotalTime]), 
			                radiologist_metrics[Period_Type] = "Baseline",
			                IncludeAllExams || radiologist_metrics[Outliers] = "Excluded",
			                ISBLANK(SelectedVRA) || radiologist_metrics[vra_assisted_flag] = SelectedVRA
			            ),
			        "Full Mosaic", 
			            CALCULATE(
			                SUM(radiologist_metrics[TotalTime]), 
			                radiologist_metrics[Period_Type] IN {"Drafting", "Reporting"},
			                IncludeAllExams || radiologist_metrics[Outliers] = "Excluded",
			                ISBLANK(SelectedVRA) || radiologist_metrics[vra_assisted_flag] = SelectedVRA
			            ),
			        BLANK()
			    )
			
			VAR ExamCount = 
			    SWITCH(
			        MosaicSel,
			        "Drafting Only", 
			            CALCULATE(
			                SUM(radiologist_metrics[ExamCount]), 
			                radiologist_metrics[Period_Type] = "Drafting",
			                IncludeAllExams || radiologist_metrics[Outliers] = "Excluded",
			                ISBLANK(SelectedVRA) || radiologist_metrics[vra_assisted_flag] = SelectedVRA
			            ),
			        "Reporting Only", 
			            CALCULATE(
			                SUM(radiologist_metrics[ExamCount]), 
			                radiologist_metrics[Period_Type] = "Reporting",
			                IncludeAllExams || radiologist_metrics[Outliers] = "Excluded",
			                ISBLANK(SelectedVRA) || radiologist_metrics[vra_assisted_flag] = SelectedVRA
			            ),
			        "Non-Mosaic", 
			            CALCULATE(
			                SUM(radiologist_metrics[ExamCount]), 
			                radiologist_metrics[Period_Type] = "Baseline",
			                IncludeAllExams || radiologist_metrics[Outliers] = "Excluded",
			                ISBLANK(SelectedVRA) || radiologist_metrics[vra_assisted_flag] = SelectedVRA
			            ),
			        "Full Mosaic", 
			            CALCULATE(
			                SUM(radiologist_metrics[ExamCount]), 
			                radiologist_metrics[Period_Type] IN {"Drafting", "Reporting"},
			                IncludeAllExams || radiologist_metrics[Outliers] = "Excluded",
			                ISBLANK(SelectedVRA) || radiologist_metrics[vra_assisted_flag] = SelectedVRA
			            ),
			        BLANK()
			    )
			
			VAR Result = DIVIDE(TotalTime, ExamCount)
			
			RETURN
			IF(ExamCount > 0, Result, BLANK())
			```
		formatString: 0
		lineageTag: f6641d8c-e5e0-46c0-aa7c-388bd0eabc14

	measure 'MRVUperMin (With Vol)' = ```
			
			VAR MosaicSel = SELECTEDVALUE('Mosaic metric'[Mosaic Flag])
			VAR SelectedVRA = SELECTEDVALUE('VRA Slicer'[VRA])
			VAR SelectedOutlierView = SELECTEDVALUE('Outlier Selector'[Outlier View], "Excluded")
			VAR IncludeAllExams = (SelectedOutlierView = "Included")
			
			VAR TotalRVU = 
			    SWITCH(
			        MosaicSel,
			        "Drafting Only", 
			            CALCULATE(
			                SUM(radiologist_metrics[TotalRVU]), 
			                radiologist_metrics[Period_Type] = "Drafting",
			                IncludeAllExams || radiologist_metrics[Outliers] = "Excluded",
			                ISBLANK(SelectedVRA) || radiologist_metrics[vra_assisted_flag] = SelectedVRA
			            ),
			        "Reporting Only", 
			            CALCULATE(
			                SUM(radiologist_metrics[TotalRVU]), 
			                radiologist_metrics[Period_Type] = "Reporting",
			                IncludeAllExams || radiologist_metrics[Outliers] = "Excluded",
			                ISBLANK(SelectedVRA) || radiologist_metrics[vra_assisted_flag] = SelectedVRA
			            ),
			        "Non-Mosaic", 
			            CALCULATE(
			                SUM(radiologist_metrics[TotalRVU]), 
			                radiologist_metrics[Period_Type] = "Baseline",
			                IncludeAllExams || radiologist_metrics[Outliers] = "Excluded",
			                ISBLANK(SelectedVRA) || radiologist_metrics[vra_assisted_flag] = SelectedVRA
			            ),
			        "Full Mosaic", 
			            CALCULATE(
			                SUM(radiologist_metrics[TotalRVU]), 
			                radiologist_metrics[Period_Type] IN {"Drafting", "Reporting"},
			                IncludeAllExams || radiologist_metrics[Outliers] = "Excluded",
			                ISBLANK(SelectedVRA) || radiologist_metrics[vra_assisted_flag] = SelectedVRA
			            ),
			        BLANK()
			    )
			
			VAR TotalTime = 
			    SWITCH(
			        MosaicSel,
			        "Drafting Only", 
			            CALCULATE(
			                SUM(radiologist_metrics[TotalTime]), 
			                radiologist_metrics[Period_Type] = "Drafting",
			                IncludeAllExams || radiologist_metrics[Outliers] = "Excluded",
			                ISBLANK(SelectedVRA) || radiologist_metrics[vra_assisted_flag] = SelectedVRA
			            ),
			        "Reporting Only", 
			            CALCULATE(
			                SUM(radiologist_metrics[TotalTime]), 
			                radiologist_metrics[Period_Type] = "Reporting",
			                IncludeAllExams || radiologist_metrics[Outliers] = "Excluded",
			                ISBLANK(SelectedVRA) || radiologist_metrics[vra_assisted_flag] = SelectedVRA
			            ),
			        "Non-Mosaic", 
			            CALCULATE(
			                SUM(radiologist_metrics[TotalTime]), 
			                radiologist_metrics[Period_Type] = "Baseline",
			                IncludeAllExams || radiologist_metrics[Outliers] = "Excluded",
			                ISBLANK(SelectedVRA) || radiologist_metrics[vra_assisted_flag] = SelectedVRA
			            ),
			        "Full Mosaic", 
			            CALCULATE(
			                SUM(radiologist_metrics[TotalTime]), 
			                radiologist_metrics[Period_Type] IN {"Drafting", "Reporting"},
			                IncludeAllExams || radiologist_metrics[Outliers] = "Excluded",
			                ISBLANK(SelectedVRA) || radiologist_metrics[vra_assisted_flag] = SelectedVRA
			            ),
			        BLANK()
			    )
			
			VAR Result = DIVIDE(TotalRVU, TotalTime / 60)
			
			RETURN
			IF([Volume] > 0, Result, BLANK())
			```
