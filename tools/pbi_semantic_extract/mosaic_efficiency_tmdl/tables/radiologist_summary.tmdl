	column team_rolled_up = ```
			
			var currentteam = radiologist_summary[Team]
			var mappedteam = 
			LOOKUPVALUE(team_rollups[Team Roll Up (KS)], 
			team_rollups[Team] , currentteam
			)
			RETURN
			SWITCH(
			    TRUE(),
			    NOT ISBLANK(MappedTeam), MappedTeam,
			    CurrentTeam = "Access Slidell", "Access Alexandria",
			    CurrentTeam
			)
			```
