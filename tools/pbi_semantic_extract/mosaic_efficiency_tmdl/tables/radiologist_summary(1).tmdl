	column team_rolled_up = ```
			
			VAR CurrentTeam = 'radiologist_summary(1)'[Team]
			VAR CurrentNPI = 'radiologist_summary(1)'[Physician_NPI]
			
			// If current team is blank, get from provpractice
			VAR RelatedTeam = RELATED('provpractice_vw'[Team])
			VAR BaseTeam = IF(ISBLANK(CurrentTeam), RelatedTeam, CurrentTeam)
			
			// Manual Override
			VAR ManualOverride = 
			    SWITCH(
			        TRUE(),
			        CurrentNPI = 1174510937, "RP North Florida",
			        BLANK()
			    )
			
			// Lookup from team_rollups using BaseTeam
			VAR MappedTeam = 
			    LOOKUPVALUE(
			        team_rollups[Team Roll Up (KS)], 
			        team_rollups[Team], 
			        TRIM(BaseTeam)
			    )
			
			// Fallback logic
			VAR FallbackTeam = 
			    SWITCH(
			        TRUE(),
			        BaseTeam = "Access Slidell", "Access Alexandria",
			        BaseTeam
			    )
			
			RETURN
			SWITCH(
			    TRUE(),
			    NOT ISBLANK(ManualOverride), ManualOverride,
			    NOT ISBLANK(MappedTeam), MappedTeam,
			    FallbackTeam
			)
			```
		lineageTag: 1505f498-7c8c-44db-929d-3790ba8db334
		summarizeBy: none

