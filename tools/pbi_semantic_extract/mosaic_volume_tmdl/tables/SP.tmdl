	column AB =
			
			SWITCH (
			    TRUE(),
			    SP[Pctmwow] <= 0, "6 - Rads not using Mosaic   ",
			    SP[Pctmwow] > 0 && SP[Pctmwow] <= 0.2, "5 - 1-20%   ",
			    SP[Pctmwow] > 0.2 && SP[Pctmwow] <= 0.4, "4 - 20-40%   ",
			    SP[Pctmwow] > 0.4 && SP[Pctmwow] <= 0.6, "3 - 40-60%   ",
			    SP[Pctmwow] > 0.6 && SP[Pctmwow] <= 0.8, "2 - 60-80%   ",
			    SP[Pctmwow] > 0.8, "1 - Fully Adopted on Mosaic   "
			)
		lineageTag: 75bbff29-7f7e-4d54-a10c-92ee08193451
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

