table SP
	lineageTag: ac1ebfeb-7e5b-4135-be02-b25ce5a44d6d

	measure Pctmwow = ```
			
			 
			 
			 
			VAR WeekStartDate = MIN('SP'[Weekstart])
			VAR WeekEndDate   = WeekStartDate + 6
			VAR EligibilityCutoffDate = WeekEndDate - 2
			 
			-- Eligible providers: FirstCase_Provider must be at least 14 days before every day in the week
			VAR EligibleProvidersWeek =
			    DISTINCT(
			        SELECTCOLUMNS(
			            FILTER(
			                'SP',
			                'SP'[Go-live] <= EligibilityCutoffDate
			            ),
			            "NPI", 'SP'[NPI]
			        )
			    )
			 
			-- Denominator: eligible providers with total cases > 0 in that week
			VAR DenominatorProviders =
			    FILTER(
			        'SP',
			        'SP'[NPI] IN SELECTCOLUMNS(EligibleProvidersWeek, "NPI", [NPI]) &&
			        'SP'[Totalcases] > 0 &&
			        'SP'[Weekstart] >= WeekStartDate &&
			        'SP'[Weekstart] <= WeekEndDate
			    )
			 
			-- Numerator: mosaic cases for these providers
			VAR MosaicCases =
			    CALCULATE(
			        SUM('SP'[Mosaiccases]),
			        TREATAS(SELECTCOLUMNS(ADDCOLUMNS(DenominatorProviders, "StartDate", MAX('SP'[Go-live] , WeekEndDate - 13)
			        ),
			         "NPI", [NPI]), 'SP'[NPI])
			    )
			 
			-- Total cases for these providers
			VAR TotalCases =
			    CALCULATE(
			        SUM('SP'[Totalcases]),
			        TREATAS(SELECTCOLUMNS(ADDCOLUMNS(DenominatorProviders, "StartDate" , MAX('SP'[Go-live] , WeekEndDate - 13)
			        ),
			         "NPI", [NPI]), 'SP'[NPI])
			    )
			 
			RETURN
			DIVIDE(MosaicCases, TotalCases, 0)
			```
		lineageTag: ab39a03d-595f-4474-9b46-e1bdb6352ae9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Pctprovbuc =
			
			DIVIDE(DISTINCTCOUNT(SP[NPI]),
			CALCULATE(DISTINCTCOUNT(SP[NPI]), ALL(SP[AB]))
			)
		lineageTag: 9f8c28e0-7e12-428a-af3c-b8e916cdb683

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure totalprov =
			
			
			CALCULATE(DISTINCTCOUNT(SP[NPI]),
			
			ALLEXCEPT(SP, SP[Weekstart],SP[Team],SP[Team_Name],SP[Is Eligible],SP[Mosaicdraftingeligible])
			
			)
		formatString: 0
		lineageTag: d14c55f1-bc62-40ae-a517-09bea496158a

