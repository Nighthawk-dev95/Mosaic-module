		annotation SummarizationSetBy = Automatic

	partition SP = calculated
		mode: import
		source = ```
				
				FILTER(
				ADDCOLUMNS(
				SUMMARIZE('Daily_Extract',
				 
				'Daily_Extract'[NPI],'Daily_Extract'[WeekStart] , 'Daily_Extract'[Team], 'Daily_Extract'[Provider],'Daily_Extract'[Team_Name],'Daily_Extract'[Is Eligible],'Daily_Extract'[Mosaicdraftingeligible]),
				 
				 
				"Totalcases", CALCULATE(COUNTROWS('Daily_Extract'), 'Daily_Extract'[Date] >=DATE(2025,4,8)),
				 
				"Mosaiccases",CALCULATE(COUNTROWS('Daily_Extract'), 'Daily_Extract'[Mosaic Exam Flag] =1 , 'Daily_Extract'[Date] >=DATE( 2025,4,8)),
				 
				   "Weeklabel",
				    FORMAT( 'Daily_Extract'[WeekStart] , "MMM dd") & " - " &
				    FORMAT('Daily_Extract'[WeekStart] +6 , "MMM dd"),
				 
				    "Go-live",
				calculate( MIN('Daily_Extract'[Final_DateTime - Date]),
				 'Daily_Extract'[Mosaic Exam Flag] = 1, ALLEXCEPT('Daily_Extract', 'Daily_Extract'[NPI]))
				),
				 
				NOT ISBLANK([Go-live]) &&
				'Daily_Extract'[WeekStart] >=DATE(2025,4,6) &&
				 
				[Go-live] <= MAXX(CALENDAR('Daily_Extract'[WeekStart], 'Daily_Extract'[WeekStart]+6),
				[Date] -2
				)
				 
				 
				 
				 
				 
				 
				 
				 
				)
				 
				```

	annotation PBI_Id = dc0a677b119245f1b244c89bcc150d76

