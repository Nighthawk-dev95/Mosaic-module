	measure 'Fully Utilizing Filter' = ```
			
			VAR SelectedStatus = SELECTEDVALUE('Query (3)'[vrarp_fullyutilizingname])
			VAR CurrentNPI = SELECTEDVALUE('Daily_Extract'[NPI])
			VAR RadFullyUtilizingStatus = 
			    CALCULATE(
			        MAX('Query (3)'[vrarp_fullyutilizingname]),
			        'Query (3)'[vrarp_npi] = CurrentNPI
			    )
			VAR HasMosaicCases = 
			    CALCULATE(
			        COUNTROWS('Daily_Extract'),
			        'Daily_Extract'[NPI] = CurrentNPI,
			        'Daily_Extract'[Mosaic Exam Flag] = 1
			    ) > 0
			
			RETURN
			    SWITCH(
			        TRUE(),
			        // No selection - show everyone
			        ISBLANK(SelectedStatus), 1,
			        // "Yes" selected - only show fully utilizing rads (must have Mosaic)
			        SelectedStatus = "Yes" && RadFullyUtilizingStatus = "Yes" && HasMosaicCases, 1,
			        // "No" selected - only show non-fully utilizing rads who ARE on Mosaic
			        SelectedStatus = "No" && RadFullyUtilizingStatus = "No" && HasMosaicCases, 1,
			        // Hide everyone else
			        0
			    )
			```
