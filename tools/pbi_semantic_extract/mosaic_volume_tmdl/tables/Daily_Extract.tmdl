	measure '% CT' =
			
			SWITCH(
			    TRUE(),
			    [SelectedMeasure] = "Exam Count", DIVIDE([ct_reporting], [Total_ct], 0),
			    [SelectedMeasure] = "RVUs", DIVIDE(
			        CALCULATE(SUM(Daily_Extract[RVU-decimal]), Daily_Extract[Modality] = "CT", Daily_Extract[Mosaic Exam Flag] = 1),
			        CALCULATE(SUM(Daily_Extract[RVU-decimal]), Daily_Extract[Modality] = "CT"),
			        0
			    ),
			    DIVIDE([ct_reporting], [Total_ct], 0)
