	measure '% Mammo' = ```
			
			VAR MosaicFlagSelected = SELECTEDVALUE('Daily_Extract'[Mosaic Exam Flag])
			
			VAR Numerator = 
			    CALCULATE(
			        SUM('Daily_Extract'[Exam Ct]),
			        'Daily_Extract'[Modality] = "MG"
			    )
			
			VAR Denominator = 
			    IF(
			        MosaicFlagSelected = 1,
			        CALCULATE(
			            [Total Exam Ct],
			            REMOVEFILTERS('Daily_Extract'[Modality]),  -- ✅ Ignore modality slicer
			            'Daily_Extract'[Mosaic Exam Flag] = 1
			        ),
			        CALCULATE(
			            [Total Exam Ct],
			            REMOVEFILTERS('Daily_Extract'[Modality]),  -- ✅ Ignore modality slicer
			            REMOVEFILTERS('Daily_Extract'[Mosaic Exam Flag])
			        )
			    )
			
			RETURN
			DIVIDE(Numerator, Denominator, 0)
			```
