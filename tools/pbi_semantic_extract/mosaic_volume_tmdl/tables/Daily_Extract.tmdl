	measure '% Draftable XRs Read in Mosaic (last 14d)' = ```
			
			VAR CurrentNPI = SELECTEDVALUE('Daily_Extract'[NPI])
			
			VAR firstcasedate = 
			    CALCULATE(
			        MIN('Daily_Extract'[Final_DateTime - Date]), 
			        ALL('Daily_Extract'),
