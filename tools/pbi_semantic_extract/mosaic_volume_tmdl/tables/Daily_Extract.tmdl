			        REMOVEFILTERS('Daily_Extract'[Final_DateTime - Date]),
			        'Daily_Extract'[Final_DateTime - Date] >= Last14DaysStart,
			        'Daily_Extract'[Final_DateTime - Date] <= TODAY(), 
			        NOT(daily_extract[Modality] IN {"BD", "MG","IR"}),
			            NOT(daily_extract[Site] IN { "Tampa General Hospital North Brooksville", "Tampa General Hospital North Spring Hill","TGHI Bayonet Point", "TGHI Bloomingale", "TGHI Bruce B Downs" , "TGHI Carrollwood" , "TGHI Habana" , "TGHI New Port Richey" , "TGHI New Tampa" , "TGHI North Dale Mabry" ,"TGHI Northcliff", "TGHI Oldsmar" , "TGHI Palm Beach Gardens","TGHI Parsons" , "TGHI Riverview" , "TGHI South Tampa" , "TGHI Sun City", "TGHI Sunlake" , "TGHI Trinity" , "TGHI Wesley Chapel"}),
			            NOT(daily_extract[Clinical_Procedure_Description] IN {"CT LUNG SCREENING", "CT LUNG SCREENING FOLLOW UP WITH IV CONTRAST", "CT LUNG SCREENING FOLLOW UP WITHOUT IV CONTRAST", "CT LUNG SCREENING WITHOUT CONTRAST", "CT Lung WO Screening (LDCT) Initial | 71271", "CT LUNG WO Screening (LDCT) Initial, CT Lung WO Screening (LDCT) Initial"})
			        
			    )
			
			RETURN
			    DIVIDE(EligibleCasesLast14Days, TotalCasesLast14Days, 0)
			
