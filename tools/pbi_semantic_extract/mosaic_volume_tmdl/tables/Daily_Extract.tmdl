	measure SelectedMonthsText = ```
			
			var minmonth = min ('Daily_Extract'[Startofmonth])
			var maxmonth = max ('Daily_Extract'[Startofmonth])
			var currentmonth = eomonth( today() , 0) 
			var totalmonths = countrows ( 'Daily_Extract')
			var selectedmonthscount = distinctcount ('Daily_Extract'[Startofmonth])
			var allmonthsselected = selectedmonthscount = totalmonths
