	column Crossreads =
			IF(and(Daily_Extract[Practice]="Access", Left(Daily_Extract[Team],6)="Access"),0,
			IF(and(Daily_Extract[Practice]="Baylor Radiologists",Left(Daily_Extract[Team],6)= "Baylor"),0,
			IF(and(Daily_Extract[Practice]="Desert",Left(Daily_Extract[Team],6)= "Desert"),0,
			IF(and(Daily_Extract[Practice]="ESR",Daily_Extract[Team]= "Empire State"),0,
			IF(and(Daily_Extract[Practice]="Greensboro",Daily_Extract[Team]= "Greensboro Radiology"),0,
			IF(and(Daily_Extract[Practice]="IAM",Daily_Extract[Team]= "IA Michigan"),0,
			IF(and(Daily_Extract[Practice]="IAMSE",Daily_Extract[Team]= "IA Michigan Southeast"),0,
			IF(and(Daily_Extract[Practice]="Mountain",Daily_Extract[Team]= "Mountain Radiology"),0,
			IF(and(Daily_Extract[Practice]="MXC",Daily_Extract[Team]= "MXC Imaging Specialists"),0,
			IF(and(Daily_Extract[Practice]="NEOH",Daily_Extract[Team]= "Northeast Ohio"),0,
			IF(and(Daily_Extract[Practice]="RACSW",Daily_Extract[Team]= "RAC SW"),0,
			IF(and(Daily_Extract[Practice]="RAF",Left(Daily_Extract[Team],3)= "RAF"),0,
			IF(and(Daily_Extract[Practice]="RASF",Left(Daily_Extract[Team],4)= "RASF"),0,
			IF(and(Daily_Extract[Practice]="RP Indiana",RIGHT(Daily_Extract[Team],7)= "Indiana"),0,
			IF(and(Daily_Extract[Practice]="SVDI",Daily_Extract[Team]= "Silicon Valley Diagnostic Imaging"),0,
			IF(and(Daily_Extract[Practice]="WGR",Daily_Extract[Team]= "West Georgia Radiology"),0,
