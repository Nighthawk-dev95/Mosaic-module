	column 'Team Rolled up' = ```
			
			VAR ProvPracticeTeam = 
			    LOOKUPVALUE(
			        'provpractice_vw'[Team],
			        'provpractice_vw'[NPI],
			        'Daily_Extract'[Provider_NPI]
			    )
			VAR FallbackTeam = 
			    LOOKUPVALUE(
			        'team_rollups'[Team Roll Up (KS)],
			        'team_rollups'[Team],
			        TRIM('Daily_Extract'[Team])
			    )
			VAR ManualOverride = 
			SWITCH(
			    'Daily_Extract'[Provider_NPI],  1174510937, "RP North Florida",
			     
			        1417539156, "RASF",
			        1891950150, "RASF",
			        1306157078, "RASF",
			        1639600588, "RASF",
			        1326001280, "RASF",
			        1396948659, "SMI",
			        1275912552, "ARA", 
			     1063299410 , "RASF", 
			     1205624632 , "RASF" , 
			     1497322457, "RASF", 
			     1548794332, "RASF", 
			     1811976459, "RASF",
			     
			     1558379024, "SMI",
			     
			     
			     
			     
			     
			     BLANK())
			RETURN
			    IF(
			        NOT(ISBLANK(ManualOverride)), 
			        ManualOverride,
			        IF(
			            NOT(ISBLANK(ProvPracticeTeam)), 
			            ProvPracticeTeam,
			            IF(
			                NOT(ISBLANK(FallbackTeam)),
			                FallbackTeam,
			                'Daily_Extract'[Team]  -- ✅ Final fallback to original Team column
			            )
			        )
			    )
			
			```
