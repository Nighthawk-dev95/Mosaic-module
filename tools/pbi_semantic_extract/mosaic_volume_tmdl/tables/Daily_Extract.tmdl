	measure totalradslivedep =
			
			VAR LiveNPIs =
			    FILTER(
			        VALUES('Daily_Extract'[NPI]),
			        VAR CurrentNPI = 'Daily_Extract'[NPI]
			        VAR RadPctMosaic =
			            CALCULATE(
			                [% Mosaic Exams],
			                'Daily_Extract'[NPI] = CurrentNPI
			            )
			        VAR IsFullyLive = RadPctMosaic > 0.98
			        VAR IsPartiallyLive = RadPctMosaic <= 0.98 && RadPctMosaic > 0.01
			        RETURN IsFullyLive || IsPartiallyLive
			    )
			RETURN
			    COUNTROWS(LiveNPIs)
		formatString: 0
		lineageTag: 0e0488af-25b0-4f26-83f0-89bc1a73a108

	measure totalfullyadoptedmonthdd = ```
			
			
			CALCULATE(
			    DISTINCTCOUNT('Daily_Extract'[NPI]),
			    FILTER(
			        VALUES('Daily_Extract'[NPI]),
			var monthstart = MIN('Daily_Extract'[Date])
			var monthend = MAX('Daily_Extract'[Date])
			        VAR FirstCase =
			            CALCULATE(
			                MIN('Daily_Extract'[Final_DateTime - Date]),
			                'Daily_Extract'[Mosaic Exam Flag] = 1
			            )
			
			            var examstartdate = 
			            IF(FirstCase > monthend - 14, FirstCase, monthend - 14)
			        VAR ProviderExams =
			            CALCULATE(
			                COUNTROWS('Daily_Extract'),
			                'Daily_Extract'[Date] <= monthend &&
			                'Daily_Extract'[Date] >= examstartdate
			            )
			        VAR ProviderMosaicExams =
			            CALCULATE(
			                COUNTROWS('Daily_Extract'),
			                'Daily_Extract'[Mosaic Exam Flag] = 1,
			                'Daily_Extract'[Date] <= monthend &&
			                'Daily_Extract'[Date] >= examstartdate
			            )
			        VAR PctMosaic = DIVIDE(ProviderMosaicExams, ProviderExams, 0)
			        
			        RETURN
			            FirstCase <= monthend - 2 &&
			            PctMosaic > 0.8 
			          
			    )
			)
			```
		formatString: 0
		lineageTag: 629b04a7-4113-494b-9742-f0601b90ed99

	measure pctfullyadopredmonthaware =
			
			
			VAR SelectedNPIs = VALUES('Daily_Extract'[NPI])
			var lastdateincontext = MAX('Daily_Extract'[Date])
			-- Determine the dynamic start date for last 14 days or beginning of selected month
			
			
			-- Count of fully adopted providers per current slicer context (including month)
			VAR FullyAdoptedCount =
			    CALCULATE(
			        DISTINCTCOUNT('Daily_Extract'[NPI]),
			        FILTER(
			            SelectedNPIs,
			            VAR ThisNPI = 'Daily_Extract'[NPI]
			            VAR FirstCase =
			                CALCULATE(
			                    MIN('Daily_Extract'[Final_DateTime - Date]),
			                    'Daily_Extract'[Mosaic Exam Flag] = 1,
			                    ALLEXCEPT('Daily_Extract', 'Daily_Extract'[NPI])
			                )
			
			                var iseligible = NOT(ISBLANK(FirstCase)) && FirstCase <=lastdateincontext - 2
			                var examstartdate = IF(FirstCase > lastdateincontext - 14, FirstCase, lastdateincontext-13)
			            VAR ProviderTotalExams =
			                CALCULATE(
			                    COUNTROWS('Daily_Extract'),
			                    'Daily_Extract'[NPI] = ThisNPI,
			                    'Daily_Extract'[Date] >= examstartdate,
			                    'Daily_Extract'[Date] <= lastdateincontext
			                )
			            VAR ProviderMosaicExams =
			                CALCULATE(
			                    COUNTROWS('Daily_Extract'),
			                    'Daily_Extract'[NPI] = ThisNPI,
			                    'Daily_Extract'[Date] >= examstartdate,
			                    'Daily_Extract'[Date] <= lastdateincontext,
			                    'Daily_Extract'[Mosaic Exam Flag] = 1
			                )
			            VAR PctMosaic = DIVIDE(ProviderMosaicExams, ProviderTotalExams, 0)
			            RETURN
			                iseligible && PctMosaic > 0.8
			        )
			    )
			
			-- Count of eligible providers (deployed 14+ days ago or deployed within the month if less than 14 days)
			VAR DeployedCount =
			    CALCULATE(
			        DISTINCTCOUNT('Daily_Extract'[NPI]),
			        FILTER(
			            SelectedNPIs,
			            VAR FirstCase =
			                CALCULATE(
			                    MIN('Daily_Extract'[Final_DateTime - Date]),
			                    'Daily_Extract'[Mosaic Exam Flag] = 1,
			                    ALLEXCEPT('Daily_Extract', 'Daily_Extract'[NPI])
			                )
			            RETURN NOT ISBLANK(FirstCase) && FirstCase <= lastdateincontext - 2
			        )
			    )
			
			RETURN
			DIVIDE(FullyAdoptedCount, DeployedCount, 0)
		formatString: 0%;-0%;0%
		lineageTag: 2a16129b-c705-4485-a21c-913f6d875e03

	measure TotalRadsLive_ByAdoption_Final2 = ```
			
			VAR SelectedStatuses = VALUES( FullyAdoptedSlicer[Status] )
			VAR ApplySingleStatus = COUNTROWS( SelectedStatuses ) = 1
			VAR SelStatus = IF( ApplySingleStatus, MAX( FullyAdoptedSlicer[Status] ), BLANK() )
			
			RETURN
			SUMX(
			    VALUES( 'Daily_Extract'[NPI] ),   -- iterate only providers visible under current slicers
			    VAR ThisNPI = 'Daily_Extract'[NPI]
			
			    -- does this provider have any mosaic activity in the current visual/filter scope?
			  
			
			        /* First (static) go-live date for the provider (always provider-level, not filtered by current slicers) */
			        VAR FirstCase =
			            CALCULATE(
			                MIN( 'Daily_Extract'[Final_DateTime - Date] ),
			                'Daily_Extract'[Mosaic Exam Flag] = 1,
			                ALLEXCEPT( 'Daily_Extract', 'Daily_Extract'[NPI] )
			            )
			
			        /* provider activity in the last 14 days *within the current slicer scope* */
			        VAR ProviderTotalExams_Last14 =
			            CALCULATE(
			                COUNTROWS( 'Daily_Extract' ),
			                'Daily_Extract'[NPI] = ThisNPI,
			                'Daily_Extract'[Date] > TODAY() - 14,
			                'Daily_Extract'[Date] <= TODAY()
			            )
			        VAR ProviderMosaicExams_Last14 =
			            CALCULATE(
			                COUNTROWS( 'Daily_Extract' ),
			                'Daily_Extract'[NPI] = ThisNPI,
			                'Daily_Extract'[Date] > TODAY() - 14,
			                'Daily_Extract'[Date] <= TODAY(),
			                'Daily_Extract'[Mosaic Exam Flag] = 1
			            )
			
			        VAR PctMosaic = DIVIDE( ProviderMosaicExams_Last14, ProviderTotalExams_Last14, 0 )
			
			        /* eligibility & fully-adopted test */
			        VAR hasgolive = NOT( ISBLANK( FirstCase ) ) 
			        VAR IsFullyAdopted = hasgolive && FirstCase <=TODAY() - 14 && PctMosaic > 0.8
			        var isnotfullyadopted = hasgolive || FirstCase <=TODAY() - 14 || FirstCase > TODAY() -14 || PctMosaic <0.8
			
			        /* selection logic:
			            - if the slicer has no single selection (none or both) => include provider (overall)
			            - if single selection Fully Adopted => count only IsFullyAdopted
			            - if single selection Not Fully Adopted => count providers that are live but NOT fully adopted
			        */
			        RETURN
			        IF(
			            NOT ApplySingleStatus,            -- no single selection or both selected => overall
			            IF( hasgolive ,1,0),
			            IF(
			                SelStatus = "Fully Adopted",
			                IF( IsFullyAdopted, 1, 0 ),
			                IF(
			                    SelStatus = "Not Fully Adopted",
			                    IF( isnotfullyadopted, 1, 0 ),
			                    0   -- fallback: include
			                )
			            )
			        )
			    )
			
			```
		formatString: 0
		lineageTag: 9040372c-7fb6-4342-a8ce-63a73e4ce431

	measure PctFullyAdopteddisclinew = ```
			
			VAR SelectedStatus = VALUES ( FullyAdoptedSlicer[Status] )
			var countsel = COUNTROWS(SelectedStatus)
			var selstatus = IF(countsel = 1, MAX(FullyAdoptedSlicer[Status]), BLANK())
			
			-- core numerator: fully adopted providers
			VAR FullyAdoptedCount =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Daily_Extract'[NPI] ),
			        -- providers deployed 14+ days ago
			        FILTER (
			            VALUES ( 'Daily_Extract'[NPI] ),
			            VAR FirstCase =
			                CALCULATE (
			                    MIN ( 'Daily_Extract'[Final_DateTime - Date] ),
			                    'Daily_Extract'[Mosaic Exam Flag] = 1,
			                    ALLEXCEPT ( 'Daily_Extract', 'Daily_Extract'[NPI] )
			                )
			
			                var dayssincefirst = DATEDIFF(FirstCase, TODAY(), DAY)
			                var startdate = IF(dayssincefirst <14 , FirstCase, TODAY() -14)
			            VAR ProviderTotalExams =
			                CALCULATE (
			                    COUNTROWS ( 'Daily_Extract' ),
			                    'Daily_Extract'[Date] >=startdate,
			                    'Daily_Extract'[Date] <= TODAY()
			                )
			            VAR ProviderMosaicExams =
			                CALCULATE (
			                    COUNTROWS ( 'Daily_Extract' ),
			                    'Daily_Extract'[Date] >= startdate,
			                    'Daily_Extract'[Date] <= TODAY(),
			                    'Daily_Extract'[Mosaic Exam Flag] = 1
			                )
			            VAR PctMosaic = DIVIDE ( ProviderMosaicExams, ProviderTotalExams, 0 )
			            RETURN NOT ISBLANK ( FirstCase ) && dayssincefirst >=2 && PctMosaic > 0.8
			        )
			    )
			
			-- denominator: deployed providers (14+ days)
			VAR DeployedCount =
			    CALCULATE (
			        DISTINCTCOUNT ( 'Daily_Extract'[NPI] ),
			        FILTER (
			            VALUES ( 'Daily_Extract'[NPI] ),
			            VAR FirstCase =
			                CALCULATE (
			                    MIN ( 'Daily_Extract'[Final_DateTime - Date] ),
			                    'Daily_Extract'[Mosaic Exam Flag] = 1,
			                    ALLEXCEPT ( 'Daily_Extract', 'Daily_Extract'[NPI] )
			                )
			                var dayssincefirst = DATEDIFF(FirstCase, TODAY(), DAY)
			            RETURN NOT ISBLANK ( FirstCase ) && dayssincefirst >=2
			        )
			    )
			
			-- base %
			VAR BasePct = DIVIDE ( FullyAdoptedCount, DeployedCount, 0 )
			
			-- slicer interaction
			RETURN
			SWITCH(
			    TRUE(), 
			    selstatus = "Fully Utilizing", 1,
			    selstatus = "Not Fully Utilizing", 0, 
			    TRUE() , BasePct
			)
			```
		formatString: 0%;-0%;0%
		lineageTag: eb489ef7-e034-4dd9-bbb1-acf601def18c

	measure TotalRadsLiverespectingeverything =
			
			
			
			VAR SelectedStatuses = VALUES( FullyAdoptedSlicer[Status] )
			VAR ApplySingleStatus = COUNTROWS( SelectedStatuses ) = 1
			VAR SelStatus = IF( ApplySingleStatus, MAX( FullyAdoptedSlicer[Status] ), BLANK() )
			
			RETURN
			SUMX(
			    VALUES( 'Daily_Extract'[NPI] ),   -- iterate only providers visible under current slicers
			    VAR ThisNPI = 'Daily_Extract'[NPI]
			
			    -- does this provider have any mosaic activity in the current visual/filter scope?
			    VAR HasMosaicInScope =
			        CALCULATE(
			            MAX( 'Daily_Extract'[Mosaic Exam Flag] ),
			            'Daily_Extract'[NPI] = ThisNPI
			        )
			
			    -- if provider has no mosaic rows in the current scope, skip
			    RETURN
			    IF( HasMosaicInScope <> 1, 0,
			
			        /* First (static) go-live date for the provider (always provider-level, not filtered by current slicers) */
			        VAR FirstCase =
			            CALCULATE(
			                MIN( 'Daily_Extract'[Final_DateTime - Date] ),
			                'Daily_Extract'[Mosaic Exam Flag] = 1,
			                ALLEXCEPT( 'Daily_Extract', 'Daily_Extract'[NPI] )
			            )
			
			           var dayssincefirstcase = DATEDIFF(FirstCase, TODAY(), DAY)
			           var lookbackdays = MIN(14, dayssincefirstcase)
			
			        /* provider activity in the last 14 days *within the current slicer scope* */
			        VAR ProviderTotalExams_Last14 =
			            CALCULATE(
			                COUNTROWS( 'Daily_Extract' ),
			                'Daily_Extract'[NPI] = ThisNPI,
			                'Daily_Extract'[Date] > TODAY() - lookbackdays,
			                'Daily_Extract'[Date] <= TODAY()
			            )
			        VAR ProviderMosaicExams_Last14 =
			            CALCULATE(
			                COUNTROWS( 'Daily_Extract' ),
			                'Daily_Extract'[NPI] = ThisNPI,
			                'Daily_Extract'[Date] > TODAY() - lookbackdays,
			                'Daily_Extract'[Date] <= TODAY(),
			                'Daily_Extract'[Mosaic Exam Flag] = 1
			            )
			
			        VAR PctMosaic = DIVIDE( ProviderMosaicExams_Last14, ProviderTotalExams_Last14, 0 )
			
			        /* eligibility & fully-adopted test */
			        VAR IsEligible = NOT( ISBLANK( FirstCase ) ) && FirstCase <= TODAY() - 2
			        VAR IsFullyAdopted = IsEligible && PctMosaic > 0.8
			
			        /* selection logic:
			            - if the slicer has no single selection (none or both) => include provider (overall)
			            - if single selection Fully Adopted => count only IsFullyAdopted
			            - if single selection Not Fully Adopted => count providers that are live but NOT fully adopted
			        */
			        RETURN
			        IF(
			            NOT ApplySingleStatus,            -- no single selection or both selected => overall
			            1,
			            IF(
			                SelStatus = "Fully Utilizing",
			                IF( IsFullyAdopted, 1, 0 ),
			                IF(
			                    SelStatus = "Not Fully Utilizing",
			                    IF( NOT IsFullyAdopted, 1, 0 ),
			                    1   -- fallback: include
			                )
			            )
			        )
			    )
			)
		formatString: 0
		lineageTag: 87499399-dd56-4248-af7b-42ac404ba7e6

	measure %reportingadj = ```
			
			
			var firstcasedate = 
			CALCULATE(MIN('Daily_Extract'[Final_DateTime - Date]), 
			'Daily_Extract'[Mosaic Exam Flag] = 1, 
			ALLEXCEPT('Daily_Extract', 'Daily_Extract'[NPI])
			)
			
			var dayssincefirstcase = DATEDIFF(firstcasedate, TODAY() , DAY)
			
			var windowstart = 
			IF(dayssincefirstcase <14, firstcasedate, TODAY() - 14)
			
			var totalexxamswindow = 
			CALCULATE(COUNTROWS('Daily_Extract'), 'Daily_Extract'[Date] >=windowstart, 
			'Daily_Extract'[Date] <=TODAY()
			)
			
			
			var mosaicexamswindow = 
			CALCULATE(COUNTROWS('Daily_Extract'), 'Daily_Extract'[Date] >=windowstart, 'Daily_Extract'[Date] <=TODAY() , 'Daily_Extract'[Mosaic Exam Flag] = 1
			)
			
			RETURN
			DIVIDE(mosaicexamswindow, totalexxamswindow, 0)
			```
		formatString: 0%;-0%;0%
		lineageTag: 42d7c7ee-827d-4ade-bece-ac87bc1c5930

