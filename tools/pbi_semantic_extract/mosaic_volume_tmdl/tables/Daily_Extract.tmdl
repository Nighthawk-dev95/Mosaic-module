	column 'USME Eligible exam' = ```
			
			VAR PracticeGoLiveDate = 
			    LOOKUPVALUE(
			        'vrarp_launchmodel'[Model Go-Live Date],
			        'vrarp_launchmodel'[Practice], 'Daily_Extract'[Local Practice]  // Adjust field names
			    )
			VAR ExamDate = 'Daily_Extract'[Date]
			VAR HasUSMERPID = NOT(ISBLANK('Daily_Extract'[USMERPID]))
			VAR IsAfterGoLive = IF(NOT(ISBLANK(PracticeGoLiveDate)), ExamDate >= PracticeGoLiveDate, FALSE)
			RETURN
			    IF(
			        HasUSMERPID && IsAfterGoLive,
			        1,
			        0
			    )
			```
		formatString: 0
		lineageTag: d69cce82-4652-4761-a5e9-9d4a7449d7f0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Drafting Enabled' = ```
			
			VAR HasCXR = NOT(ISBLANK(RELATED(VRARP_radpipeline[Added to AD Group (CXR/ABD/MSK)])))
			VAR HasCT = NOT(ISBLANK(RELATED(VRARP_radpipeline[Added to AD Group (CT Head)])))
			var Hasctabd = NOT(ISBLANK(RELATED(vrarp_radpipeline[Added to AD Group (CT Abd/Pelvis)])))
			RETURN
			    SWITCH(
			        TRUE(),
			       
			        HasCXR, "Rads on XR Drafting",
			        HasCT, "Rads on CT Head Drafting",
			        Hasctabd , "Rads on CT Abd/Pel Drafting", 
			        "Rads Not on Drafting"
			    )
			```
		lineageTag: 0dc398d8-4a2d-4248-a440-15d17bf2383e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Procedure = Daily_Extract[Clinical_Procedure_Description] & " - " & Daily_Extract[Clinical_Procedure_Code]
		lineageTag: d0e5c5e5-ebbb-4bf5-aab5-8985d8f82419
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Week of First Mosaic Case' = ```
			
			VAR CurrentProvider = 'Daily_Extract'[Provider]
			VAR FirstMosaicDate = 
			    CALCULATE(
			        MIN('Daily_Extract'[Final_DateTime - Date]),
			        ALL('Daily_Extract'),
			        'Daily_Extract'[Provider] = CurrentProvider,
			        'Daily_Extract'[Mosaic Exam Flag] = 1
			    )
			VAR WeekStart = 
			    IF(
			        NOT(ISBLANK(FirstMosaicDate)),
			        FirstMosaicDate - WEEKDAY(FirstMosaicDate, 2) + 1,
			        BLANK()
			    )
			RETURN
			    WeekStart
			```
		formatString: Short Date
		lineageTag: bf19e8b4-fe66-487a-a92b-808af8db614c
		summarizeBy: none

		changedProperty = DataType

