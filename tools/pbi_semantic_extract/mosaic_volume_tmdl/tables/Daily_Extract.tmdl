	measure 'Last Drafted Exam Date' =
			
			CALCULATE(
			    MAX('Daily_Extract'[Date]),
			    'Daily_Extract'[mosaic_draft_flag] = 1
			)
		formatString: General Date
		lineageTag: c27c39eb-7814-4a4d-a779-1536b839eeb7

	measure 'Has Drafted But Not On Drafting' = ```
			
			VAR Last7Days = TODAY() - 7
			VAR CurrentNPI = MAX('Daily_Extract'[Provider_NPI])
			
			VAR IsNotOnDrafting = 
			    CALCULATE(MAX('Daily_Extract'[Is On XR Drafting]), 'Daily_Extract'[Provider_NPI] = CurrentNPI) = 0 &&
			    CALCULATE(MAX('Daily_Extract'[Is On CT Head Drafting]), 'Daily_Extract'[Provider_NPI] = CurrentNPI) = 0 &&
			    CALCULATE(MAX('Daily_Extract'[Is On CT Abd/Pel Drafting]), 'Daily_Extract'[Provider_NPI] = CurrentNPI) = 0 &&
			    CALCULATE(MAX('Daily_Extract'[Is On CT Chest Drafting]), 'Daily_Extract'[Provider_NPI] = CurrentNPI) = 0
			
			VAR HasRecentDraftedExams = 
			    CALCULATE(
			        SUM('Daily_Extract'[mosaic_draft_flag]),
			        'Daily_Extract'[Provider_NPI] = CurrentNPI,
			        'Daily_Extract'[Date] >= Last7Days
			    ) > 0
			
			RETURN IF(IsNotOnDrafting && HasRecentDraftedExams, 1, 0)
			```
		formatString: 0
		lineageTag: 22ba898f-22e9-4344-9df4-5a5a9836f7f2

	measure 'In Pipeline Table' =
			
			IF(
			    ISBLANK(
