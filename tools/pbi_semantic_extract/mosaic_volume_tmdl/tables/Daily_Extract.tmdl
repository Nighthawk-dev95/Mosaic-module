	measure 'Test - Not On Drafting But Has Drafted Exams' = ```
			
			FILTER(
			    VALUES('Daily_Extract'[NPI]),
			    VAR CurrentNPI = 'Daily_Extract'[NPI]
			    VAR IsXR = CALCULATE(MAX('Daily_Extract'[Is On XR Drafting]), 'Daily_Extract'[NPI] = CurrentNPI) = 1
			    VAR IsCTHead = CALCULATE(MAX('Daily_Extract'[Is On CT Head Drafting]), 'Daily_Extract'[NPI] = CurrentNPI) = 1
			    VAR IsCTAbd = CALCULATE(MAX('Daily_Extract'[Is On CT Abd/Pel Drafting]), 'Daily_Extract'[NPI] = CurrentNPI) = 1
			    VAR IsCTChest = CALCULATE(MAX('Daily_Extract'[Is On CT Chest Drafting]), 'Daily_Extract'[NPI] = CurrentNPI) = 1
			    VAR IsNotOnDrafting = NOT(IsXR) && NOT(IsCTHead) && NOT(IsCTAbd) && NOT(IsCTChest)
			    VAR HasDraftedExams = 
			        CALCULATE(
			            SUM('Daily_Extract'[mosaic_draft_flag]),
			            'Daily_Extract'[NPI] = CurrentNPI
			        ) > 0
			    RETURN IsNotOnDrafting && HasDraftedExams
			)
			```
		lineageTag: f8af037e-8cdf-465c-88bc-718b25ee31c0

	measure 'Rads Not On Drafting With Drafted Exams' = ```
			
			VAR Last7Days = TODAY() - 7
			
			RETURN
			COUNTROWS(
			    FILTER(
			        VALUES('Daily_Extract'[NPI]),
			        VAR CurrentNPI = 'Daily_Extract'[NPI]
			        VAR IsNotOnDrafting = 
			            CALCULATE(MAX('Daily_Extract'[Is On XR Drafting]), 'Daily_Extract'[NPI] = CurrentNPI) = 0 &&
			            CALCULATE(MAX('Daily_Extract'[Is On CT Head Drafting]), 'Daily_Extract'[NPI] = CurrentNPI) = 0 &&
			            CALCULATE(MAX('Daily_Extract'[Is On CT Abd/Pel Drafting]), 'Daily_Extract'[NPI] = CurrentNPI) = 0 &&
			            CALCULATE(MAX('Daily_Extract'[Is On CT Chest Drafting]), 'Daily_Extract'[NPI] = CurrentNPI) = 0
			        VAR HasRecentDraftedExams = 
			            CALCULATE(
			                SUM('Daily_Extract'[mosaic_draft_flag]),
			                'Daily_Extract'[NPI] = CurrentNPI,
			                'Daily_Extract'[Date] >= Last7Days
			            ) > 0
			        RETURN IsNotOnDrafting && HasRecentDraftedExams
			    )
			)
			```
		formatString: 0
		lineageTag: 00488bae-dc2f-4cbf-a0fb-774b0d787470

	measure 'AD Group XR Date' =
			
			CALCULATE(
			    MAX(vrarp_radpipeline[Added to AD Group (CXR/ABD/MSK)]),
			    FILTER(vrarp_radpipeline, vrarp_radpipeline[NPI] = MAX('Daily_Extract'[Provider_NPI]))
