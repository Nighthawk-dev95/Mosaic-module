		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Week_Rank2 = ```
			
			VAR q1 = FORMAT('Daily_Extract'[Weekstart], "YYYYMMDD")
			VAR q2 = FORMAT(TODAY(), "YYYYMMDD")
			VAR MaxRank = MAXX(ALL('Daily_Extract'), FORMAT('Daily_Extract'[Weekstart], "YYYYMMDD"))
			RETURN 
			    IF(
			        q1 - q2 < 0,
			        ABS(q1 - q2) + MaxRank,
			        q1 - q2
			    )
			```
		lineageTag: f3a1fd97-ef03-42d3-b8fd-700044784888
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Month_Rank2 = ```
			
			VAR q1 = FORMAT('Daily_Extract'[Startofmonth], "YYYYMMDD")
			VAR q2 = FORMAT(TODAY(), "YYYYMMDD")
			VAR MaxRank = MAXX(ALL('Daily_Extract'), FORMAT('Daily_Extract'[Startofmonth], "YYYYMMDD"))
			RETURN 
			    IF(
			        q1 - q2 < 0,
			        ABS(q1 - q2) + MaxRank,
			        q1 - q2
			    )
			```
		lineageTag: 1898943b-d36a-4031-a7ad-d8c48d652005
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column DRSO = ```
			
			VAR CurrentDay = TODAY()
			VAR ThisDay = 'Daily_Extract'[Final_DateTime - Date]
			VAR MaxDay = CALCULATE(MAX('Daily_Extract'[Final_DateTime - Date]), ALL('Daily_Extract'))
			RETURN
			    IF(
			        ThisDay > CurrentDay,
			        DATEDIFF(CurrentDay, ThisDay, DAY),
			        DATEDIFF(ThisDay, CurrentDay, DAY) + DATEDIFF(CurrentDay, MaxDay, DAY)
			    )
			
			```
		lineageTag: d2556f64-81f9-43fe-8b50-06dcb99fc3e5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

