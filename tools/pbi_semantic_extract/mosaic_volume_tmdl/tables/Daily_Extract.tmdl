			    'Daily_Extract'[Place Of Service] = "On Campus-Outpatient Hospital" && "Outpatient" in selectedpos, true(), 
			    'Daily_Extract'[Place Of Service] = "UNK" && "Outpatient" in selectedpos, TRUE(), 
			    'Daily_Extract'[Place Of Service] = "Urgent Care Facility" && "Outpatient" in selectedpos, TRUE(), 
			    'Daily_Extract'[Place Of Service] = "N/A" && "Inpatient" in selectedpos, TRUE(), 
