	measure '% Practice IR in Mosaic (Last 2w)' = ```
			
			VAR Last2WeeksStart = TODAY() - 14
			
			VAR PracticeIRTotal = 
			    CALCULATE(
			        COUNTROWS('Daily_Extract'),
			        'Daily_Extract'[Modality] = "IR",
			        'Daily_Extract'[Final_DateTime - Date] >= Last2WeeksStart,
			        'Daily_Extract'[Final_DateTime - Date] <= TODAY()
			    )
			
			VAR PracticeIRInMosaic = 
			    CALCULATE(
			        COUNTROWS('Daily_Extract'),
