	measure 'First Mosaic Case' =
			
			VAR CurrentNPI = MAX('Daily_Extract'[NPI])
			VAR CurrentProvider = MAX('Daily_Extract'[Provider])
			
			RETURN
			    IF(
			        NOT(ISBLANK(CurrentNPI)),
			        CALCULATE(
			            MIN('Daily_Extract'[Final_DateTime - Date]),
			            ALLSELECTED('Daily_Extract'),  // Keeps all filters EXCEPT what we remove below
			            ALL('Daily_Extract'[Date]),
			            ALL('Daily_Extract'[Month]),
			            ALL('Daily_Extract'[Final_DateTime - Date]),
			            ALL('Daily_Extract'[Week_Of]),
			            'Daily_Extract'[NPI] = CurrentNPI,
			            'Daily_Extract'[Mosaic Exam Flag] = 1
			        ),
			        IF(
			            NOT(ISBLANK(CurrentProvider)),
			            CALCULATE(
			                MIN('Daily_Extract'[Final_DateTime - Date]),
			                ALLSELECTED('Daily_Extract'),
			                ALL('Daily_Extract'[Date]),
			                ALL('Daily_Extract'[Month]),
			                ALL('Daily_Extract'[Final_DateTime - Date]),
			                ALL('Daily_Extract'[Week_Of]),
			                'Daily_Extract'[Provider] = CurrentProvider,
			                'Daily_Extract'[Mosaic Exam Flag] = 1
			            ),
			            BLANK()
			        )
			    )
		formatString: Short Date
		lineageTag: 784fc495-70e2-460e-a98c-3ebd9e5a61e4

	measure 'first case' = ```
			calculate ( min ('Daily_Extract'[Final_DateTime - Date]), filter ( 'Daily_Extract','Daily_Extract'[Mosaic Exam Flag] = 1 ), 
			removefilters('Daily_Extract') ,removefilters('Date Selector') , removefilters('DataRefresh') , removefilters ('MODEL POWERBI_USER_FILTERS'), removefilters(Hour_order) , removefilters('RLSTeamTable'), removefilters( 'Metrictypeselector'), removefilters ('Mini_practice_directory') , removefilters('Mosaic Metric') , removefilters ('Mosaic Exam Count Table') ,  removefilters ('Daily_Extract'[Team]),
			removefilters('Daily_Extract'[Date]), removefilters('Daily_Extract'[Date Range Shown]),
			
			
			allexcept('Daily_Extract','Daily_Extract'[Provider])
			
			)
			
			```
		formatString: Short Date
		lineageTag: ca426b67-66cd-4d0a-88df-86464595b134

