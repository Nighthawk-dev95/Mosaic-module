	refreshPolicy
		policyType: basic
		rollingWindowGranularity: month
		rollingWindowPeriods: 24
		incrementalGranularity: day
		incrementalPeriods: 7
		sourceExpression = ```
			let
			    // Step 1: Create dynamic SQL filter clause
			    FilterClause = if LoadFullData then 
			        // Production mode - use RangeStart and RangeEnd for incremental refresh
			        " WHERE Calendar_Date >= DATE('" & Date.ToText(DateTime.Date(RangeStart), "yyyy-MM-dd") & "') " &
			        " AND Calendar_Date < DATE('" & Date.ToText(DateTime.Date(RangeEnd), "yyyy-MM-dd") & "')"
			    else 
			        // Desktop mode - load last 10 days only
			        " WHERE Calendar_Date >= CURRENT_DATE - INTERVAL 10 DAYS",
			
			    // Step 2: Load CLEAN data from Databricks (now deduplicated at source)
			    // NOTE: Deduplication now happens in the view itself via ROW_NUMBER
			    Source = Value.NativeQuery(
			        Databricks.Catalogs("adb-7306149455716415.15.azuredatabricks.net", "/sql/1.0/warehouses/fe0ad987563c672a", 
			        [Catalog="edw_dev", Database=null, EnableAutomaticProxyDiscovery=null]){[Name="edw_dev",Kind="Database"]}[Data],
			        "SELECT * FROM edw_dev.bipa_analytics.presentation_mosaicdailyvolume_vw" & FilterClause,
			        null,
			        [EnableFolding=true]
			    ),
			
			    // Step 3: Continue with your transformations (NO deduplication needed)
			    #"Renamed Columns" = Table.RenameColumns(Source,{{"Case_Count", "Exam Ct"}, {"modality_code", "Modality"}, {"Available_To_MD_Date", "Available To MD"}, {"Radiologist", "Provider"}}),
			    #"Duplicated Column" = Table.DuplicateColumn(#"Renamed Columns", "Available To MD", "Available To MD - Copy"),
			    #"Split Column by Delimiter" = Table.SplitColumn(Table.TransformColumnTypes(#"Duplicated Column", {{"Available To MD - Copy", type text}}, "en-US"), "Available To MD - Copy", Splitter.SplitTextByEachDelimiter({" "}, QuoteStyle.Csv, false), {"Available To MD - Copy.1", "Available To MD - Copy.2"}),
			    #"Changed Type" = Table.TransformColumnTypes(#"Split Column by Delimiter",{{"Available To MD - Copy.1", type date}, {"Available To MD - Copy.2", type time}}),
			    #"Duplicated Column1" = Table.DuplicateColumn(#"Changed Type", "Final_DateTime", "Final_DateTime - Copy"),
			    #"Renamed Columns1" = Table.RenameColumns(#"Duplicated Column1",{{"Available To MD - Copy.1", "Available To MD - Date"}, {"Available To MD - Copy.2", "Available To MD - Time"}}),
			    #"Split Column by Delimiter1" = Table.SplitColumn(Table.TransformColumnTypes(#"Renamed Columns1", {{"Final_DateTime - Copy", type text}}, "en-US"), "Final_DateTime - Copy", Splitter.SplitTextByEachDelimiter({" "}, QuoteStyle.Csv, false), {"Final_DateTime - Copy.1", "Final_DateTime - Copy.2"}),
			    #"Changed Type1" = Table.TransformColumnTypes(#"Split Column by Delimiter1",{{"Final_DateTime - Copy.1", type date}, {"Final_DateTime - Copy.2", type time}}),
			    #"Renamed Columns2" = Table.RenameColumns(#"Changed Type1",{{"Final_DateTime - Copy.1", "Final_DateTime - Date"}, {"Final_DateTime - Copy.2", "Final- Time"}, {"Available To MD - Time", "Available  Time"}, {"Practice_Short_Name", "Practice"}, {"Sub_Practice_Short_Name", "Sub-Practice"}, {"Location_Name", "Site"}, {"Calendar_Date", "Date"}, {"Month_Num", "Month"}}),
			    #"Renamed Columns3" = Table.RenameColumns(#"Renamed Columns2",{{"local_practice_short_name", "Local Practice"}, {"local_practice_division", "Local Practice Division"}, {"Mosaic_flag", "Mosaic Exam Flag"}, {"Linked_Charge_Flag", "Linked Charge Flag"}, {"Place_Of_Service_Name", "Place Of Service"}}),
			    #"Removed Columns" = Table.RemoveColumns(#"Renamed Columns3",{"Yesterday", "Tertiary_Subspecialty", "Termination", "Suffix", "Home_Phone", "Work_Phone", "Cell_Phone", "Provider_name_format1", "Useage", "Middle_Name", "First_Name", "Last_Name", "FTE % (other than 100%)", "Missing_RAD_Flag", "physician_day", "Resident/Fellow", "hour", "Employment_Status_Change_Date", "Day_Of_Week_Number", "Hire_Date", "Week_End_Date", "Time_Hour", "Client_System", "30_min_flag", "Emergency_Room",  "Credential", "Ind_Contractor", "Patient_MRN", "UKG_ID", "Associate_ID"}),
			    #"Changed Type2" = Table.TransformColumnTypes(#"Removed Columns",{{"Date", type date}}),
			    #"Added Custom" = Table.AddColumn(#"Changed Type2", "Startofmonth", each Date.StartOfMonth([Date])),
			    #"Changed Type3" = Table.TransformColumnTypes(#"Added Custom",{{"Startofmonth", type date}}),
			    #"Added Custom1" = Table.AddColumn(#"Changed Type3", "Weekstart", each Date.AddDays([Date],1 - Date.DayOfWeek([Date], Day.Sunday))),
			    #"Changed Type4" = Table.TransformColumnTypes(#"Added Custom1",{{"Weekstart", type date}}),
			    #"Added Custom2" = Table.AddColumn(#"Changed Type4", "Week_Of", each Date.AddDays([Date] ,1-Date.DayOfWeek([Date]))),
			    #"Changed Type5" = Table.TransformColumnTypes(#"Added Custom2",{{"Week_Of", type date}}),
			    #"Added Custom3" = Table.AddColumn(#"Changed Type5", "RANK", each Duration.Days([#"Final_DateTime - Date"] - DateTime.Date(DateTime.LocalNow()))),
			    #"Duplicated Column2" = Table.DuplicateColumn(#"Added Custom3", "Final_DateTime - Date", "Final_DateTime - Date - Copy"),
			    #"Removed Columns1" = Table.RemoveColumns(#"Duplicated Column2",{"Date"}),
