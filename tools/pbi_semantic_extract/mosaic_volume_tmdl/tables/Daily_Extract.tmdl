			        ALL('Daily_Extract'),
			        'Daily_Extract'[NPI] = CurrentNPI,
			        'Daily_Extract'[Modality] = "CR",
			        NOT(ISBLANK('Daily_Extract'[drafteligibleproc])),
			        'Daily_Extract'[Mosaic Exam Flag] = 1,
			        'Daily_Extract'[Final_DateTime - Date] >= windowstart,
