	measure 'Provider Count RSS' = ```
			
			VAR SelectedWeeks = VALUES('Daily_Extract'[Week of First Mosaic Case])
			VAR IsBlankSelected = 
			    COUNTROWS(
			        FILTER(SelectedWeeks, ISBLANK('Daily_Extract'[Week of First Mosaic Case]))
			    ) > 0
			VAR HasSpecificWeeks = 
			    COUNTROWS(
			        FILTER(SelectedWeeks, NOT(ISBLANK('Daily_Extract'[Week of First Mosaic Case])))
			    ) > 0
			VAR IsWeekFiltered = ISFILTERED('Daily_Extract'[Week of First Mosaic Case])
			
			-- Drafting Group Logic
			VAR SelectedGroups = VALUES('Drafting Groups'[Drafting Group])
			VAR IsDraftingFiltered = ISFILTERED('Drafting Groups'[Drafting Group])
			VAR AllGroupsSelected = COUNTROWS(SelectedGroups) = 6  -- ✅ Updated to 6
			VAR ShowXR =           COUNTROWS(FILTER(SelectedGroups, [Drafting Group] = "Rads on XR Drafting")) > 0
			VAR ShowCTHead =       COUNTROWS(FILTER(SelectedGroups, [Drafting Group] = "Rads on CT Head Drafting")) > 0
			VAR ShowCTAbd =        COUNTROWS(FILTER(SelectedGroups, [Drafting Group] = "Rads on CT Abd/Pel Drafting")) > 0
			VAR ShowCTChest =      COUNTROWS(FILTER(SelectedGroups, [Drafting Group] = "Rads on CT Chest Drafting")) > 0
			VAR ShowNotOnDraft =   COUNTROWS(FILTER(SelectedGroups, [Drafting Group] = "Rads Not on Drafting")) > 0
			VAR ShowPrevious =     COUNTROWS(FILTER(SelectedGroups, [Drafting Group] = "Previously on Drafting")) > 0
			
			-- Threshold Logic
			VAR SelectedThreshold = 
			    COALESCE(
			        CALCULATE(MAX('ThresholdSlicer'[Threshold]), ALLSELECTED('ThresholdSlicer')),
			        0
			    )
			VAR IsThresholdFiltered = SelectedThreshold > 0
			
			-- Utilizing >90% Logic
			VAR SelectedUtilizing = SELECTEDVALUE('Utilizing 90 Filter'[Utilizing >90%])
			VAR IsUtilizingFiltered = NOT(ISBLANK(SelectedUtilizing))
			
			-- DraftingEligibleNPIs with updated logic
			VAR DraftingEligibleNPIs =
			    FILTER(
			        VALUES('Daily_Extract'[NPI]),
			        VAR CurrentNPI = 'Daily_Extract'[NPI]
			        VAR IsXR = 
			            CALCULATE(MAX('Daily_Extract'[Is On XR Drafting]), 'Daily_Extract'[NPI] = CurrentNPI) = 1
			        VAR IsCTHead = 
			            CALCULATE(MAX('Daily_Extract'[Is On CT Head Drafting]), 'Daily_Extract'[NPI] = CurrentNPI) = 1
			        VAR IsCTAbd = 
			            CALCULATE(MAX('Daily_Extract'[Is On CT Abd/Pel Drafting]), 'Daily_Extract'[NPI] = CurrentNPI) = 1
			        VAR IsCTChest = 
			            CALCULATE(MAX('Daily_Extract'[Is On CT Chest Drafting]), 'Daily_Extract'[NPI] = CurrentNPI) = 1
			
			        -- Not in any current group
			        VAR NotInAnyGroup = 
			            NOT(IsXR) && NOT(IsCTHead) && NOT(IsCTAbd) && NOT(IsCTChest)
			
			        -- Has any drafted cases historically
			        VAR HasDraftedCases = 
			            CALCULATE(
			                SUM('Daily_Extract'[mosaic_draft_flag]),
			                'Daily_Extract'[NPI] = CurrentNPI
			            ) > 0
			
			        -- Previously on drafting: not in any group now BUT has drafted cases
			        VAR IsPrevious = NotInAnyGroup && HasDraftedCases
			
			        -- Truly not on drafting: not in any group AND no drafted cases ever
			        VAR IsNone = NotInAnyGroup && NOT(HasDraftedCases)
			
			        RETURN
			            (ShowXR && IsXR) ||
			            (ShowCTHead && IsCTHead) ||
			            (ShowCTAbd && IsCTAbd) ||
			            (ShowCTChest && IsCTChest) ||
			            (ShowPrevious && IsPrevious) ||
			            (ShowNotOnDraft && IsNone)
			    )
			
			-- Base NPI list applying Threshold + Utilizing filters
			VAR FilteredNPIs =
			    FILTER(
			        VALUES('Daily_Extract'[NPI]),
			        VAR CurrentNPI = 'Daily_Extract'[NPI]
			        VAR RadTotalExams = 
			            CALCULATE(
			                SUM('Daily_Extract'[Exam Ct]),
			                'Daily_Extract'[NPI] = CurrentNPI
			            )
			        VAR RadPctMosaic = 
			            CALCULATE(
			                [% Mosaic Exams],
			                'Daily_Extract'[NPI] = CurrentNPI
			            )
			        VAR PassesThreshold = RadTotalExams >= SelectedThreshold
			        VAR PassesUtilizing = 
			            IF(
			                ISBLANK(SelectedUtilizing), TRUE(),
			                IF(
			                    SelectedUtilizing = "Yes - Above 90%",
			                    RadPctMosaic >= 0.9,
			                    RadPctMosaic < 0.9
			                )
			            )
			        RETURN PassesThreshold && PassesUtilizing
			    )
			
			-- Combined NPI list: Drafting + Threshold + Utilizing
			VAR DraftingAndFilteredNPIs =
			    FILTER(
			        DraftingEligibleNPIs,
			        VAR CurrentNPI = 'Daily_Extract'[NPI]
			        VAR RadTotalExams = 
			            CALCULATE(
			                SUM('Daily_Extract'[Exam Ct]),
			                'Daily_Extract'[NPI] = CurrentNPI
			            )
			        VAR RadPctMosaic = 
			            CALCULATE(
			                [% Mosaic Exams],
			                'Daily_Extract'[NPI] = CurrentNPI
			            )
			        VAR PassesThreshold = RadTotalExams >= SelectedThreshold
			        VAR PassesUtilizing = 
			            IF(
			                ISBLANK(SelectedUtilizing), TRUE(),
			                IF(
			                    SelectedUtilizing = "Yes - Above 90%",
			                    RadPctMosaic >= 0.9,
			                    RadPctMosaic < 0.9
			                )
			            )
			        RETURN PassesThreshold && PassesUtilizing
			    )
			
			RETURN
			    SWITCH(
			        TRUE(),
			        // No filters applied - show ALL radiologists
			        NOT(IsWeekFiltered) && NOT(IsDraftingFiltered) && NOT(IsThresholdFiltered) && NOT(IsUtilizingFiltered),
			            CALCULATE(
			                DISTINCTCOUNT('Daily_Extract'[NPI]),
			                ALLSELECTED('Daily_Extract')
			            ),
			
			        // Only Threshold and/or Utilizing filters
			        NOT(IsWeekFiltered) && NOT(IsDraftingFiltered),
			            COUNTROWS(FilteredNPIs),
			
			        // Only Drafting filter (with Threshold + Utilizing)
			        IsDraftingFiltered && NOT(IsWeekFiltered),
			            IF(
			                AllGroupsSelected,
			                COUNTROWS(FilteredNPIs),
			                COUNTROWS(DraftingAndFilteredNPIs)
			            ),
			
			        // Only Week filter (with Threshold + Utilizing)
			        IsWeekFiltered && NOT(IsDraftingFiltered),
			            SWITCH(
			                TRUE(),
			                IsBlankSelected && NOT(HasSpecificWeeks),
			                    COUNTROWS(
			                        FILTER(
			                            FilteredNPIs,
			                            VAR CurrentNPI = 'Daily_Extract'[NPI]
			                            RETURN
			                                CALCULATE(
			                                    ISBLANK(MAX('Daily_Extract'[Week of First Mosaic Case])),
			                                    'Daily_Extract'[NPI] = CurrentNPI
			                                )
			                        )
			                    ),
			                COUNTROWS(FilteredNPIs)
			            ),
			
			        // Week + Drafting (with Threshold + Utilizing)
			        IsWeekFiltered && IsDraftingFiltered,
			            SWITCH(
			                TRUE(),
			                IsBlankSelected && NOT(HasSpecificWeeks),
			                    COUNTROWS(
			                        FILTER(
			                            DraftingAndFilteredNPIs,
			                            VAR CurrentNPI = 'Daily_Extract'[NPI]
			                            RETURN
			                                CALCULATE(
			                                    ISBLANK(MAX('Daily_Extract'[Week of First Mosaic Case])),
			                                    'Daily_Extract'[NPI] = CurrentNPI
			                                )
			                        )
			                    ),
			                COUNTROWS(DraftingAndFilteredNPIs)
			            ),
			
			        // Default fallback
			        CALCULATE(
			            DISTINCTCOUNT('Daily_Extract'[NPI]),
			            ALLSELECTED('Daily_Extract')
			        )
			    )
			```
		formatString: 0
		lineageTag: d207f759-c194-41d5-8148-abe8bbc0e6f4

	measure 'Practice Count' = ```
			
			VAR SelectedWeeks = VALUES('Daily_Extract'[Week of First Mosaic Case])
			VAR IsBlankSelected = 
			    COUNTROWS(
			        FILTER(SelectedWeeks, ISBLANK('Daily_Extract'[Week of First Mosaic Case]))
			    ) > 0
			VAR HasSpecificWeeks = 
			    COUNTROWS(
			        FILTER(SelectedWeeks, NOT(ISBLANK('Daily_Extract'[Week of First Mosaic Case])))
			    ) > 0
			VAR sel = ISFILTERED('Daily_Extract'[Week of First Mosaic Case])
			
			RETURN
			    SWITCH(
			        TRUE(),
			        NOT(sel),
			            // No filter applied - show ALL practices (Mosaic + Non-Mosaic)
			            CALCULATE(
			                DISTINCTCOUNT('Daily_Extract'[Local Practice]),
			                ALLSELECTED('Daily_Extract')
			            ),
			        IsBlankSelected && NOT(HasSpecificWeeks),
			            // Only blank selected - show practices with rads NOT on Mosaic
			            CALCULATE(
			                DISTINCTCOUNT('Daily_Extract'[Local Practice]),
			                ISBLANK('Daily_Extract'[Week of First Mosaic Case]),
			                ALLSELECTED('Daily_Extract')
			            ),
			        HasSpecificWeeks && NOT(IsBlankSelected),
			            // Only specific weeks selected - show practices with rads on Mosaic in those weeks
			            CALCULATE(
			                DISTINCTCOUNT('Daily_Extract'[Local Practice]),
			                Daily_Extract[Mosaic Exam Flag] = 1,
			                NOT(ISBLANK('Daily_Extract'[Week of First Mosaic Case])),
			                ALLSELECTED('Daily_Extract')
			            ),
			        // Both blank and specific weeks selected
			        CALCULATE(
			            DISTINCTCOUNT('Daily_Extract'[Local Practice]),
			            ALLSELECTED('Daily_Extract')
			        )
			    )
			```
		formatString: 0
		lineageTag: 6120cd03-6841-4e28-ab9f-b884475c0efc

