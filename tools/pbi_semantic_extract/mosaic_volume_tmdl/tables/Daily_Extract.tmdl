	measure %reportingadjagnostic = ```
			
			VAR CurrentNPI = SELECTEDVALUE('Daily_Extract'[NPI])
			
			VAR firstcasedate = 
			    CALCULATE(
			        MIN('Daily_Extract'[Final_DateTime - Date]), 
			        ALL('Daily_Extract'),
			        'Daily_Extract'[NPI] = CurrentNPI,
			        'Daily_Extract'[Mosaic Exam Flag] = 1
			    )
			
			VAR dayssincefirstcase = DATEDIFF(firstcasedate, TODAY(), DAY)
			
			VAR windowstart = 
			    IF(dayssincefirstcase < 14, firstcasedate, TODAY() - 14)
			
			VAR totalexxamswindow = 
			    CALCULATE(
			        COUNTROWS('Daily_Extract'), 
			        ALL('Daily_Extract'),
			        'Daily_Extract'[NPI] = CurrentNPI,
			        'Daily_Extract'[Final_DateTime - Date] >= windowstart, 
			        'Daily_Extract'[Final_DateTime - Date] <= TODAY()
			    )
			
			VAR mosaicexamswindow = 
			    CALCULATE(
			        COUNTROWS('Daily_Extract'), 
			        ALL('Daily_Extract'),
			        'Daily_Extract'[NPI] = CurrentNPI,
			        'Daily_Extract'[Final_DateTime - Date] >= windowstart, 
			        'Daily_Extract'[Final_DateTime - Date] <= TODAY(), 
			        'Daily_Extract'[Mosaic Exam Flag] = 1
			    )
			
			RETURN
			    DIVIDE(mosaicexamswindow, totalexxamswindow, 0)
			```
		formatString: 0%;-0%;0%
		lineageTag: a52751e8-fc9d-42a9-b08d-09d81d2f01e7

