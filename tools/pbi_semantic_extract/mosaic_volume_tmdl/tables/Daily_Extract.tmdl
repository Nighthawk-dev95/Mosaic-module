	measure totalradslive = ```
			
			
			
			VAR SelectedStatuses = VALUES(FullyAdoptedSlicer[Status])
			
			RETURN
			
			CALCULATE(DISTINCTCOUNT('Daily_Extract'[NPI]),
			
			'Daily_Extract'[Mosaic Exam Flag] = 1,
			
			FILTER(
			
			    ALLSELECTED('Daily_Extract'[NPI]),
			
			    VAR FirstCase =
			
			        CALCULATE(
			
			            MIN('Daily_Extract'[Final_DateTime - Date]),
			
			            'Daily_Extract'[Mosaic Exam Flag] = 1,
			
			            ALLEXCEPT('Daily_Extract', 'Daily_Extract'[NPI])
			
			        )
			
			   
			
			    VAR PctMosaic = [% Mosaic Exmas last 14 days]
			
			    VAR StatusFlag =
			
			        IF(
			
			            NOT ISBLANK(FirstCase) &&
			
			            FirstCase <= TODAY() - 14 &&
			
			            PctMosaic > 0.8,
			
			            "Fully Adopted",
			
			            "Not Fully Adopted"
			
			        )
			
			    RETURN
			
			        IF(ISFILTERED('FullyAdoptedSlicer'[Status]),
			
			            StatusFlag in SelectedStatuses , TRUE())
			)
			)
			```
		formatString: 0
		lineageTag: 4205192f-24a1-440a-b96e-415c4bc1013f

	measure EligibleProviders = ```
			
			var selectedstatus = VALUES(FullyAdoptedSlicer[Status])
			var applysinglestatus = COUNTROWS(selectedstatus) = 1
			var selstatus = IF(applysinglestatus, MAX(FullyAdoptedSlicer[Status]), BLANK())
			
			RETURN
			SUMX(
			    VALUES(
			 'Daily_Extract'[NPI]), 
			 var thisnpi = 'Daily_Extract'[NPI]
			
			            var firstcase = CALCULATE(
			                MIN('Daily_Extract'[Final_DateTime - Date]), 
			                'Daily_Extract'[Mosaic Exam Flag] = 1, 
			                ALLEXCEPT('Daily_Extract', 'Daily_Extract'[NPI])
			            )
			          
			          var isdeployed = NOT(ISBLANK(firstcase)) && firstcase <=TODAY() - 2
			          var isfullyadopted = [adoptionstatusflag] = 1
			          var isnotfullyadopted = [adoptionstatusflag] = 0
			
			          RETURN
			          IF(
			            NOT applysinglestatus , 
			            IF(isdeployed, 1,0), 
			            IF(
			                selstatus = "Fully Utilizing", 
			                IF(isfullyadopted && isdeployed ,1,0), 
			                IF(selstatus = "Not Fully Utilizing", 
			                IF(isnotfullyadopted && isdeployed ,1,0), 
			                IF(isdeployed,1,0)
			                )
			            )
			          )
			)
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			
			```
		formatString: 0
		lineageTag: f4bc30d0-25cf-498b-881b-90170fbe183e

	measure IsFullyAdopted = ```
			
			var iseligible = [first case] <= today()-14
			var providerexams = calculate (
			    countrows('Daily_Extract') , 
			    'Daily_Extract'[Date] >today() -14,
			    'Daily_Extract'[Date] <=today()
			)
			
			var providermosaicexams = 
			
			calculate(
			    countrows('Daily_Extract'), 
			    Daily_Extract[Date] >today() -14, 
			    Daily_Extract[Date] <=today() , 
			    Daily_Extract[Mosaic Exam Flag] =1 
			)
			var pctmosaic= divide ( providermosaicexams , providerexams)
			
			return 
			if(iseligible && pctmosaic > 0.8 , 1,0)
			```
		formatString: 0
		lineageTag: 1d7f4d9c-8de9-406b-ba27-9f9b6f5bea54

