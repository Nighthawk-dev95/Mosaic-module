	measure 'Left Total' = ```
			
			
			VAR SelectedMetricName =
			
			   SELECTEDVALUE('Mosaic Metric'[Mosaic Metric])
			
			VAR SelectedDateName =
			
			   SELECTEDVALUE('Date Selector'[Date Selector])
			
			VAR BaseMetric =
			
			   SWITCH(
			
			       SelectedMetricName,
			
			       "Mosaic Exam Ct", [Mosaic Exam Ct],
			
			       "Total Exam Ct",  [Total Exam Ct],
			
			       "Mosaic Exam %",  [Mosaic Exam %]
			
			   )
			return
			switch ( 
			    selecteddatename , "Day", calculate( basemetric, allselected('Daily_Extract'[date])), 
			    "week off", calculate( basemetric, allselected('Daily_Extract'[Week_Of])), 
			    "month", calculate (BaseMetric , allselected ('Daily_Extract'[month])) )
			
			
			
			 
			```
		lineageTag: bc247d51-48c1-40ee-a9f9-0c34e4923a2c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

