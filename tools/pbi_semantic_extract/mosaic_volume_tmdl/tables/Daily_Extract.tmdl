			    #"Changed Type6" = Table.TransformColumnTypes(#"Renamed Columns4",{{"Date", type date}}),
			    #"Removed Columns2" = Table.RemoveColumns(#"Changed Type6",{"Physician_Partner_Status", "TAT_Filter", "TAT_Minutes", "Team"}),
			    #"Renamed Columns5" = Table.RenameColumns(#"Removed Columns2",{{"teamro", "Team"}})
			in
			    #"Renamed Columns5"
