			        VRARP_radpipeline[NPI] = CurrentNPI,
			        OR(
			            NOT(ISBLANK(vrarp_radpipeline[Added to AD Group (CT Head)])),
			            NOT(ISBLANK(vrarp_radpipeline[Added to AD Group (CXR/ABD/MSK)]))
