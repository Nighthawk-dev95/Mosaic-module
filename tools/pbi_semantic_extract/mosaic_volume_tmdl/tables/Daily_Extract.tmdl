	column 'Is Eligible' = ```
			
			IF(
			    NOT(Daily_Extract[Modality] IN {"BD", "MG"}) &&
			    NOT(Daily_Extract[Site] IN { 
			        "Tampa General Hospital North Brooksville", 
			        "Tampa General Hospital North Spring Hill",
			        "TGHI Bayonet Point", "TGHI Bloomingale", "TGHI Bruce B Downs", 
			        "TGHI Carrollwood", "TGHI Habana", "TGHI New Port Richey", 
			        "TGHI New Tampa", "TGHI North Dale Mabry", "TGHI Northcliff", 
