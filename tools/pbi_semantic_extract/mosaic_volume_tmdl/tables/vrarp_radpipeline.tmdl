table vrarp_radpipeline
	lineageTag: 62e56c3a-7bd0-450d-8d4e-24eb9d364831

	measure distinctradsdraftingdynamics = ```
			
			
			CALCULATE(DISTINCTCOUNT('vrarp_radpipeline'[NPI]), 
			FILTER(
			    VALUES('vrarp_radpipeline'[NPI]), 
			    CALCULATE(SUM('Daily_Extract'[mosaic_draft_flag])) >=1 &&
			
			    (
			    CALCULATE(COUNTROWS(FILTER('vrarp_radpipeline', NOT(ISBLANK('vrarp_radpipeline'[Added to AD Group (CXR/ABD/MSK)]))))) >0 
			    ||
			    CALCULATE(COUNTROWS(FILTER('vrarp_radpipeline', NOT(ISBLANK('vrarp_radpipeline'[Added to AD Group (CT Head)]))))) >0
			    )
			)
			)
			```
		formatString: 0
		lineageTag: ad7e90a9-2ff7-4fd4-ae0f-cc3900135aae

