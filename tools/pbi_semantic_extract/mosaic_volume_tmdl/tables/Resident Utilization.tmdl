table 'Resident Utilization'
	lineageTag: c098628e-715e-4737-aacf-d9e30da7821b

	measure 'Resident Total Mosaic Exams (All Time)' =
			
			CALCULATE(
			    COUNTROWS('Resident Utilization'),
			    'Resident Utilization'[Msc_Rpt_Ind] = 1,
			    REMOVEFILTERS('Resident Utilization'[Calendar_Dt]),
			    REMOVEFILTERS('Resident Utilization'[Month])
			)
		formatString: 0
		lineageTag: ac35b23d-93b2-43b0-a9cb-079fbf5e079c

	measure 'Resident First Mosaic Exam' =
			
			CALCULATE(
			    MIN('Resident Utilization'[Calendar_Dt]),
			    'Resident Utilization'[Msc_Rpt_Ind] = 1,
			    REMOVEFILTERS('Resident Utilization'[Calendar_Dt]),
			    REMOVEFILTERS('Resident Utilization'[Month])
			)
		formatString: Short Date
		lineageTag: 7e1cb6e4-ec0f-4cad-9f1b-34c2ab1defec

	measure 'Resident % Mosaic Last 14d' =
			
			VAR Last14DaysStart = TODAY() - 14
			
			VAR MosaicExams =
			    CALCULATE(
			        COUNTROWS('Resident Utilization'),
			        'Resident Utilization'[Msc_Rpt_Ind] = 1,
			        'Resident Utilization'[Calendar_Dt] >= Last14DaysStart,
			        'Resident Utilization'[Calendar_Dt] <= TODAY(),
			        REMOVEFILTERS('Resident Utilization'[Calendar_Dt]),
			        REMOVEFILTERS('Resident Utilization'[Month])
			    )
			
			VAR TotalExams =
			    CALCULATE(
			        COUNTROWS('Resident Utilization'),
			        'Resident Utilization'[Calendar_Dt] >= Last14DaysStart,
			        'Resident Utilization'[Calendar_Dt] <= TODAY(),
			        REMOVEFILTERS('Resident Utilization'[Calendar_Dt]),
			        REMOVEFILTERS('Resident Utilization'[Month])
			    )
			
			RETURN DIVIDE(MosaicExams, TotalExams, 0)
		formatString: 0%;-0%;0%
		lineageTag: e4630b2a-0021-4bde-a1fc-3fab6faabdaf

	measure 'Resident % Mosaic Last 14d Eligible' =
			
			VAR Last14DaysStart = TODAY() - 14
			VAR ExcludedSites = {
			    "Tampa General Hospital North Brooksville",
			    "Tampa General Hospital North Spring Hill",
			    "TGHI Bayonet Point", "TGHI Bloomingale", "TGHI Bruce B Downs",
			    "TGHI Carrollwood", "TGHI Habana", "TGHI New Port Richey",
			    "TGHI New Tampa", "TGHI North Dale Mabry", "TGHI Northcliff",
			    "TGHI Oldsmar", "TGHI Palm Beach Gardens", "TGHI Parsons",
			    "TGHI Riverview", "TGHI South Tampa", "TGHI Sun City",
			    "TGHI Sunlake", "TGHI Trinity", "TGHI Wesley Chapel"
			}
			VAR ExcludedExams = {
			    "CT LUNG SCREENING",
			    "CT LUNG SCREENING FOLLOW UP WITH IV CONTRAST",
			    "CT LUNG SCREENING FOLLOW UP WITHOUT IV CONTRAST",
			    "CT LUNG SCREENING WITHOUT CONTRAST",
			    "CT Lung WO Screening (LDCT) Initial | 71271",
			    "CT LUNG WO Screening (LDCT) Initial, CT Lung WO Screening (LDCT) Initial"
			}
			VAR ExcludedModalities = {"BD", "MG"}
			
			VAR MosaicEligibleExams =
			    CALCULATE(
			        COUNTROWS('Resident Utilization'),
			        'Resident Utilization'[Msc_Rpt_Ind] = 1,
			        'Resident Utilization'[Calendar_Dt] >= Last14DaysStart,
			        'Resident Utilization'[Calendar_Dt] <= TODAY(),
			        NOT('Resident Utilization'[Site] IN ExcludedSites),
			        NOT('Resident Utilization'[siteProcedureName] IN ExcludedExams),
			        NOT('Resident Utilization'[modality] IN ExcludedModalities),
			        REMOVEFILTERS('Resident Utilization'[Calendar_Dt]),
			        REMOVEFILTERS('Resident Utilization'[Month])
			    )
			
			VAR TotalEligibleExams =
			    CALCULATE(
			        COUNTROWS('Resident Utilization'),
			        'Resident Utilization'[Calendar_Dt] >= Last14DaysStart,
			        'Resident Utilization'[Calendar_Dt] <= TODAY(),
			        NOT('Resident Utilization'[Site] IN ExcludedSites),
			        NOT('Resident Utilization'[siteProcedureName] IN ExcludedExams),
			        NOT('Resident Utilization'[modality] IN ExcludedModalities),
			        REMOVEFILTERS('Resident Utilization'[Calendar_Dt]),
			        REMOVEFILTERS('Resident Utilization'[Month])
			    )
			
			RETURN DIVIDE(MosaicEligibleExams, TotalEligibleExams, 0)
		formatString: 0%;-0%;0%
		lineageTag: 8eaff31e-855a-487b-9cdd-8ce877f17432

	measure 'Fully Utilizing (Resident)' =
			
			VAR PctMosaic = [Resident % Mosaic Last 14d Eligible]
			RETURN IF(PctMosaic >= 0.8, "Y", "N")
		lineageTag: b878afb8-f4da-47d1-b0cf-58e51ff4f47e

	measure 'Count Fully Utilizing Residents' =
			
			COUNTROWS(
			    FILTER(
			        VALUES('Resident Utilization'[Resident]),
			        [Fully Utilizing (Resident)] = "Y"
			    )
			)
		formatString: 0
		lineageTag: b78750cc-a5b3-4be1-bf90-c2c0b861f232

	measure 'Exams This Period' =
			
			COUNTROWS('Resident Utilization')
		formatString: 0
		lineageTag: 0fed9fb3-ce37-48b4-b287-025654bf6aae

	measure 'Mosaic Exams This Period' =
			
			CALCULATE(
			    COUNTROWS('Resident Utilization'),
			    'Resident Utilization'[Msc_Rpt_Ind] = 1
			)
		formatString: 0
		lineageTag: 32ba61c3-f659-46ea-9622-a45367fe9eb1

	measure 'Resident First Mosaic Draft Exam' =
			
			CALCULATE(
			    MIN('Resident Utilization'[Calendar_Dt]),
			    'Resident Utilization'[Msc_Draft_Ind] = 1,
			    REMOVEFILTERS('Resident Utilization'[Calendar_Dt])
			)
		formatString: General Date
		lineageTag: 5aaff3c5-d2bb-41ae-8ed1-474cc1d4574e

	measure 'Resident % Mosaic Exams' =
			
			DIVIDE(
			    CALCULATE(
			        COUNTROWS('Resident Utilization'),
			        'Resident Utilization'[Msc_Rpt_Ind] = 1
			    ),
			    COUNTROWS('Resident Utilization'),
			    0
			)
		formatString: 0%;-0%;0%
		lineageTag: 552e4752-d2c2-4934-a947-8e3d03562f46

	measure 'Resident % Mosaic Eligible' =
			
			VAR ExcludedSites = {
			    "Tampa General Hospital North Brooksville",
			    "Tampa General Hospital North Spring Hill",
			    "TGHI Bayonet Point", "TGHI Bloomingale", "TGHI Bruce B Downs",
			    "TGHI Carrollwood", "TGHI Habana", "TGHI New Port Richey",
			    "TGHI New Tampa", "TGHI North Dale Mabry", "TGHI Northcliff",
			    "TGHI Oldsmar", "TGHI Palm Beach Gardens", "TGHI Parsons",
			    "TGHI Riverview", "TGHI South Tampa", "TGHI Sun City",
			    "TGHI Sunlake", "TGHI Trinity", "TGHI Wesley Chapel"
			}
			VAR ExcludedExams = {
			    "CT LUNG SCREENING",
			    "CT LUNG SCREENING FOLLOW UP WITH IV CONTRAST",
			    "CT LUNG SCREENING FOLLOW UP WITHOUT IV CONTRAST",
			    "CT LUNG SCREENING WITHOUT CONTRAST",
			    "CT Lung WO Screening (LDCT) Initial | 71271",
			    "CT LUNG WO Screening (LDCT) Initial, CT Lung WO Screening (LDCT) Initial"
			}
			VAR ExcludedModalities = {"BD", "MG"}
			
			RETURN
			CALCULATE(
			    [Resident % Mosaic Exams],
			    NOT('Resident Utilization'[Site] IN ExcludedSites),
			    NOT('Resident Utilization'[siteProcedureName] IN ExcludedExams),
			    NOT('Resident Utilization'[modality] IN ExcludedModalities)
			)
		formatString: 0%;-0%;0%
		lineageTag: cdf0aa53-e8e1-41a6-9281-2dc64157f532

	measure 'Resident FU Filter' =
			
			VAR SelectedStatus = SELECTEDVALUE('Resident FU Status'[Fully Utilizing])
			
			RETURN
			IF(
			    ISBLANK(SelectedStatus),
			    1,  -- Nothing selected = show all
			    IF(
			        SelectedStatus = "Yes",
			        IF([Fully Utilizing (Resident)] = "Y", 1, 0),
			        IF([Fully Utilizing (Resident)] = "N", 1, 0)
			    )
			)
		formatString: 0
		lineageTag: 1da8b134-3935-4bd1-883f-f25e4c047f60

