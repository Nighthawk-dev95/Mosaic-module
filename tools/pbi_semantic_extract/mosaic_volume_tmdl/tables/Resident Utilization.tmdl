	column 'Resident Parsed Name' = ```
			
			VAR OpenTag = "<OBR.33.2>"
			VAR CloseTag = "</OBR.33.2>"
			VAR OpenTagLen = 10
			VAR RawValue = 'Resident Utilization'[Resident]
			
			-- Extract First Name (first occurrence)
			VAR FirstNameStart = IFERROR(FIND(OpenTag, RawValue, 1), 0) + OpenTagLen
			VAR FirstNameEnd = IFERROR(FIND(CloseTag, RawValue, 1), 0)
			VAR FirstName = IF(FirstNameStart > OpenTagLen && FirstNameEnd > 0, 
			    MID(RawValue, FirstNameStart, FirstNameEnd - FirstNameStart), 
			    BLANK()
			)
			
			-- Extract Last Name (second occurrence)
			VAR SecondOpenStart = IFERROR(FIND(OpenTag, RawValue, FirstNameEnd + 1), 0)
			VAR LastNameStart = SecondOpenStart + OpenTagLen
			VAR LastNameEnd = IFERROR(FIND(CloseTag, RawValue, SecondOpenStart + 1), 0)
			VAR LastName = IF(SecondOpenStart > 0 && LastNameEnd > 0,
			    MID(RawValue, LastNameStart, LastNameEnd - LastNameStart),
			    BLANK()
			)
			
			RETURN
			IF(
			    ISBLANK(FirstName) || ISBLANK(LastName),
			    RawValue,  -- Fall back to original if parsing fails
			    FirstName & " " & LastName
			)
			```
		lineageTag: e4aa6c97-af9e-4bb8-8cb3-dfa07ef3a412
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Month = DATE(YEAR('Resident Utilization'[Calendar_Dt]), MONTH('Resident Utilization'[Calendar_Dt]), 1)
		formatString: Short Date
