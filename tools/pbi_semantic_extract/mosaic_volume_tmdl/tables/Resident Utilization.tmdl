	column 'Resident Week of First Mosaic Case' = ```
			
			VAR CurrentResident = 'Resident Utilization'[Resident]
			VAR FirstMosaicDate = 
			    CALCULATE(
			        MIN('Resident Utilization'[Calendar_Dt]),
			        ALL('Resident Utilization'),
			        'Resident Utilization'[Resident] = CurrentResident,
			        'Resident Utilization'[Msc_Rpt_Ind] = 1
			    )
			VAR WeekStart = 
			    IF(
			        NOT(ISBLANK(FirstMosaicDate)),
			        FirstMosaicDate - WEEKDAY(FirstMosaicDate, 2) + 1,
			        BLANK()
			    )
			RETURN
			    WeekStart
			```
		formatString: Short Date
		lineageTag: 8da8d105-5120-4fe3-8225-20321e699b51
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Week_Of = ```
			
			'Resident Utilization'[Calendar_Dt] - 
			WEEKDAY('Resident Utilization'[Calendar_Dt], 2) + 1
			```
		formatString: Short Date
