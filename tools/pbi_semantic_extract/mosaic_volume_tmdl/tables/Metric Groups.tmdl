table 'Metric Groups'
	lineageTag: 0d965c98-1c94-4fc4-901a-c9e250c5cc35

	measure 'Selected Metric Value' = ```
			
			VAR SelectedMetric = SELECTEDVALUE('Metric Groups'[Metric])
			RETURN
			    SWITCH(
			        SelectedMetric,
			        
			        "Total Mosaic Exams", [Total Mosaic Cases (All Time)],
			        "% Mosaic (14 days)", [%reportingadjagnostic],
			        "% Mosaic Eligible (14 days)", [%reportingeligagnostic],
			        "Fully Utilizing", CALCULATE([adoptionstatusflag]),
			        "Total Exams", [Total Exam Ct],
			        "Mosaic Exams", [Mosaic Exam Ct],
			        "% Mosaic", [% Mosaic Exams],
			        "% Mosaic Eligible" , [%mosaiceligible],
			        "Draftable XR Exams", [MosaicdraftCt XR],
			        "Drafted XR", [Total Drafted XR],
			        "% XR Drafted", [%XR Drafable],
			        "Draftable CT Exams", [MosaicdraftCt CT],
			        "Drafted CT", [Total Drafted CT],
			        "% CT Drafted", [% CT Draftable],
			        "Capturable US Exams", [US Capturable],
			        "Captured US", [Captured US],
			        "% Captured", [% Captured],
			        BLANK()
			    )
			```
		lineageTag: dce6ce0d-0863-42e0-b0d6-b54747a0821f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

