	partition 'Metric Groups' = calculated
		mode: import
		source = ```
				
				DATATABLE(
				    "Group", STRING,
				    "GroupSort", INTEGER,
				    "Metric", STRING,
				    "MetricSort", INTEGER,
				    {
				        
				        {"Ever", 1, "Total Mosaic Exams", 1},
				        
				        {"Last 14 days or since go-live", 2, "% Mosaic (14 days)", 1},
				        {"Last 14 days or since go-live", 2, "% Mosaic Eligible (14 days)", 2},
				        {"Last 14 days or since go-live", 2, "Fully Utilizing", 3},
				        
				        {"In selected time frame", 3, "Total Exams", 1},
				        {"In selected time frame", 3, "Mosaic Exams", 2},
				        {"In selected time frame", 3, "% Mosaic", 3},
				        {"In selected time frame", 3, "% Mosaic Eligible", 4},
				        {"In selected time frame", 3, "Draftable XR Exams", 5},
				        {"In selected time frame", 3, "Drafted XR", 6},
				        {"In selected time frame", 3, "% XR Drafted", 7},
				        {"In selected time frame", 3, "Draftable CT Exams", 8},
				        {"In selected time frame", 3, "Drafted CT", 9},
				        {"In selected time frame", 3, "% CT Drafted", 10},
				        {"In selected time frame", 3, "Capturable US Exams", 11},
				        {"In selected time frame", 3, "Captured US", 12},
				        {"In selected time frame", 3, "% Captured", 13}
				    }
				)
				```

