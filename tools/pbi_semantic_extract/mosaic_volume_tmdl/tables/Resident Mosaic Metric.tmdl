table 'Resident Mosaic Metric'
	lineageTag: 2fabde13-b1bf-4e0c-8c2b-f51a739db00f

	measure 'Resident Metric Display' = ```
			
			VAR SelectedMetricColumn = SELECTEDVALUE('Resident Mosaic Metric'[Resident Mosaic Metric Fields])
			VAR SelectedDateColumn = SELECTEDVALUE('Resident Date Selector'[Resident Date Selector  Fields])
			
			VAR TotalExams = 
			    SWITCH(
			        TRUE(),
			        SelectedDateColumn = NAMEOF('Resident Utilization'[Calendar_Dt]),
			            COUNTROWS('Resident Utilization'),
			        SelectedDateColumn = NAMEOF('Resident Utilization'[Week_Of]),
			            CALCULATE(
			                COUNTROWS('Resident Utilization'),
			                ALLEXCEPT(
			                    'Resident Utilization',
			                    'Resident Utilization'[Week_Of],                -- ✅ Added
			                    'Resident Utilization'[Resident Parsed Name],
			                    'Resident Utilization'[NPI],
			                    'Resident Utilization'[Site],
			                    'Resident Utilization'[modality],
			                    'Resident Utilization'[Practice_Short_Name],
			                    'Resident Utilization'[siteProcedureName]       -- ✅ Added
			                )
			            ),
			        SelectedDateColumn = NAMEOF('Resident Utilization'[Month]),
			            CALCULATE(
			                COUNTROWS('Resident Utilization'),
			                ALLEXCEPT(
			                    'Resident Utilization',
			                    'Resident Utilization'[Month],                  -- ✅ Added
			                    'Resident Utilization'[Resident Parsed Name],
			                    'Resident Utilization'[NPI],
			                    'Resident Utilization'[Site],
			                    'Resident Utilization'[modality],
			                    'Resident Utilization'[Practice_Short_Name],
			                    'Resident Utilization'[siteProcedureName]       -- ✅ Added
			                )
			            ),
			        COUNTROWS('Resident Utilization')
			    )
			
			VAR MosaicExams = 
			    SWITCH(
			        TRUE(),
			        SelectedDateColumn = NAMEOF('Resident Utilization'[Calendar_Dt]),
			            CALCULATE(
			                COUNTROWS('Resident Utilization'),
			                'Resident Utilization'[Msc_Rpt_Ind] = 1
			            ),
			        SelectedDateColumn = NAMEOF('Resident Utilization'[Week_Of]),
			            CALCULATE(
			                COUNTROWS('Resident Utilization'),
			                'Resident Utilization'[Msc_Rpt_Ind] = 1,
			                ALLEXCEPT(
			                    'Resident Utilization',
			                    'Resident Utilization'[Week_Of],                -- ✅ Added
			                    'Resident Utilization'[Resident Parsed Name],
			                    'Resident Utilization'[NPI],
			                    'Resident Utilization'[Site],
			                    'Resident Utilization'[modality],
			                    'Resident Utilization'[Practice_Short_Name],
			                    'Resident Utilization'[siteProcedureName]       -- ✅ Added
			                )
			            ),
			        SelectedDateColumn = NAMEOF('Resident Utilization'[Month]),
			            CALCULATE(
			                COUNTROWS('Resident Utilization'),
			                'Resident Utilization'[Msc_Rpt_Ind] = 1,
			                ALLEXCEPT(
			                    'Resident Utilization',
			                    'Resident Utilization'[Month],                  -- ✅ Added
			                    'Resident Utilization'[Resident Parsed Name],
			                    'Resident Utilization'[NPI],
			                    'Resident Utilization'[Site],
			                    'Resident Utilization'[modality],
			                    'Resident Utilization'[Practice_Short_Name],
			                    'Resident Utilization'[siteProcedureName]       -- ✅ Added
			                )
			            ),
			        CALCULATE(
			            COUNTROWS('Resident Utilization'),
			            'Resident Utilization'[Msc_Rpt_Ind] = 1
			        )
			    )
			
			RETURN
			    SWITCH(
			        TRUE(),
			        SelectedMetricColumn = NAMEOF('Resident Utilization'[siteProcedureName]),
			            TotalExams,
			        SelectedMetricColumn = NAMEOF('Resident Utilization'[Msc_Rpt_Ind]),
			            MosaicExams,
			        SelectedMetricColumn = NAMEOF('Resident Utilization'[modality]),
			            DIVIDE(MosaicExams, TotalExams, 0),
			        BLANK()
			    )
			```
		lineageTag: 7274d07e-5e45-468a-85a8-30c038eb466f

		formatStringDefinition = 'Resident Mosaic Metric'[Resident Metric Display Format]

	measure 'Resident Metric Display Format' =
			
			VAR SelectedMetricColumn = SELECTEDVALUE('Resident Mosaic Metric'[Resident Mosaic Metric Fields])
			RETURN
			    SWITCH(
			        TRUE(),
			        SelectedMetricColumn = NAMEOF('Resident Utilization'[siteProcedureName]), "#,##0",
			        SelectedMetricColumn = NAMEOF('Resident Utilization'[Msc_Rpt_Ind]),       "#,##0",
			        SelectedMetricColumn = NAMEOF('Resident Utilization'[modality]),           "0%",
			        "#,##0"
			    )
		lineageTag: 446c6330-b002-45a5-8ded-75209a928698

	measure 'Resident Metric Font Color' =
			
			VAR SelectedMetricColumn = SELECTEDVALUE('Resident Mosaic Metric'[Resident Mosaic Metric Fields])
			VAR PctValue = DIVIDE(
			    CALCULATE(COUNTROWS('Resident Utilization'), 'Resident Utilization'[Msc_Rpt_Ind] = 1),
			    COUNTROWS('Resident Utilization'),
			    0
			)
			
			RETURN
			IF(
			    SelectedMetricColumn = NAMEOF('Resident Utilization'[modality]),
			    IF(PctValue < 0.5, "#DE6A73", BLANK()),  -- Red font only when < 50%
			    BLANK()
			)
		lineageTag: 26f30b29-511f-4ee6-81fe-158a20df1201

	measure 'Resident Metric Background Color' =
			
			VAR SelectedMetricColumn = SELECTEDVALUE('Resident Mosaic Metric'[Resident Mosaic Metric Fields])
			VAR PctValue = DIVIDE(
			    CALCULATE(COUNTROWS('Resident Utilization'), 'Resident Utilization'[Msc_Rpt_Ind] = 1),
			    COUNTROWS('Resident Utilization'),
			    0
			)
			
			RETURN
			IF(
			    SelectedMetricColumn = NAMEOF('Resident Utilization'[modality]),
			    SWITCH(
			        TRUE(),
			        PctValue < 0.5,  BLANK(),     -- No background for red (font only)
			        PctValue < 0.8,  "#FFEB9C",   -- Yellow background 50-80%
			        "#C6EFCE"                      -- Green background > 80%
			    ),
			    BLANK()
			)
		lineageTag: 563f003c-25fd-4af3-9fc0-20e8288ace9f

