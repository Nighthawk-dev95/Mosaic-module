	measure showlast14 =
			
			VAR LatestDate =
			    CALCULATE(MAX('Daily_Extract'[Date]), ALL('Daily_Extract'))
			
			VAR SelectedDateUnit =
			    SELECTEDVALUE('Date Selector'[Date Selector Fields])
			
			VAR RawDate =
			    SWITCH(
			        SelectedDateUnit,
			        "Day", MIN('Daily_Extract'[Date]),
			        "Week Of", MIN('Daily_Extract'[Week_Of]),     -- Changed from WeekStart
			        "Month", MIN('Daily_Extract'[Month]),
			        MIN('Daily_Extract'[Date])
			    )
			
			-- Convert Month to actual date if needed (assuming YYYYMM numeric)
			VAR ThisDate =
			    IF(
			        SelectedDateUnit = "Month",
			        DATE(INT(RawDate/100), MOD(RawDate,100), 1),
			        RawDate
			    )
			
			VAR UserHasDateSelection = [userselectedanydate]
			
			VAR SelectedMetric =
			    SELECTEDVALUE('LineChartMetricSelector'[Metric], "% RPCE")
			
			VAR OctoberStart = DATE(2025,10,1)
			VAR Yesterday = LatestDate - 1
			
			RETURN
			IF(
			    UserHasDateSelection,
			    1,
			    IF(ThisDate >= OctoberStart && ThisDate <= Yesterday, 1, 0)
			)
		formatString: 0
		lineageTag: 38c9bc82-45ba-43b2-91e0-922205de7b8b

	measure userselecteddates =
			
