	measure 'yaxis titel dynamic' =
			
			
			var k = SELECTEDVALUE('LineChartMetricSelector'[MetricKey])
			RETURN
			SWITCH(
			    k,
			    1,"Number of Exams",
			    2,"% RPCE",
			    " "
			)
		lineageTag: 1f1261cb-98be-4291-94e1-41c65b4813d0

	measure userselectedmonths =
			
			NOT ISEMPTY(VALUES('Daily_Extract'[Month]))
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 97c7e840-1b37-4aae-a20b-0b672fe789d4

	measure userselectedanydate = ```
			
			
			var mindate_all = 
			CALCULATE(MIN('Daily_Extract'[Date]), ALL('Daily_Extract'))
			
			var maxdate_all = CALCULATE(MAX('Daily_Extract'[Date]), ALL('Daily_Extract'))
			
			var mindate_selected = CALCULATE(MIN('Daily_Extract'[Date]), ALLSELECTED('Daily_Extract'))
			
			var maxdate_selected = CALCULATE(MAX('Daily_Extract'[Date]), ALLSELECTED('Daily_Extract'))
			
			RETURN
			IF(
			    mindate_selected <> mindate_all ||
			    maxdate_selected <> maxdate_all, 
			
			    TRUE(), 
			    FALSE()
			)
			```
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 72b2bf6c-b60a-48fe-a3fd-a4f53921bd9c

	measure showfromoct = ```
			
			var thisdate = SELECTEDVALUE('Daily_Extract'[Date])
			
			RETURN
			IF(
			    ISBLANK(thisdate), 
			    1, 
			    IF(thisdate >=DATE(2025,10,1), 
			    1,
			    0
			    )
			)
			```
		formatString: 0
		lineageTag: a81d5a6f-c5f1-40d1-96f6-f393ba7d6ac0

