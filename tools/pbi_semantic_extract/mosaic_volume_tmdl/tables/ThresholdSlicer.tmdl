			                    SUM('Daily_Extract'[mosaic_draft_flag]),
			                SelectedDateColumn = NAMEOF('Daily_Extract'[Week_Of]), 
			                    CALCULATE(SUM('Daily_Extract'[mosaic_draft_flag]), ALLEXCEPT('Daily_Extract', 'Daily_Extract'[Week_Of], 'Daily_Extract'[Team], 'Daily_Extract'[Provider], 'Daily_Extract'[NPI],'Daily_Extract'[Interventional_Flag],Daily_Extract[Local Practice Division],Daily_Extract[Local Practice],Daily_Extract[Site],Daily_Extract[Modality],Daily_Extract[assisted_flag],Daily_Extract[Procedure])),
			                SelectedDateColumn = NAMEOF('Daily_Extract'[Month]), 
			                    CALCULATE(SUM('Daily_Extract'[mosaic_draft_flag]), ALLEXCEPT('Daily_Extract', 'Daily_Extract'[Week_Of], 'Daily_Extract'[Team], 'Daily_Extract'[Provider], 'Daily_Extract'[NPI],'Daily_Extract'[Interventional_Flag],Daily_Extract[Local Practice Division],Daily_Extract[Local Practice],Daily_Extract[Site],Daily_Extract[Modality],Daily_Extract[assisted_flag],Daily_Extract[Procedure])),
			                SUM('Daily_Extract'[mosaic_draft_flag])
			            ),
			        0
			    )
			
			// Calculate display value
			VAR MosaicdraftCt_Calc = SUM('Daily_Extract'[mosaic_draft_flag])
			VAR TotalExamCt_Calc = SUM('Daily_Extract'[Exam Ct])
			VAR MosaicExamFlag_Calc = SUM('Daily_Extract'[Mosaic Exam Flag])
			
			VAR DisplayValue = 
			    SWITCH(
			        TRUE(),
			        SelectedMetricColumn = NAMEOF('Daily_Extract'[Mosaic Exam Ct]), 
			            MosaicExamFlag_Calc,
			        SelectedMetricColumn = NAMEOF('Daily_Extract'[Total Exam Ct]), 
			            TotalExamCt_Calc,
			        SelectedMetricColumn = NAMEOF('Daily_Extract'[Mosaic Exam %]), 
			            DIVIDE(MosaicExamFlag_Calc, TotalExamCt_Calc, 0),  // Keep as decimal (0.75)
			        SelectedMetricColumn = NAMEOF('Daily_Extract'[MosaicdraftCt]), 
			            MosaicdraftCt_Calc,
			        SelectedMetricColumn = NAMEOF('Daily_Extract'[% Mosaic drafting]), 
			            DIVIDE(MosaicdraftCt_Calc, TotalExamCt_Calc, 0),  // Keep as decimal (0.75)
			        BLANK()
			    )
			
			RETURN
			    IF(CurrentVolume >= SelectedThreshold, DisplayValue, BLANK())
			```
