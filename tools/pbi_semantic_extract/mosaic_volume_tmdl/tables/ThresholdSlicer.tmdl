	measure 'Mosaic Exam % Color' = ```
			
			VAR SelectedMetricColumn = SELECTEDVALUE('Mosaic Metric'[Mosaic Metric Fields])
			
			// Only apply color formatting for Mosaic Exam %
			VAR IsMosaicExamPercent = SelectedMetricColumn = NAMEOF('Daily_Extract'[Mosaic Exam %])
			
			// Calculate the percentage value
			VAR MosaicExamFlag_Calc = SUM('Daily_Extract'[Mosaic Exam Flag])
			VAR TotalExamCt_Calc = SUM('Daily_Extract'[Exam Ct])
			VAR PercentageValue = DIVIDE(MosaicExamFlag_Calc, TotalExamCt_Calc, 0)
			
			// Define your color logic (adjust thresholds as needed)
			VAR ColorResult = 
			    IF(
			        NOT IsMosaicExamPercent,
			        BLANK(),  // No formatting for other metrics
			        SWITCH(
			            TRUE(),
			            PercentageValue >= 0.50 && PercentageValue <0.80, "#FFEB9C",  // Green for 90% and above
			           PercentageValue >=0.80 , "#C6EFCE"
			           
			        )
			    )
			
			RETURN ColorResult
			```
		lineageTag: dd23c7db-f297-4d97-a20b-ccaf05bf3a46

	measure 'Mosaic Exam % Colorfont' = ```
			
			VAR SelectedMetricColumn = SELECTEDVALUE('Mosaic Metric'[Mosaic Metric Fields])
			
			// Only apply color formatting for Mosaic Exam %
			VAR IsMosaicExamPercent = SelectedMetricColumn = NAMEOF('Daily_Extract'[Mosaic Exam %])
			
			// Calculate the percentage value
			VAR MosaicExamFlag_Calc = SUM('Daily_Extract'[Mosaic Exam Flag])
			VAR TotalExamCt_Calc = SUM('Daily_Extract'[Exam Ct])
			VAR PercentageValue = DIVIDE(MosaicExamFlag_Calc, TotalExamCt_Calc, 0)
			
			// Define your color logic (adjust thresholds as needed)
			VAR ColorResult = 
			    IF(
			        NOT IsMosaicExamPercent,
			        BLANK(),  // No formatting for other metrics
			        SWITCH(
			            TRUE(),
			          
			           PercentageValue <0.50 , "#DE6A73"
			        )
			    )
			
			RETURN ColorResult
			```
		lineageTag: a11d619b-3f5a-4f96-aa26-6b9034ac9e2e

