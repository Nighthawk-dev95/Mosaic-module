table DataRefresh
	lineageTag: 919d32d8-dcc9-4bc0-8a25-f62baf508379

	measure MosaicReportingCountDynamic = ```
			
			var metricChoice = SELECTEDVALUE(Metrictypeselector[MetricType])
			
			return
			switch(
			    true(), 
			    metricChoice = "Estimated RVU" , [wrvuest_reporting], 
			    metricChoice = "TBWU" , [TBWU_reporting], 
			    metricChoice = "Adj Estimated RVU" , [Adj_estrvureporting], 
			    metricChoice = "Adj Best Available RVU", [Adj_Bestrvureporting], 
			    metricChoice= "Adj Time Based Work Unit", [Adjwu_reporting], 
			    metricChoice = "Best Available RVU", [Bestrvu_reporting], 
			    metricchoice = "Exam Count" , [Mosaic Exam Ct],
			    blank())
			```
		formatString: 0
		lineageTag: 73c1eaa3-fbb0-46a6-9548-59569d5069e2

		annotation PBI_FormatHint = {"isDecimal":true}

	measure MosaicDRAFTINGCountDynamic = ```
			
			var metricChoice = SELECTEDVALUE(Metrictypeselector[MetricType])
			
			return
			switch(
			    true(), 
			    metricChoice = "Estimated RVU" , [wrvuest_drafting], 
			    metricChoice = "TBWU" , [TBWU_drafting], 
			    metricChoice = "Adj Estimated RVU" , [Adj_estrvudrafting], 
			    metricChoice = "Adj Best Available RVU", [Adj_Bestrvudrafting], 
			    metricChoice= "Adj Time Based Work Unit", [Adjwu_drafting], 
			    metricChoice = "Best Available RVU", [Bestrvu_drafting],
			    metricchoice = "Exam Count" , [MosaicdraftCt],
			    blank())
			```
		formatString: 0
		lineageTag: 291dcffa-0835-49f9-827b-e054321ad23c

		annotation PBI_FormatHint = {"isDecimal":true}

	measure TotalExamsCountDynamic = ```
			
			var metricChoice = SELECTEDVALUE(Metrictypeselector[MetricType])
			
			return
			switch(
			    true(), 
			    metricChoice = "Estimated RVU" , [wRVU est], 
			    metricChoice = "TBWU" , [WU], 
			    metricChoice = "Adj Estimated RVU" , [adj_wRVU est], 
			    metricChoice = "Adj Best Available RVU", [Adj_Best], 
			    metricChoice= "Adj Time Based Work Unit", [adj_WU], 
			    metricChoice = "Best Available RVU", [Best],
			    metricchoice ="Exam Count" , [Total Exam Ct],
			    blank())
			```
		formatString: 0
		lineageTag: f92bcb8c-1cce-4393-a748-38da49afb820

		annotation PBI_FormatHint = {"isDecimal":true}

	measure mosaicreporting%dynamic =
			divide (
			    [MosaicReportingCountDynamic], [TotalExamsCountDynamic] )
		formatString: 0%;-0%;0%
		lineageTag: 21c46307-0a04-41ef-896b-aacea3082598

	measure MosaicdraftinG% =
			divide (
			    [MosaicDRAFTINGCountDynamic] , [TotalExamsCountDynamic])
		formatString: 0%;-0%;0%
		lineageTag: 336afd76-02a6-4dc4-8c46-b1d8cf8dd34c

